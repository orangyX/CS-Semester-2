<owl:NamedIndividual rdf:about="#MJD-KOREB">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:hasUnit rdf:resource="#KORE2404"/>
  <uni.:hasUnit rdf:resource="#KORE3405"/>
  <uni.:hasUnit rdf:resource="#KORE1401"/>
  <uni.:hasUnit rdf:resource="#KORE2403"/>
  <uni.:hasUnit rdf:resource="#ASIA3006"/>
  <uni.:hasUnit rdf:resource="#KORE2811"/>
  <uni.:hasUnit rdf:resource="#KORE3406"/>
  <uni.:hasUnit rdf:resource="#KORE1402"/>
  <uni.:listedInDegree rdf:resource="#BP054"/>
  <uni.:listedInDegree rdf:resource="#BP001"/>
  <uni.:listedInDegree rdf:resource="#BH005"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-KOREB</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Studies</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Studies major provides students with high-quality learning opportunities and an outstanding student experience in learning Korean. With the rapid economic development of the Republic of Korea (South Korea), and its position as the third biggest trading partner for Western Australia, Korean Studies is an increasingly important area of study. Korean Studies equips students with solid language skills and a broad in-depth knowledge of Korea, its society and people. Students will graduate with an in-depth understanding of the increasingly globalising world, as well as a versatile portfolio of skills and aptitudes which enhance employability. Students should be aware that this major does not provide a pathway to an Honours.</uni.:hasDescription>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply their country-specific knowledge in the context of their second major (if applicable).</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">engage effectively in the key debates on Korean history, society and culture in a professional manner and produce coherent and well-argued written work</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify key ethical, philosophical and social characteristics of Korean culture, society and history, and apply this knowledge in the context of future employment or postgraduate study</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a good written and spoken linguistic competence in the Korean language</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competence in a set of transferable skills, including (but not limited to) digital literacy, information management, group working, research skills and critical thinking, as well as an ability to manage and take responsibility for their own learning processes with minimum guidance</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how culturally specific social structures affect interpersonal communication, and determine how to apply this knowledge to their own interactions in a culturally sensitive manner</uni.:hasOutcome>
</owl:NamedIndividual>

