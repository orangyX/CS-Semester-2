  <rdf:type rdf:resource="http://uwa/uni.ot#FloatingUnit"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN2209</uni.:hasCode>
</owl:NamedIndividual>

