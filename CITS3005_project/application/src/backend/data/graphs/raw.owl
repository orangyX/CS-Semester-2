<owl:NamedIndividual rdf:about="#KORE3408">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#KORE3407"/>
  <uni.:listedInMajor rdf:resource="#MJD-KOREI"/>
  <uni.:hasContact rdf:resource="#KORE3408_contact_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KORE3408</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean 8</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from KORE3407 Korean 7. It further enhances students' linguistic skills in Korean and their cultural literacy, develops their ability to critique contemporary social and cultural issues in Korean, and equips them with effective expressions and communication techniques via the complex linguistic structures and vocabulary used in contemporary Korean spoken and written discourses. Students develop their skills in: -speaking and listening, by means of a research project presentation, discussion, and development of competence in academic registers in spoken language; and -reading and writing, by means of essay writing in academic format, critical reading of Korean journal articles, and Korean-to-English translation. Successful completion of this unit aims to bring students to the equivalent of Level 4/Level 5 of the Test of Proficiency in Korean (TOPIK). This unit also facilitates future pathways into higher research on Korea through promoting critical selection and utilisation of Korean language source materials.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of KORE3407 Korean 7</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate sophisticated understanding and express opinions of diverse social, cultural, and linguistic ideas and values.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read and translate authentic Korean materials and discuss ideas on contemporary social and cultural issues in Korea</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conduct research by collecting and analysing materials in both Korean and English</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop specialist vocabularies in areas relating to Korean social and cultural issues</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">express research findings and ideas logically in both spoken and written forms of Korean</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written assessments and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral assessments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

