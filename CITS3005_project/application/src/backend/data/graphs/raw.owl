<owl:NamedIndividual rdf:about="#ENVE4401">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GENG2003"/>
  <uni.:hasPrerequisite rdf:resource="#GENG2010"/>
  <uni.:requiresDegree rdf:resource="#62550"/>
  <uni.:hasContact rdf:resource="#ENVE4401_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVE4401</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contaminant Fate and Transport</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers both the chemical and physical processes relevant to the transport of contaminants through the natural environment and the contaminants' eventual fate—either destruction or long-term storage. Students learn about the processes that govern the fate and transport of many classes of contaminants in three major environmental media—surface water, the subsurface environment and the atmosphere. Topics such as photochemical smog, acid sulphate soils and the mobility of fertilisers are covered.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Environmental Engineering specialisation or Chemical Engineering specialisation) or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and Successful completion of ( 96 points and ( GENG2010 Principles of Hydraulics or GENG2003 Fluid Mechanics )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">define control volumes and use a systems approach to solve environmental contamination problems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">provide estimates of contaminant concentrations under given scenarios.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantify temporal and spatial scales of importance for the fate and transport of pollutants</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assimilate presented data and utilise them for problem solving</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate key chemical concepts and processes of significance for contaminant cycling</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">individual and/or group assignments and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
</owl:NamedIndividual>

