  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">seminars</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:contactHours>
