<owl:NamedIndividual rdf:about="#ECON3350">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ECON1102"/>
  <uni.:hasPrerequisite rdf:resource="#ECON2234"/>
  <uni.:hasContact rdf:resource="#ECON3350_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON3350</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Money, Banking and Financial Markets</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit revises key definitions and measures used in the financial sector and uses them to examine recent developments in money, banking and financial markets, including an evaluation of policy responses to financial crises.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON2234 Macroeconomics: Policy and Applications (or equivalent) or any Level 2 Finance unit. for pre-2012 courses : ECON1102 Macroeconomics: Money and Finance (or equivalent)</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify recent trends in financial markets and their causes and effects</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the operation of modern financial markets and their regulation, including the behaviour of the markets for a variety of financial instruments</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the operation of financial markets and financial intermediaries and their effect on the economy.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse institutional and regulatory changes in financial markets and the conduct of monetary policy since the global financial crisis in 2008</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class participation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial Economic</uni.:hasMajorTitle>
</owl:NamedIndividual>

