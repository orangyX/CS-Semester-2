<owl:NamedIndividual rdf:about="#PHIL2001">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasContact rdf:resource="#PHIL2001_contact_lectures"/>
  <uni.:hasContact rdf:resource="#PHIL2001_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL2001</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bioethics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on a set of related questions concerning the biomedical and health sciences, such as—What is health? How should we understand well-being or quality of life? What is the role of lived experience in accounts of disability? How should we think about death? What ethical issues arise in the use of reproductive technologies? What is mental illness and how should it be treated in the biomedical and health sciences? Students become familiar with some of the most influential works on such questions. As well as learning about such substantive issues, students also deepen their understanding of ethical reasoning in general, and sharpen their ability to understand, evaluate and construct arguments.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any level 1 unit in the Bachelor of Arts, or equivalent</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">independently interpret philosophical texts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate philosophical positions, including identifying counter-examples and identifying and questioning their basic assumptions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compare and contrast philosophical positions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reason in a constructive and cooperative way about some of the most polarising moral issues..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate strong written communication and research skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locate global moral issues in their historical and cultural context</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain influential philosophical views concerning accounts of death</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">construct persuasive arguments</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weekly active learning</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral examination of writing assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">writing assignment</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philosophy, Politics and Economic</uni.:hasMajorTitle>
</owl:NamedIndividual>

