<owl:NamedIndividual rdf:about="#PHIL3009">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-PHILY"/>
  <uni.:hasContact rdf:resource="#PHIL3009_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL3009</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Philosophy of Psychedelics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychedelic drugs have been used in religious and medicinal settings for hundreds, perhaps thousands, of years. Since the mid-twentieth century, they have also – intermittently – been the objects of intense scientific interest and sociopolitical controversy. However, only in the twenty-first century have academic philosophers started to discuss psychedelics and their remarkable effects in significant detail. This unit introduces some of the basic historical and scientific facts about psychedelics before examining philosophical questions raised by the recent use of these substances in neuroscience and psychiatry. Topics covered may include, but are not limited to, the mechanisms of psychedelic-assisted psychotherapy (“psychedelic therapy”); the implications of psychedelic evidence for philosophical debates about self-awareness; the possibility of gaining knowledge from psychedelic experiences; and the proposed use of psychedelics as agents of “moral bioenhancement”.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of 72 points in an undergraduate degree.</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate philosophical positions, including identifying counter-examples and identifying and questioning their basic assumptions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret philosophical texts independently</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess philosophical arguments regarding the central philosophical issues raised by the use and effects of psychedelics.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a critical understanding of some of the central philosophical issues raised by the use and effects of psychedelics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate strong written communication and research skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">construct persuasive arguments</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">essay</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philosophy</uni.:hasMajorTitle>
</owl:NamedIndividual>

