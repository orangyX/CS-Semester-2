<owl:NamedIndividual rdf:about="#HART3332">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Design_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ARTF2000"/>
  <uni.:hasPrerequisite rdf:resource="#HART2274"/>
  <uni.:hasAdvisedUnit rdf:resource="#ARTF2000"/>
  <uni.:hasAdvisedUnit rdf:resource="#HART2274"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART3332</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art Object Lab: Materiality, Meaning, and Display</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the meaning and materiality of art through a series of object-based seminars. Working directly with object collections, students will explore how qualities such as medium, scale, and display help shape the interpretation and experience of art. These seminars engage a variety of themes that will enhance how students analyse and historically contextualise artworks, while also introducing techniques for art handling, conservation, and exhibition design. Each week is designed as a new experiment with object-based analysis and encourages students to learn through both hands-on experience and direct observation.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF2000 Curatorial Practices or HART2274 Introduction to Museum and Curatorial Studies</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand and implement best practices for the handling of art objects.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of exhibition design and object analysis in a written proposal</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formally analyse and historically contextualise a work of art in an oral presentation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">employ effective analytical and research skills in written work</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge about materials and artistic practices to the analysis of works of art</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discursive learning</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">short weekly writing</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhibition proposal</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art History and Curatorial Studie</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HART3333">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Design_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-HYART"/>
  <uni.:hasContact rdf:resource="#HART3333_contact_lectures"/>
  <uni.:hasContact rdf:resource="#HART3333_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART3333</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Picturing the Self: Portraiture in Nineteenth-century Europe</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tracking the shifting notion of both the citizen and the 'self', this unit explores the complex history of the nineteenth century through the lens of the portrait. By analysing visual representations and their social reception, the unit employs portraiture as both a fulcrum and foil for understanding the role of the individual in nineteenth century society. How does portraiture respond to political and cultural changes? Who is portrayed and for what audience? What is the role of the 'real' in portraiture of the nineteenth century? Implicit in this analysis is a consideration of the artist-as-individual and the personal and political stakes of self-portraiture. The nineteenth century witnessed a dramatic change in the reception and creation of portraits; by analysing the self as the subject, observer and producer of images, the unit explores how the individual evolved from an Enlightenment ideal to a 'modern subject' over the course of the nineteenth century.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">at least one Level 2 unit from the History of Art major sequence</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate critical thought and cogent analysis through oral communication</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the theories and formal conventions of portraiture</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integrate knowledge about the evolving definition of the individual into an historical and formal analysis of portraiture in the nineteenth century</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">construct a compelling and well-structured argument in a written paper</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">employ effective research skills, including the use of primary and secondary materials</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">engage critically with pertinent texts to make historic and theoretical arguments.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate how the political and philosophical definition of the individual changed over the course of the nineteenth century in Europe</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">short essay</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research paper</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral assessment</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art History and Curatorial Studies</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">History of Art</uni.:hasMajorTitle>
</owl:NamedIndividual>

