<owl:NamedIndividual rdf:about="#MUSC1054">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-MEMSD"/>
  <uni.:hasContact rdf:resource="#MUSC1054_contact_per_week_lectures_and_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1054</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theory for Electronic Musicians</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides a theoretical foundation for electronic music composition through practical engagement with the fundamental concepts of music theory, acoustics and digital audio. Students learn to play and recognise rhythmic patterns, scales, modes and fundamental chord progressions, with examples displayed within various notational systems. The fundamentals of digital audio are introduced, including sampling theory, as well as standard communication protocols such as MIDI. Students also examine the physical properties of sound as they relate to electronic music production, for instance in sound synthesis and effects processing.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of fundamental concepts of rhythm to create and improvise with basic rhythmic patterns</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise basic rhythmic patterns by sight and by ear, and play these back through tapping, hand-drumming or other means</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of the physical properties of sound</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a theoretical understanding of the fundamental concepts of rhythm including tempo, time signatures and rhythmic subdivision</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge perform basic scales, modes and chord progressions on standard MIDI keyboard controller</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of MIDI and digital audio hardware connectivity.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a theoretical understanding of the fundamentals of scales, modes and chord progressions</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rhythm and harmony proficiency tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rhythm and harmony assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final exam</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music: Electronic Music and Sound Design</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#School_Music">
  <rdf:type rdf:resource="http://uwa/uni.ot#School"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MJD-MEMSD">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:hasUnit rdf:resource="#MUSC2277"/>
  <uni.:hasUnit rdf:resource="#MUSC2273"/>
  <uni.:hasUnit rdf:resource="#MUSC3572"/>
  <uni.:hasUnit rdf:resource="#MUSC2274"/>
  <uni.:hasUnit rdf:resource="#MUSC1054"/>
  <uni.:hasUnit rdf:resource="#MUSC2276"/>
  <uni.:hasUnit rdf:resource="#MUSC1350"/>
  <uni.:hasUnit rdf:resource="#MUSC3571"/>
  <uni.:hasUnit rdf:resource="#MUSC1055"/>
  <uni.:listedInDegree rdf:resource="#BP001"/>
  <uni.:listedInDegree rdf:resource="#BH005"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-MEMSD</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music: Electronic Music and Sound Design</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Music and Sound Design is a creative-focused major. Students develop expertise in electronic music composition, sound design and production, programming, and software/hardware instrument design—skills applicable to a range of creative and technical professions. Studio and lab-based units permit students to think creatively, to invent and to innovate, exploring and developing ideas toward the formation of new electronic music and sound art works. The Electronic Music and Sound Design major culminates in a major project of the student's choosing, such as an album of electronic works, a sound installation, a film score, or live performance.</uni.:hasDescription>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of the physical properties of sound</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically engage with key works from the early twentieth century to the present day</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop specialised computer programming techniques for the development of custom interactive software and hardware instruments</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an established compositional technique with respect to rhythm, harmony and form, identify relevant historical and stylistic conventions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate broad historical perspectives on the nature and contexts of electronic music and sound art,</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop specialised sound design techniques applicable in key industries of film/tv, documentary, commercials and video gaming</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop transferable skills in creative and critical thinking, research, project planning and presentation.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an experimental and creative orientation in the production and presentation of original electronic music and sound artworks</uni.:hasOutcome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MUSC1054_contact_per_week_lectures_and_tutorials">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
