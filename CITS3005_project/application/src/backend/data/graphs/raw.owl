  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an intermediate unit in macroeconomic theory and policy applications. Topics include short-run economic fluctuations, long-run economic growth, unemployment, inflation and open economy.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
