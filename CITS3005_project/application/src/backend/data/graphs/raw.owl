  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-ARIDM</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Artificial Intelligence</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Bachelor of Advanced Computer Science (Artificial Intelligence) will equip you with the skills and knowledge to understand, evaluate, design and implement artificial intelligence systems. You'll learn tools and techniques to develop and use artificial intelligence systems make a significant contribution to communities, the success of organisations and the global economy. You will study the philosophical, legal and ethical context for AI in real-world applications. Working alongside inspiring researchers and industry, you'll get hands-on practice in in a variety of contemporary artificial intelligence techniques, from knowledge representation to deep learning, developing in-demand skills and leadership qualities for an exciting career in AI. This program is accredited by ACS for quality, career enablement and compliance with ACS and international Seoul Accord graduate standards. The Artificial Intelligence major (MJD-ARIDM) in the Bachelor of Advanced Computer Science (Honours) (BH008) is accredited by the Australian Computer Society (ACS).</uni.:hasDescription>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply contemporary artificial intelligence techniques, from knowledge representation, to deep learning</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work effectively as a team member and a leader for practical AI projects</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire the skills and knowledge to understand, evaluate, design and implement artificial intelligence systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extend knowledge in artificial intelligence through research, experimentation and analysis.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss the ethical, social and philosophical context for AI technologies as they apply to real world settings</uni.:hasOutcome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MJD-CYBER">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
