<owl:NamedIndividual rdf:about="#GENG4410">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:requiresDegree rdf:resource="#73540"/>
  <uni.:requiresDegree rdf:resource="#62560"/>
  <uni.:requiresDegree rdf:resource="#62550"/>
  <uni.:requiresDegree rdf:resource="#62520"/>
  <uni.:hasContact rdf:resource="#GENG4410_contact_per_week_workshop"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG4410</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fossil to Future The Transition</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the current global energy position, inclusive of economic and regulatory driving forces toward transition and future energy production systems, with a focus on an understanding of how the combination of production economics and energy density has dictated system design to date. We discuss how future energy will incorporate distributed storage and generation, the challenges to current transition and renewable energy technologies, and the use and development of transition fuels over the coming 3-5 decades. Finally, the unit explores WA's position in the global energy economy as a provider of LNG-based transition fuel, and as a technology leader in the renewables space.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Chemical Engineering specialisation, Environmental Engineering specialisation or Mechanical Engineering specialisation) or Enrolment in 62560 Master of Renewable and Future Energy or Enrolment in 62520 Master of Low Emission Energy Technologies or Enrolment in 73540 Master of Energy Geoscience or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and Successful completion of 96 points</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the environmental, societal and engineering constraints on the distributed energy landscape.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically appraise the current energy market and driving forces for change</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess energy density amongst current and future sources</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate centralised and distributed generation and distribution systems for regional applicability</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written assessment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">presentations</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
</owl:NamedIndividual>

