<owl:NamedIndividual rdf:about="#CIVL3401">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GENG2009"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECIVL"/>
  <uni.:hasContact rdf:resource="#CIVL3401_contact_seminars"/>
  <uni.:hasContact rdf:resource="#CIVL3401_contact_practical_classes"/>
  <uni.:hasContact rdf:resource="#CIVL3401_contact_lectures"/>
  <uni.:hasContact rdf:resource="#CIVL3401_contact_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CIVL3401</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Geomechanics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit develops students' knowledge of geotechnical engineering and explores the application of geomechanics principles to the solution of problems related to shallow foundations, slopes, embankments, retaining walls and ground improvement. Students learn how the mechanical characteristics of soils, as inferred from laboratory and in situ tests, can be applied in geotechnical design. Topics include site and soil characterisation, laboratory tests in soils for onshore and offshore applications, bearing capacity, earth pressure theory, retaining wall design, road cuttings and embankment design, ground improvement and slope stability.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of GENG2009 Principles of Geomechanics</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss accuracy requirements and limitations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply soil mechanics principles to the solution of engineering problems related to the stability of foundations, walls and slopes</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exercise improved interpersonal skills by working in groups</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proficiently write an engineering report on a laboratory experiment</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proficiently interpret geotechnical laboratory and field ground investigation techniques</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design and specify ground improvement schemes.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate increased awareness of construction practices</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class assessments and laboratory reporting</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mid-semester examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Civil Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

