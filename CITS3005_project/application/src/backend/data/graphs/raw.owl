<owl:NamedIndividual rdf:about="#FREN3814">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#FREN2404"/>
  <uni.:hasPrerequisite rdf:resource="#FREN2406"/>
  <uni.:hasPrerequisite rdf:resource="#FREN2408"/>
  <uni.:listedInMajor rdf:resource="#MJD-FRNHA"/>
  <uni.:hasContact rdf:resource="#FREN3814_contact_tutorial_per_week_for_10_weeks_weeks_1_10"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3814</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Francophone Caribbean Literature</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This cultural unit explores notions of history, identity, exile and belonging in contemporary francophone Caribbean literature. Through a study of selected texts by key writers from Martinique, Guadeloupe and Haiti, students will investigate how contemporary authors represent the complexities of identity when one is caught between competing cultural and historical influences. While the course locates these questions in the particular context of the francophone Caribbean, students will be encouraged to reflect more widely on these issues and to draw parallels between the Caribbean experience and that of other colonized nations. They will also discover one of the most vibrant and exciting bodies of writing in French. This unit is designed to help students towards achieving level B2/C1 of the Common European Framework of References for Languages.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN2404 French Studies 4 or FREN2406 French Studies 6 or FREN2408 French Studies 8</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read, analyse, and develop a historical and theoretical perspective on a body of contemporary literature in French</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate writing and research skills in a francophone literary context</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically assess a range of perspectives and contrast them with those from their own cultural background</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use oral, teamwork and interpersonal skills through classroom discussions in French.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research essay</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class tests</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FRNHA French Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FREN3814_contact_tutorial_per_week_for_10_weeks_weeks_1_10">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial per week for 10 weeks (weeks 1-10)</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</uni.:contactHours>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FREN1401">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-FRNHB"/>
  <uni.:hasContact rdf:resource="#FREN1401_contact_recorded_lectures"/>
  <uni.:hasContact rdf:resource="#FREN1401_contact_language_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN1401</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Beginners 1</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit offers an introduction to French grammar and vocabulary to allow students to communicate orally and in writing in simple situations. It develops cultural and linguistic awareness and focuses on contemporary spoken and written language used in France and other French-speaking countries.Students achieve language proficiency equivalent to Level A1 of the Common European Framework of Reference for Languages. This unit leads to FREN1402 French Beginners 2. Together, FREN1401 and FREN1402 provide access to Level 2 and Level 3 French units, which not only increase language competency but offer the opportunity to further engage with French and francophone history and culture, including literature, film and contemporary society, and to take advantage of a range of exchange opportunities in France and other French-speaking countries.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use independent learning skills and interpersonal skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate elementary skills in reading, writing, listening and speaking in the French language</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use basic sociolinguistic conventions in French</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate elementary knowledge of culture and society in French-speaking countries</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">show awareness of language and language use in both French and English.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral tasks</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">short tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an end-of-semester examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FRNHB French Studies</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is designed for students who have no previous knowledge or only a slight knowledge of French. Students who have studied French to WACE level or its equivalent cannot be admitted and should consult the unit coordinator regarding the appropriate unit for enrolment. Students with some knowledge of the language should consult the Convener of French.</uni.:hasNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MJD-FRNHB">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:hasUnit rdf:resource="#FREN3406"/>
  <uni.:hasUnit rdf:resource="#FREN1401"/>
  <uni.:hasUnit rdf:resource="#FREN2001"/>
  <uni.:hasUnit rdf:resource="#FREN2404"/>
  <uni.:hasUnit rdf:resource="#FREN3405"/>
  <uni.:hasUnit rdf:resource="#FREN3814"/>
  <uni.:hasUnit rdf:resource="#FREN1402"/>
  <uni.:hasUnit rdf:resource="#FREN3813"/>
  <uni.:hasUnit rdf:resource="#FREN2403"/>
  <uni.:listedInDegree rdf:resource="#BP054"/>
  <uni.:listedInDegree rdf:resource="#BP001"/>
  <uni.:listedInDegree rdf:resource="#BH005"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-FRNHB</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FRNHB French Studies</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Studies is the study of the French language and French and Francophone cultures. It teaches students high levels of competency in French through speaking, writing, listening and reading. The major offers a broad perspective on French-speaking societies through the study of their literature, cinema and history. Students are encouraged to deepen their understanding of French language and culture through exchange programs in France at approved universities in cities such as Paris, Lyon, Lille, Bordeaux and Grenoble. This major is taken by beginners. It is incompatible with a pass in WACE French: FRE2A/2B or higher.</uni.:hasDescription>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret French language texts—written, audio, visual—in the light of French culture and society</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interact confidently and successfully in situations involving French cultural conventions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">move with accuracy and skill between the English and French languages and cultures</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">show competence in the French language in the four macroskills of language acquisition—reading, writing, listening and speaking—rated according to the Common European Framework for Languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">creatively apply language skills to a range of different contexts.</uni.:hasOutcome>
</owl:NamedIndividual>

