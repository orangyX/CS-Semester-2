<owl:NamedIndividual rdf:about="#ANIM3306">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Agriculture_and_Environment"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#AGRI2201"/>
  <uni.:listedInMajor rdf:resource="#MJD-AGSCI"/>
  <uni.:listedInMajor rdf:resource="#MJD-AGTDM"/>
  <uni.:listedInMajor rdf:resource="#MJD-AGBUS"/>
  <uni.:hasContact rdf:resource="#ANIM3306_contact_Seminars"/>
  <uni.:hasContact rdf:resource="#ANIM3306_contact_Field_Trip"/>
  <uni.:hasContact rdf:resource="#ANIM3306_contact_Site_Visit"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANIM3306</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clean, Green and Ethical Animal Production</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is based on a new approach to agriculture through the development of animal production systems that are clean, green and ethical (CGE). The objective is for students to learn the scientific principles that underpin (1) the reduction in the use of chemicals and artificial hormones (clean); (2) the reduction of the negative impact on the environment (green); and (3) the optimisation of animal welfare (ethical). The unit is taught within the current landscape of farming systems in Western Australia and global animal production systems.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) AGRI2201 Pasture and Livestock Systems or level 2 Unit(s) ANIM2xxx</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the principles of clean, green and ethical animal production, including the supply chain and its importance to agriculture in the twenty-first century</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appraise the role of ongoing research and expansion of knowledge in animal industries</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply communication skills.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of the principles underpinning animal production industries</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
