<owl:NamedIndividual rdf:about="#KORE1401">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-KOREI"/>
  <uni.:hasContact rdf:resource="#KORE1401_contact_lectures"/>
  <uni.:hasContact rdf:resource="#KORE1401_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KORE1401</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean 1</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an introduction to Korean grammar and vocabulary, giving students the confidence to communicate with Koreans on basic everyday language topics both orally and in writing. No previous knowledge of Korea or Korean language is required. The unit develops intercultural communication skills as well as confidence in listening, speaking, reading and writing Korean. It provides a good basis for an intercultural understanding of Korean culture and society through situating the use of Korean language in relevant social and cultural contexts. The unit is useful for broadening students' international outlook, and for developing independent learning skills.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply appropriate beginner-level Korean language to selected cultural social situations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">achieve a comparative understanding of language and language use, in both Korean and English</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have an understanding of the Korean culture and society and how they inform basic sociolinguistic conventions in contemporary Korean language use</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate at beginner level in written and oral Korean on everyday topics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply basic methods of linguistic and cultural analysis, particularly in relation to contrastive modes in language learning.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply a variety of learning strategies relevant to the areas of syntax, semantics and phonetics</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral presentation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In class assessment</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

