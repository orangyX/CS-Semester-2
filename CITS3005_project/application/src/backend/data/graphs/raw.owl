<owl:NamedIndividual rdf:about="#ACCT3203">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ACCT2112"/>
  <uni.:hasPrerequisite rdf:resource="#ACCT1112"/>
  <uni.:listedInMajor rdf:resource="#MJD-ACCTG"/>
  <uni.:hasContact rdf:resource="#ACCT3203_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACCT3203</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Managerial Accounting</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on the strategic aspects of management planning and control for profit seeking firms and examines the contribution management accounting makes in setting and maintaining organisational direction. Topics include the development of performance measurement and evaluation systems within decentralised firms; the use of financial and non-financial performance measures for evaluating business unit performance; pricing intra-organisational exchanges; the cost allocation problem; and contemporary topics such as strategic cost management, customer profitability analysis and investment in new technology.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACCT1112 Management Accounting or ACCT2112 Management Accounting</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate solutions to problems to arrive at reasonably logical decisions in management accounting</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate clearly, concisely and logically, both orally and in written form</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply management accounting techniques to various types of manufacturing businesses that assist in decision making</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse problems that may arise in manufacturing and service businesses</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of how management accounting information assists managers to make effective planning and controlling decisions through in-depth knowledge of management accounting concepts and techniques</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an ability to work effectively in teams.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group assignment and verbal presentation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Student participation &amp; mid-semester test</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accounting</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ACCT1112">
  <rdf:type rdf:resource="http://uwa/uni.ot#FloatingUnit"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACCT1112</uni.:hasCode>
</owl:NamedIndividual>

