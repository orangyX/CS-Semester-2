<owl:NamedIndividual rdf:about="#LING2008">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#LING1001"/>
  <uni.:hasPrerequisite rdf:resource="#LING1002"/>
  <uni.:listedInMajor rdf:resource="#MJD-LINGO"/>
  <uni.:hasContact rdf:resource="#LING2008_contact_per_week_over_12_weeks"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LING2008</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How Language Shapes Society</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humans use language everyday. While naive views of language portray it as a tool used to communicate information, in reality, language defines and shapes communication as much as it serves it. As a result, language greatly contributes to shaping human groups and their organisation. Language indexes group identity, serves to structure society, feeds or resolves conflicts, and more. This unit will tackle these questions from various disciplinary angles. These include anthropological linguistics, which tells us which aspects of language influence human social life and how; sociolinguistics, which analyses how variation can reflect and enact social groupings; as well as languages in contact between groups and the role of bilingualism -- the use of more than one language in society.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LING1001 Language and Communication and LING1002 Language as a Cognitive System or 24 points in your chosen degree</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify properties of human groups, interactions and behaviors that are influenced by linguistic practices and/or ideologies.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the relationships between language and social structures or social life</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce small-scale analyses of linguistic data based on methods and concepts presented in the unit..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe key concepts in anthropological linguistics and/or sociolinguistics and/or language contact.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial preparation and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linguistics</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LING2008_contact_per_week_over_12_weeks">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">per week over 12 weeks</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:contactHours>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LING3003">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#LING2002"/>
  <uni.:hasPrerequisite rdf:resource="#LING2201"/>
  <uni.:listedInMajor rdf:resource="#MJD-LINGO"/>
  <uni.:hasContact rdf:resource="#LING3003_contact_per_week_over_12_weeks"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LING3003</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Language Across Time</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on the investigation and explanation of language change, both as a consequence of internal forces within a language community and through contact between language communities. It considers the history of thinking about language change and its role in the development of linguistics as a science, the development of the comparative method as a means of reconstructing past language states, and theories of language classification based on historical relationships of both inheritance and diffusion.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">( LING2002 Phonetics and Phonology: the Sounds of the World's Languages or LING2201 Phonetics and Phonology)</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use the comparative method to reconstruct past stages of a language</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">find, critically interpret and evaluate the content of scholarly publications in the literature on language change and language relationships.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate sub-grouping arguments and arguments about the primary genetic relationship between languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the process of language change and linguistic divergence</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in class test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workshop preparation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linguistics</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Please note that from 2027, LING3003 Language Across Time will only be available in Semester 2.</uni.:hasNote>
</owl:NamedIndividual>

