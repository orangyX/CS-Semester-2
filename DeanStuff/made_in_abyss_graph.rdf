    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Layer_2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Delver_Guild_HQ">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <mia:hasDescription>The Delver Guild HQ (探窟たんくつ組合くみあい本部ほんぶ, Tankutsu Kumiai Honbu) is the headquarters of the organization in charge of regulating delving processes, as well as managing the Delvers and giving them ranks according to their achievements.</mia:hasDescription>
    <rdfs:label>Delver Guild HQ</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/East_Orth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Bido">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Human"/>
    <rdfs:label>Bido</rdfs:label>
    <mia:lastKnownLocation rdf:resource="http://example.com/made-in-abyss/Ido_Front"/>
    <mia:hasGender>Male</mia:hasGender>
    <mia:hasSpecies>Human</mia:hasSpecies>
    <mia:hasStatus>Deceased</mia:hasStatus>
    <mia:hasOccupation>Umbra Hand</mia:hasOccupation>
    <mia:hasWhistleRank rdf:resource="http://example.com/made-in-abyss/BlackWhistle"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Flat_Creeper_Spike_Stretch">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
