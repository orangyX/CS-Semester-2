  <uni.:hasUnit rdf:resource="#CITS3001"/>
  <uni.:hasUnit rdf:resource="#CITS3007"/>
  <uni.:hasUnit rdf:resource="#CITS2005"/>
  <uni.:hasUnit rdf:resource="#CITS3403"/>
  <uni.:hasUnit rdf:resource="#CITS1401"/>
  <uni.:hasUnit rdf:resource="#CITS1402"/>
  <uni.:hasUnit rdf:resource="#CITS3002"/>
  <uni.:requiresBridging rdf:resource="#MATH1721"/>
  <uni.:listedInDegree rdf:resource="#BH005"/>
  <uni.:listedInDegree rdf:resource="#BP004"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-CMPSC</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computer Science</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computing software and systems are becoming increasingly integral to our lives, revolutionising the world in which we live, work and communicate. This major provides its students with the knowledge and skills required to participate in this revolution. Your studies develop your knowledge of theoretical, algorithmic, implementation and systems principles that underpin computer languages and networks. If you wish to play a role in developing new computing technologies or specialise in enterprise-level programming, systems, software engineering or research careers, then Computer Science is the major for you. The Computer Science major (MJD-CMPSC) in any course leading to a Bachelor of Science or Bachelor of Philosophy is accredited by the Australian Computer Society (ACS) for quality, career enablement and compliance with the Australian Computing Society (ACS) and international Seoul Accord graduate standards.</uni.:hasDescription>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design, implement, verify, test, and document robust and secure computer programs</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate software and systems requirements analysis, design, implementation, testing and documentation clearly in oral and written formats.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain ethical, social and security aspects and constraints of contemporary computer science practice</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the knowledge of design and operation of core computer system components to the development of computer systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify appropriate data structures and algorithms to solve computational problems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply team-based software development processes</uni.:hasOutcome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MJD-ESOFT">
