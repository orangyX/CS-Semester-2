<owl:NamedIndividual rdf:about="#ELEC3014">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#PHYS2003"/>
  <uni.:hasPrerequisite rdf:resource="#ENSC2003"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1012"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1012"/>
  <uni.:listedInMajor rdf:resource="#MJD-EELEC"/>
  <uni.:hasContact rdf:resource="#ELEC3014_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ELEC3014_contact_laboratories"/>
  <uni.:hasContact rdf:resource="#ELEC3014_contact_practical_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELEC3014</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Materials and Devices</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an understanding of electron behaviour as particles and as waves; properties and carrier dynamics of electrons in solids, particularly in semiconductors; the behaviour of pn junctions; and the operation, modelling and design of diodes and transistors.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods and PHYS2003 Physics for Electrical Engineers and ENSC2003 Engineering Electrical Fundamentals</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an ability to participate constructively, via meaningful contribution and respect for others' contributions, in team- or partner-based activities.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">model physical characteristics of a transistor as an electric circuit</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate carrier transport phenomena</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate how the evolution of electronic device technology has transformed industries such as energy, communications, manufacturing and medicine</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use Fermi-Dirac statistics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and explain experiment aims, methodology and outcomes orally and in a written report</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group assignments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electrical and Electronic Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

