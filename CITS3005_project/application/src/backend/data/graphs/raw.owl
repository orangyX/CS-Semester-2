  <uni.:hasPrerequisite rdf:resource="#SSEH1101"/>
  <uni.:hasPrerequisite rdf:resource="#ANHX1102"/>
  <uni.:listedInMajor rdf:resource="#MJD-ANHBY"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB3331</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Structure and Function - Limbs</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on the anatomy of limbs and teaches the relevant embryology, gross anatomy, functional application and imaging to ensure a holistic understanding of human anatomy of limbs</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of 54 points and Successful completion of ANHB2212 Human Structure and Development or Successful completion of ( SSEH1101 The Musculoskeletal System and Movement and any ANHB1101 Human Biology I: Becoming Human or ANHB1102 Human Biology II: Being Human or ANHX1101 Human Biology 1 (Becoming Human) or ANHX1102 Human Biology 2 (Being Human) )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of anatomical, developmental and evolutionary principles illustrated by the regional anatomy of limbs.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the topographical anatomy of the limbs</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the functional anatomy of the limbs</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in semester writing tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weekly laboratory preparation and participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final exam</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomy and Human Biology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Sciences (Anatomy and Physiology)</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recommended text books will be published in the unit outline</uni.:hasNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ANHB3310">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Human_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasContact rdf:resource="#ANHB3310_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ANHB3310_contact_labs"/>
  <uni.:hasContact rdf:resource="#ANHB3310_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB3310</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Biology: Applications and Investigations I</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In this unit students establish necessary skills for the investigative process including rigorous definition of problems and questions; careful and appropriate design of experiments and selection of method; creative thinking; careful acquisition of data (from literature, field or laboratory work); rigorous but imaginative validation, manipulation and interpretation of data; and presentation of investigations both as written and verbal reports. Using these techniques, students carry out their own group projects to independently investigate the organisation of a specific issue arising from their studies in other Level 3 units in Anatomy and Human Biology. The flexible structure of the unit allows for reading, tutorials and practical project work in areas of particular interest to individuals or small groups of students. Some flexibility of scheduling is also possible, with the consultation and consent of the unit coordinator.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-ANHBY Anatomy and Human Biology or MJD-HSNEM Human Science and Neuroscience</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate scientific information effectively through written reports, oral presentations, and the preparation of scientific and professional documents</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the ethical principles governing scientific research involving humans and animals, including ethics approval requirements and responsible research conduct</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collect, analyse and interpret scientific data from a range of sources, including literature, laboratory, field and survey investigations, using appropriate analytical techniques</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply critical thinking and professional scientific skills by working collaboratively, evaluating scientific evidence, responding constructively to feedback, and demonstrating a commitment to ethical practice and lifelong learning.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design scientific investigations by developing research questions, selecting appropriate methodologies, applying experimental controls, and recognising the strengths and limitations of different research approaches</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the scientific method, including the history and philosophy of science, and its application to scientific investigation</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group project work</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">manuscript writing</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistics assessment</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Science and Neuroscienc</uni.:hasMajorTitle>
</owl:NamedIndividual>

