<owl:NamedIndividual rdf:about="#CHPR2007">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHPR1005"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECHEM"/>
  <uni.:requiresDegree rdf:resource="#62520"/>
  <uni.:hasAdvisedUnit rdf:resource="#GENG2003"/>
  <uni.:hasContact rdf:resource="#CHPR2007_contact_lectures"/>
  <uni.:hasContact rdf:resource="#CHPR2007_contact_practical_classes"/>
  <uni.:hasContact rdf:resource="#CHPR2007_contact_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR2007</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heat and Mass Transfer</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the fundamental elements of heat and mass transfer. Students investigate heat transfer by conduction, convection and radiation. The analogy between heat and mass transfer is covered and applied in the analysis of convective and diffusive mass transfers.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of ( CHPR1005 Mass and Energy Balances and ( MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus ) ) or Enrolment in 62520 Master of Low Emission Energy Technologies</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse radiative heat transfer problems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse steady state thermal conduction and convection problems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appreciate the similarity between conduction heat transfer and diffusive mass transfer under many situations and analyse diffusive mass transfer problems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">think logically, understand the consequences of assumptions made during analyses and synthesise solutions to new problems..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">estimate the convective heat and/or mass transfer coefficients for flows over an external surface and flows within conduits</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1) demonstrate writing that is clear, well-structured and appropriate to audience and purpose</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">individual formal laboratory report</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

