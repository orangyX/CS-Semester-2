<owl:NamedIndividual rdf:about="#ECON2106">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#BUSN1103"/>
  <uni.:hasPrerequisite rdf:resource="#ECOX1101"/>
  <uni.:hasPrerequisite rdf:resource="#BUSN1200"/>
  <uni.:hasPrerequisite rdf:resource="#ECON1000"/>
  <uni.:hasPrerequisite rdf:resource="#ECON1101"/>
  <uni.:hasPrerequisite rdf:resource="#BUSN1104"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECNSM"/>
  <uni.:hasContact rdf:resource="#ECON2106_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON2106</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asia in the World Economy</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the role of Asian economies in the world economy. It investigates the recent growth of these economies and current relationship between these economies and the rest of the world.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any one Unit(s) from ECON1101 Microeconomics: Prices and Markets ECOX1101 Microeconomics: Prices and Markets ECON1000 Economics for Business BUSN1103 Foundations of Global Business or Successful completion of any two Unit(s) from BUSN1104 Business Communication for Change, Influence and Impact BUSN1200 Data Analytics for Business BUSN1103 Foundations of Global Business</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate, calculate and apply concepts and theories including that of economic growth, foreign direct investment and regional integration and</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the factors affecting economic growth in selected Asian economies.</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examinations</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research paper</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Business Economics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Economics</uni.:hasMajorTitle>
</owl:NamedIndividual>

