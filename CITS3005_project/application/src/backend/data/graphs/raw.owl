<owl:NamedIndividual rdf:about="#HIST3017">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#EURO2201"/>
  <uni.:listedInMajor rdf:resource="#MJD-HISTY"/>
  <uni.:listedInMajor rdf:resource="#MJD-GNWST"/>
  <uni.:hasContact rdf:resource="#HIST3017_contact_lecture"/>
  <uni.:hasContact rdf:resource="#HIST3017_contact_workshop_and"/>
  <uni.:hasContact rdf:resource="#HIST3017_contact_tutorial"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIST3017</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mysticism, Melancholy and Madness</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the emotions, beliefs and thought structures of people in pre-modern Europe 1100–1800. Drawing on methods from cultural history and the history of mentalities, we examine a range of questions such as: Were medieval women mystics who only ate the Eucharist 'anorexic'? Were Englishmen more prone to melancholy than their continental counterparts in Elizabethan times? Why were some early modern delusions, e.g. the belief that one was made of glass or clay, attributed to 'hypochondria', and others to demonic possession? In short, how were altered states of consciousness—from depression to divine illumination—understood, represented and treated, from medieval to early modern times?</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any Level 2 History or Level 2 Medieval and Early Modern Studies unit or EURO2201 Civilisation and Barbarism in European Cultural History. .</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and assess the basic methodological issues characteristic of the discipline of History</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate their independent source interpretations to the complex historiographical debates about histories of mentalities and histories of emotions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe, assess and evaluate methodological issues used in the study of mentalities in pre-modern Europe</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">present advanced arguments in both written and oral assessments using the conventions of the historical discipline.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate detailed understanding of developments in the history of mentalities, with particular reference to the history of altered states of consciousness, and an appreciation of the historiographical interpretations that have been advanced to explain them</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">construct a logical argument</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class-test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gender Studies</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">History</uni.:hasMajorTitle>
</owl:NamedIndividual>

