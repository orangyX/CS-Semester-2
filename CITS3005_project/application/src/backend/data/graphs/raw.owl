<owl:NamedIndividual rdf:about="#CHEM3103">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Molecular_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM2101"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM2102"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM3101"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHEMY"/>
  <uni.:hasContact rdf:resource="#CHEM3103_contact_laboratories"/>
  <uni.:hasContact rdf:resource="#CHEM3103_contact_lectures"/>
  <uni.:hasContact rdf:resource="#CHEM3103_contact_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEM3103</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organometallic Chemistry</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on the chemical principles and techniques introduced in CHEM2102-Metals in Molecules and covers several advanced topics concerned with the synthesis of molecules containing metals, or catalysed by metals, and their applications. The unit considers the chemistry of complexes that contain direct metal carbon bonds, as well as the types of ligands that are found, their stability and their reactivity. Appreciation of the roles metals play in conferring important properties to materials is also discussed. This unit will be offered from: TBA</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of CHEM2101 Analytical Methods and CHEM2102 Metals in Molecules and CHEM3101 Workplace Safety and Advanced Analytical Methods</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate advanced scientific writing, problem solving, critical analysis and teamwork.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire advanced practical skills in performing advanced laboratory procedures for synthetic and analytical chemistry</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the principles and concepts related to advanced topics in synthetic organometallic chemistry</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire advanced practical skills in the use of instrumentation and interpretation of spectroscopic data for structure determination of inorganic and organometallic compounds.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports and worksheets</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemistry</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will be offered from: 2025</uni.:hasNote>
</owl:NamedIndividual>

