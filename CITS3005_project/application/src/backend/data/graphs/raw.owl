<owl:NamedIndividual rdf:about="#ITAL3817">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-ITLNI"/>
  <uni.:listedInMajor rdf:resource="#MJD-ITLNA"/>
  <uni.:listedInMajor rdf:resource="#MJD-ITLNB"/>
  <uni.:hasContact rdf:resource="#ITAL3817_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITAL3817</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modern Italy in Film</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit studies social, historical and cultural aspects of Italian society through the analysis of Italian feature films. The unit covers the major periods of Italian cinematography in the last hundred years, focussing on major periods and directors. Secondary texts from the directors and their associates are also used as documentary and illustrative material.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any Level 2 Italian unit</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse technical and literary aspects of films</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse representations of historical events in film, in the context of the time of production</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use the Italian language in spoken and written form at Level B2/C1 of the Common European Framework of Reference for Languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of Italian films in terms of the historical development of the genre</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITLNA Italian Studies</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITLNB Italian Studies</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITLNI Italian Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

