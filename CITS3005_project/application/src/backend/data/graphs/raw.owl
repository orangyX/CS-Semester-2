<owl:NamedIndividual rdf:about="#ENGL1501">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-EGCST"/>
  <uni.:hasAdvisedUnit rdf:resource="#ENGL1401"/>
  <uni.:hasAdvisedUnit rdf:resource="#ENGL1000"/>
  <uni.:hasAdvisedUnit rdf:resource="#ENGL1002"/>
  <uni.:hasContact rdf:resource="#ENGL1501_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENGL1501</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reading Creatively/Writing Creatively</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit engages with the joy and power of the written word. Investigating several aspects of writing practice, it aims to develop craft and narrative technique. Students work throughout the semester to plan and then write one or more pieces of creative work (fiction, creative non-fiction, poetry or script). The use of a range of creative techniques and strategies is explored through the discussion in lectures and tutorials of a selection of creative texts, as well as in reference to the students' own writing through a series of creative exercises across the unit. Students are encouraged to read widely as a further important tool to develop their creative writing skills. Please note that this unit does not deal with journalism or standard non-fiction.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">express ideas concisely and clearly in both oral and written formats</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply a range of reading strategies important in theory and culture</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">craft a completed literary work</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce creative, original forms of thought and expression</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critique major creative works</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of major literary techniques and their effects.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
