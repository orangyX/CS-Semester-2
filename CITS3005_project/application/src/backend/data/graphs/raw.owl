<owl:NamedIndividual rdf:about="#GENG1101">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-EBMEG"/>
  <uni.:listedInMajor rdf:resource="#MJD-EMECH"/>
  <uni.:hasContact rdf:resource="#GENG1101_contact_lectures"/>
  <uni.:hasContact rdf:resource="#GENG1101_contact_practical_workshop_classes"/>
  <uni.:hasContact rdf:resource="#GENG1101_contact_CAD_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG1101</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering Drawings</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Students are introduced to the use of drawings in engineering. Students will engage in practical classes learning freehand sketching and basic engineering drawing. Additional classes will teach Computer Aided Drafting (CAD). Students will also learn about different types of engineering plans and drawings from a range of engineering disciplines, including PNIDs, electrical circuit diagrams, HVAC diagrams, etc. Students will become familiar with the conventions and standards used in different areas, and will be required to interpret different types of drawings.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use sketching and hand-drawing as a tool for visualisation and communication</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce appropriately-dimensioned drawings using the standards and conventions of engineering drawing</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prepare 2D and 3D representations of typical engineering objects</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the purpose of engineering drawing in the design and manufacture process</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate proficiency in the use of Computer-aided drawing software.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret a variety of engineering drawings and diagrams from different engineering contexts</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class drawing and CAD exercises</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sketching portfolio</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class tests</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanical Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

