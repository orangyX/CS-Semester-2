<owl:NamedIndividual rdf:about="#LING3007">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#LING2001"/>
  <uni.:listedInMajor rdf:resource="#MJD-LINGO"/>
  <uni.:hasContact rdf:resource="#LING3007_contact_per_week_over_12_weeks"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LING3007</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linguistics of Australian Indigenous Languages</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Indigenous languages of Australia form a unique part both of the story of human language and of Australian Indigenous heritage. The unit examines broad practical and social issues in linguistic research on Australian languages and introduces the range of applied linguistic work that linguists are often involved in, for instance language maintenance activities and education. The linguistic fabric that forms the background of these issues will also be examined, in particular the diversity of Australian languages and the typological parameters by which they can usefully be compared and classified.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LING2001 Morphosyntax of the World's Languages</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the issues involved in the genetic classification of Australian languages.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a knowledge of the broad ethical and political issues involved in the contemporary study of Australian languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe important research issues in the contemporary study of Australian languages and critically assess papers addressing these issues</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise areas of applied linguistic work involving Australian languages, especially language maintenance activities</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe common structural features of Australian languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the main typological parameters</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">essay</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial preparation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linguistics</uni.:hasMajorTitle>
</owl:NamedIndividual>

