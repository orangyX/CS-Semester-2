<owl:NamedIndividual rdf:about="#PHIL3003">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#HUMR2001"/>
  <uni.:hasPrerequisite rdf:resource="#PPHE2211"/>
  <uni.:hasContact rdf:resource="#PHIL3003_contact_tutorial"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL3003</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moral Theory</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The core of this unit consists in a survey of influential moral theories. Students engage both with contemporary readings and with certain classic texts such as those of Aristotle, Kant and J. S. Mill. The details vary from year to year, but typically include: (1) theories of intrinsic value and wellbeing such as hedonism, preferentism and objective theories; (2) consequentialist theories of moral rightness, including act-utilitarianism and rule-utilitarianism; (3) deontological theories of moral rightness, including pluralism, Kantianism and contractualism; and (4) virtue-ethical theories, with a focus on Aristotle's Nichomachean Ethics.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any level 2 Philosophy unit or PPHE2211 History of Political Ideas or HUMR2001 Global and Environmental Justice</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a knowledge of three of the most influential texts in the history of Western moral philosophy—Aristotle's Nicomachean Ethics, Kant's Groundwork for the Metaphysics of Morals, and Mill's Utilitarianism.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">independently interpret complex philosophical texts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how moral judgements differ from non-moral judgements</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">construct persuasive arguments concerning difficult philosophical issues</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distinguish between deontological, consequentialist, and virtue-theoretical approaches to moral theorising</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate complex philosophical positions and arguments</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate advanced written communication and research skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weigh the virtues and vices of competing philosophical doctrines</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reflect on the nature and purpose of philosophy and philosophical argumentation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply general moral theories to concrete actions and social policies</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise and utilise the sorts of evidence and reasoning that is relevant for establishing a moral conclusion</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of complex philosophical arguments and positions</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weekly quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philosophy, Politics and Economics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Rights</uni.:hasMajorTitle>
</owl:NamedIndividual>

