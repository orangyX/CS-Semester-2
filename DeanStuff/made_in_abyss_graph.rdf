    <mia:hasDangerLevel rdf:resource="http://example.com/made-in-abyss/Deadly_Danger"/>
    <mia:hasDescription>The Crimson Splitjaw (ベニクチナワ, Benikuchinawa) is a giant scarlet red reptile with a serpentine body that primarily lives in the steep cliffs of the 3rd Layer of The Abyss</mia:hasDescription>
  </rdf:Description>
