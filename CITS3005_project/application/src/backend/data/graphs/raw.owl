<owl:NamedIndividual rdf:about="#NEUR3310">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Biomedical_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#PHYL2002"/>
  <uni.:hasPrerequisite rdf:resource="#PHAR2220"/>
  <uni.:listedInMajor rdf:resource="#MJD-NEURS"/>
  <uni.:hasAdvisedUnit rdf:resource="#ANHB2217"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEUR3310</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuroscience</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with advanced knowledge of the physiology, pharmacology and function of the nervous system. Students will learn the cellular physiology of neural circuits in detail, contemporary techniques used to study the nervous system, select neurological disorders and their pharmacological and non-pharmacological treatments. In addition, students will learn how to conduct and analyse neuroscience experiments using modern techniques.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of Unit(s) PHYL2002 Cellular Physiology or PHAR2220 Human Pharmacology or equivalent</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the physiological and behavioural mechanisms of selected neurological disorders, as well as the experimental models used to study them, and their pharmacological and non-pharmacological treatments</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the cellular, molecular and/or genetic principles relevant to nervous system function</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse,visualise, and interpret neuroscience behavioural data.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain selected research techniques used to study the nervous system</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research-based report</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in semester tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exam</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Science and Neuroscience</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuroscience</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MATH1011">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
