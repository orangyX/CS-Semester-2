  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Blaze_Reap">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Artifact"/>
    <rdfs:label>Blaze Reap</rdfs:label>
    <mia:hasDescription>An abnormally large pickaxe containing Everlasting Gunpowder.</mia:hasDescription>
    <mia:hasEffect>Injects an explosion into a struck object.</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Riko"/>
