  <uni.:listedInMajor rdf:resource="#MJD-MCBIM"/>
  <uni.:hasContact rdf:resource="#MICR3310_contact_lectures"/>
  <uni.:hasContact rdf:resource="#MICR3310_contact_workshops_laboratory_sessions"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MICR3310</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microbial Ecology and One Health</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit describes the importance of microbes in human and animal ecosystems, and in nature. The unit presents concepts and principles in microbial ecology including the role of the human microbiome in health and disease, microorganisms at the interface between animals and humans, endemic and epidemic disease. The roles of infectious disease surveillance, interventions to prevent infectious disease transmission and probiotic interventions are considered. Key ecological roles of microbes including in terrestrial and aquatic ecosystems, interactions with biota and the physicochemical environment, and their consequences (beneficial and detrimental) for human activities are investigated. In addition to expanding their breadth of knowledge of microbiology, students will develop analytical skills for interpreting microbial datasets, and practical laboratory skills.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MICR2208 Introductory Microbiology and MICR2209 Introduction to Infectious Diseases and Immunology or MICR2208 Introductory Microbiology and IMED2001 Body Defences</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the ecological roles and activities of microbes in the natural environment, the human host, animal reservoirs and at the human-animal interface</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate scientific findings using group and individual scientific writing activities</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the principles and appropriate use of a range of environmental microbiology techniques including water quality analysis, the effects of environmental variables on microbial activity, biogeochemical cycling and the application of microbes to pollution remediation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse microbial genomic and surveillance datasets, and scientific publications.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microbiology and Immunology</uni.:hasMajorTitle>
</owl:NamedIndividual>

