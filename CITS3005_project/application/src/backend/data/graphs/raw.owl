</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ECON3236">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2204"/>
  <uni.:hasPrerequisite rdf:resource="#ECON2234"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2205"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2207"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2209"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2222"/>
  <uni.:hasContact rdf:resource="#ECON3236_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON3236</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Finance</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is concerned with the operation and role of international financial markets from a macroeconomic standpoint. Topics include national income accounts, the balance of payments accounts, foreign exchange markets, money markets, models of the exchange rate, and monetary and fiscal policy under different exchange rate regimes.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of ECON2234 Macroeconomics: Policy and Applications or Successful completion of any Unit(s) from FINA2222 Corporate Financial Policy FINA2204 Derivative Products and Markets FINA2205 Practical Finance Analytics FINA2207 Business Analysis and Valuation FINA2209 Financial Planning</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the national income and balance of payments accounts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the role of monetary and fiscal policy in floating and fixed exchange rate regimes.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the money market and the theory of money demand and money supply</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the foreign exchange</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the theories of exchange-rate determination</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class participation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial Economic</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FINA2222">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#FINX1221"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2221"/>
  <uni.:hasPrerequisite rdf:resource="#FINA1221"/>
  <uni.:listedInMajor rdf:resource="#MJD-FINCE"/>
  <uni.:hasContact rdf:resource="#FINA2222_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA2222</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corporate Financial Policy</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on the first-year finance unit FINA1221 to further students' knowledge of finance from the corporate financial manager's point of view, and develops skills in planning and decision making in the financial area. Topics include capital structure theories; payout policies (such as dividends); cost of capital; risk management; capital raisings including shares, debt and convertible securities issuances; and the practical aspects of mergers and acquisitions.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA1221 Introduction to Finance or FINX1221 Introduction to Finance or FINA2221 Introduction to Finance</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the reasons why firms restructure via mergers and acquisition and determine the effect on firm value</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compute the weighted average cost of capital for a firm taking into account the tax environment and analyse the impact of future changes in capital structure on the firm and its stakeholders</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate the ability to evaluate the capital structures of particular companies and an awareness of current developments in this area</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the valuation techniques to the appraisal of real and financial assets.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">case study</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weekly assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial Economics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finance</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FINA2204">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#FINX1221"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2221"/>
  <uni.:hasPrerequisite rdf:resource="#STAT1520"/>
  <uni.:hasPrerequisite rdf:resource="#STAX1520"/>
  <uni.:hasPrerequisite rdf:resource="#FINA1221"/>
  <uni.:listedInMajor rdf:resource="#MJD-FINCE"/>
  <uni.:hasContact rdf:resource="#FINA2204_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA2204</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Derivative Products and Markets</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with basic concepts of options, futures and other derivative securities, and their role in risk management. Topics include charateristics and basic properties of options, forward and futures, their pricing and uses in trading and hedging strategies.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STAT1520 Economic and Business Statistics or equivalent or STAX1520 Economic and Business Statistics and FINA1221 Introduction to Finance or FINX1221 Introduction to Finance or FINA2221 Introduction to Finance</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the meaning and structures of financial derivatives and the differences among them</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify when and how to use these financial derivatives in risk management</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate and price different financial derivatives, and how to exploit any mispricing</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce clear and concise written communication and effective oral presentations.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop competencies to work effectively in teams</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examinations</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finance</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FINA2205">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#STAX1520"/>
  <uni.:hasPrerequisite rdf:resource="#FINX1221"/>
  <uni.:hasPrerequisite rdf:resource="#STAT1520"/>
  <uni.:hasPrerequisite rdf:resource="#FINA1221"/>
  <uni.:listedInMajor rdf:resource="#MJD-BUSAN"/>
  <uni.:listedInMajor rdf:resource="#MJD-FINCE"/>
  <uni.:hasContact rdf:resource="#FINA2205_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA2205</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Practical Finance Analytics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides Accounting and Finance students with a background of various statistical techniques used in addressing financial decisions. The unit covers probability theory, regression and time series analyses with emphasis on practical rather than theoretical aspects. Applications to financial modelling include optimal portfolio, portfolio management and asset pricing.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STAT1520 Economic and Business Statistics or equivalent or STAX1520 Economic and Business Statistics and FINA1221 Introduction to Finance or equivalent or FINX1221 Introduction to Finance or equivalent</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the concept of distributions of a random variable</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate ability to work in a team and to provide constructive feedback</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain different types of distributions such as Normal, Bernoulli, Exponential, Log-normal and Uniform</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and understand the properties of commonly used time series models</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structure and test hypotheses</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply regression and time series analyses to dynamic global financial markets such as options and portfolios</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">construct optimal portfolios based on the Markowitz's theory of optimal allocation of securities.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply regression and time series techniques to analyse simulate/generate and analyse data based on statistical tools such as regression analysis</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Participation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Economics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Business Analytics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finance</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FINA2207">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-BUSAN"/>
  <uni.:listedInMajor rdf:resource="#MJD-FINCE"/>
  <uni.:hasAdvisedUnit rdf:resource="#ACCT2201"/>
  <uni.:hasContact rdf:resource="#FINA2207_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA2207</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Business Analysis and Valuation</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit emphasises how parties external to the company employ publicly available information, company reports and financial market information to evaluate the current, and predict the future, financial condition of the company. The analytical techniques of financial statement analysis (e.g. fundamental analysis, cash flow analysis and pro forma analysis) and the issue of the reliability and quality of publicly available information are discussed and explored. Analytical tools are applied in different decision contexts such as equity valuation, mergers and acquisitions, lending decisions and the evaluation of managerial performance.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of FINA1221 Introduction to Finance or FINX1221 Introduction to Finance or Enrolment in MJD-BUSAN Business Analytics</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explore and evaluate the determinants of a firm's market-to-book ratio</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce a clear and concise written equity research report</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an awareness of business strategies and activities that create value</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deliver oral presentations that are clear and coherent.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of how fundamental or intrinsic firm values are estimated</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss the relevance of cash flows, dividends, earnings and book values in firm valuation and integrate profitability into a firm's value</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">individual assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Business Analytics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finance</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FINA2209">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#FINX1221"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2221"/>
  <uni.:hasPrerequisite rdf:resource="#FINA1221"/>
  <uni.:listedInMajor rdf:resource="#MJD-FINCE"/>
  <uni.:hasContact rdf:resource="#FINA2209_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA2209</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial Planning</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit equips students with the knowledge and expertise necessary for the provision of financial advice to individuals concerned about their personal and family finances. It covers the role and obligations of the financial planner; identification of the regulatory, investment, budgeting and personal advisory issues in financial planning; identification of the available investments and the tools used to hedge against risks; understanding the role of taxation in financial planning, the importance of superannuation and estate planning; and likely regulatory and financial markets developments in the field and a survey of the most promising areas for research. The unit also covers the structure and the design of a typical financial plan.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA1221 Introduction to Finance or FINX1221 Introduction to Finance or FINA2221 Introduction to Finance</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate the role of taxation and superannuation in financial planning</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outline the importance and components of an effective estate plan and asset protection plan</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and critically review the regulatory, investment, budgeting and personal advisory issues impacting the provision of personal financial advice</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify available investment opportunities utilising rapidly-changing innovations to construct an investment portfolio for a client</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the obligations of the provider of personal financial advice and discuss ethical considerations faced by personal financial advice providers</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop effective communication skills.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">individual activities</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finance</uni.:hasMajorTitle>
</owl:NamedIndividual>

