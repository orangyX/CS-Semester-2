<owl:NamedIndividual rdf:about="#NEUR1001">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Biological_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-NEURS"/>
  <uni.:hasContact rdf:resource="#NEUR1001_contact_Lectures"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEUR1001</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuroscience in Society</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inside our heads, weighing about 1.5 kg, the brain is an astonishing organ consisting of billions of tiny cells. With our extraordinary brains, we sense the world around us, process information and interact with our environment and the living beings within it. Over history, our brains have contribute to complex and mysterious behaviours in many different cultures and societies. The human brain is the most complex organ of the body and arguably the most complex thing on earth! In this unit, students become explorers of the human brain and the behaviours that it underpins. Each week, the unit describes the most up to date information about how the brain is involved in a particular aspect of human behaviour. It then extends and challenges students' thinking to consider the significance and impact of this behaviour on ourselves and on society. It helps students to seek a new way to approach some of the really challenging and important questions in life such as—What is beauty? Why do we have wars? How does the brain process mystical and religious experiences? Why do we love music? Why are jokes funny? The objectives of the unit are to (1) explore how big issues in our multicultural society can be explored and addressed by studying the brain; (2) experience the challenges of global communication via social media; (3) integrate science and creativity to explore global issues in society; (4) encourage students to experience creative thinking in a multidisciplinary learning environment; and (5) engage in a creative process that is inspired by scientific data.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">create an original artwork</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">show multidisciplinary understanding of human behaviours at a global level</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate across disciplines to integrate Neuroscience with an important issue in society</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how complex behaviours in individuals, cultures and societies are underpinned by brain function and organisation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">generate a piece of scientific writing.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flexible</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">online activities</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">major assignment: creative work and scientific writing</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interactive discussion sessions</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Science and Neuroscience</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuroscience</uni.:hasMajorTitle>
</owl:NamedIndividual>

