<owl:NamedIndividual rdf:about="#KORE1404">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#KORE1403"/>
  <uni.:listedInMajor rdf:resource="#MJD-KOREI"/>
  <uni.:hasAdvisedUnit rdf:resource="#ASIA1002"/>
  <uni.:hasAdvisedUnit rdf:resource="#ASIA1001"/>
  <uni.:hasContact rdf:resource="#KORE1404_contact_workshop"/>
  <uni.:hasContact rdf:resource="#KORE1404_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KORE1404</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean 4</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a continuing unit in the Korean language at an upper intermediate level, preceded by KORE1403 Korean 3. The unit aims to develop students' understanding of Korean culture and society to a level that enables effective use of Korean in everyday situations. It provides further consolidation and improvement of students' skills in reading, writing, listening and speaking in Korean on a range of topics involving increased grammar and vocabulary. Learning and teaching methods involve the use of interactive classroom exercises, engaging with audiovisual materials and authentic materials. The unit enhances students' translingual and transcultural competence. Successful completion of this unit aims to bring students to the equivalent of intermediate Level 2 of the Test of Proficiency in Korean (TOPIK).</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of KORE1403 Korean 3</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plan, execute, and present research projects in Korean on current affairs using appropriate conventions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use resource materials such as dictionaries and online resources to solve problems of language form.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">converse in Korean on everyday topics and express own views with an intermediate understanding of Korean grammar and phonology</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply written Korean language skills to compose upper intermediate-level passages on social and abstract themes</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply appropriate intermediate-level Korean language to selected cultural and social situations with ability to apply various relevant sociolinguistic registers</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written assessment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class assessment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral assessment</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

