<owl:NamedIndividual rdf:about="#GRMN2404">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GRMN2403"/>
  <uni.:listedInMajor rdf:resource="#MJD-GRMNB"/>
  <uni.:hasContact rdf:resource="#GRMN2404_contact_Seminar"/>
  <uni.:hasContact rdf:resource="#GRMN2404_contact_language_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN2404</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">German Studies 4</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is intended for students who have completed GRMN2403 German Studies 3. The unit consolidates and improves the language ability of learners of German at an intermediate level and further develops cultural and linguistic awareness. In addition, students develop a better understanding of how languages work in general (both in the target language and in English). The seminar uses the discussion and analysis of German cultural productions such as film, literature and music as the basis for language acquisition, focusing on a range of sociopolitical themes and their connections to wider cultural phenomena. This is where students have the opportunity to develop their listening comprehension, reading and communication skills. The language class reinforces and deepens the knowledge of contemporary German language usage and grammatical structures. Students gain an increased level of competency in all four macro skills—listening to, speaking, reading and writing German—corresponding to Levels A2/B1 of the Common European Framework of Reference for Languages (Gemeinsamer Europaischer Referenzrahmen). Students also develop an increased awareness of intercultural understanding and language learning, as well as research skills and communication strategies.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN2403 German Studies 3</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to Levels A2/B1 of the Common European Framework of Reference for Languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased awareness of intercultural understanding and language learning, as well as research skills and communication strategies.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral tasks</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests and quizzes</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMNB German Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GRMN2405">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GRMN1404"/>
  <uni.:hasPrerequisite rdf:resource="#GRMN1104"/>
  <uni.:listedInMajor rdf:resource="#MJD-GRMNI"/>
  <uni.:hasContact rdf:resource="#GRMN2405_contact_seminar"/>
  <uni.:hasContact rdf:resource="#GRMN2405_contact_language_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN2405</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">German Studies 5</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit integrates speaking, listening comprehension, reading and writing with the study of materials drawn from German literary and cultural history. Focusing on the analysis and discussion of audiovisual materials and selected texts, the seminar introduces students to central issues in German history and society during the first half of the twentieth century. The language class reinforces and deepens the knowledge of contemporary German language usage and grammatical structures at an advanced level. Students gain an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to proficiency Level B1 and upwards of the Common European Framework of Reference for Languages (Gemeinsamer Europaischer Referenzrahmen). Students also develop an increased awareness of intercultural understanding and of language learning, as well as research skills and communication strategies and increased awareness of how languages work in general.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN1404 German Studies 4 or GRMN1104 German Intermediate II</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to proficiency Level B1 and upwards of the Common European Framework of Reference for Languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased awareness of intercultural understanding and of language learning, as well as research skills and communication strategies.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral tasks</uni.:hasAssessment>
