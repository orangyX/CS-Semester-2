  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">full report</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">practical exercise</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conservation Biology</uni.:hasMajorTitle>
