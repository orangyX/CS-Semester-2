<owl:NamedIndividual rdf:about="#CHEM2104">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Molecular_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHEX1002"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM2101"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM1001"/>
  <uni.:hasPrerequisite rdf:resource="#CHEX1001"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM1002"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHEMY"/>
  <uni.:hasContact rdf:resource="#CHEM2104_contact_workshops"/>
  <uni.:hasContact rdf:resource="#CHEM2104_contact_lectures"/>
  <uni.:hasContact rdf:resource="#CHEM2104_contact_laboratories"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEM2104</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Energy and Materials</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on the foundation of core chemical principles and experimental techniques provided in first year units. More advanced concepts in physical and materials chemistry, the chemical industry, energy storage, and the environment, are presented. Chemical and thermodynamic concepts are taught in the context of contemporary real-world examples. This unit will be offered from Semester 2 2024</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of CHEM1001 Chemistry—Properties and Energetics or CHEX1001 Chemistry—Properties and Energetics and CHEM1002 Chemistry—Structure and Reactivity or CHEX1002 Chemistry Structure and Reactivity and CHEM2101 Analytical Methods</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the principles and concepts related to physical chemistry</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire practical skills in the evaluation of experimental measurements and their reliability.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the principles and concepts related to thermodynamics and kinetics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate scientific writing, problem solving, critical analysis and teamwork</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire practical skills in the analysis of data</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the principles and concepts related to materials chemistry</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire practical skills in the operation of relevant instrumentation</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports and worksheets</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geochemistry</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemistry</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will be offered from Semester 2 2024</uni.:hasNote>
</owl:NamedIndividual>

