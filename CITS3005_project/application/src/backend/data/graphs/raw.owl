<owl:NamedIndividual rdf:about="#ELEC4402">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ELEC3015"/>
  <uni.:hasPrerequisite rdf:resource="#STAT2063"/>
  <uni.:requiresDegree rdf:resource="#62550"/>
  <uni.:hasAdvisedUnit rdf:resource="#MATH3023"/>
  <uni.:hasAdvisedUnit rdf:resource="#ELEC3015"/>
  <uni.:hasAdvisedUnit rdf:resource="#ENSC3015"/>
  <uni.:hasContact rdf:resource="#ELEC4402_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ELEC4402_contact_practical_classes"/>
  <uni.:hasContact rdf:resource="#ELEC4402_contact_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELEC4402</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Communications Systems</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Students are introduced to communication systems in order to understand the fundamental aspects of both analogue and digital communications. This includes filtering, modulation and demodulation, source and channel coding, and information theory.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Electrical and Electronic Engineering specialisation) or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and Successful completion of ( STAT2063 Probabilistic Methods and their Applications and ELEC3015 Signals and Systems )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse various analog modulation schemes in terms of system performance</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the basics of information theory in digital communications, and explain the basics of source coding and channel coding using simple examples</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work effectively in a team.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carry out performance analysis</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse and design digital communication systems over various channels</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply filtering of random signals in the design of communication systems in the presence of random noise</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carry out noise analysis for analogue communication systems</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class tests and assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
</owl:NamedIndividual>

