    <mia:hasDescription>A unique Artifact initially believed to nullify the effects of the Curse of the Abyss.</mia:hasDescription>
    <mia:hasEffect> Those inside will still suffer the effects of the curse and possibly die as a result, but whatever is placed inside will come back to life seemingly unaffected and will immediately start crawling towards the center of the Abyss before dying again sometime later.</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Ozen"/>
    <mia:hasGrade rdf:resource="http://example.com/made-in-abyss/First_Grade"/>
  </rdf:Description>
