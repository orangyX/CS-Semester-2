<owl:NamedIndividual rdf:about="#EMPL3208">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-WKERL"/>
  <uni.:hasContact rdf:resource="#EMPL3208_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMPL3208</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Managing Diversity</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit aims to introduce key concepts and theories about the management of workplace diversity and inclusion. Through Australian and international case studies, the unit also aims to create an applied understanding about 1) some of the main challenges faced by minority groups, and 2) practical inclusion strategies for ensuring that organisations take full advantage of an increasingly diverse labour market.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 points of study at any level, including at least 12 points of Bachelor of Commerce units</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate diversity issues to sociological and psychological theories of work and organisations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand current developments in the management of workplace diversity, and differentiate between diversity, equality and inclusion</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate why diversity, equality and inclusion are important for organisational performance and culture</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop interpersonal communication skills, openness, and understanding of the importance of listening to different views and opinions.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse the effectiveness of management strategies that promote workplace diversity and inclusion</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group project</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Examinations</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Work and Employment Relations</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#School_UWA_Business_School">
  <rdf:type rdf:resource="http://uwa/uni.ot#School"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MJD-WKERL">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:hasUnit rdf:resource="#EMPL2309"/>
  <uni.:hasUnit rdf:resource="#EMPL1101"/>
  <uni.:hasUnit rdf:resource="#EMPL3208"/>
  <uni.:hasUnit rdf:resource="#EMPL3270"/>
  <uni.:hasUnit rdf:resource="#EMPL2202"/>
  <uni.:hasUnit rdf:resource="#EMPL3241"/>
  <uni.:hasUnit rdf:resource="#EMPL1206"/>
  <uni.:hasUnit rdf:resource="#EMPL3301"/>
  <uni.:listedInDegree rdf:resource="#BP001"/>
  <uni.:listedInDegree rdf:resource="#BH005"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-WKERL</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Work and Employment Relations</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Work and Employment Relations major focuses on the dynamics of workplace relations between employers and employees as well as the wider impact of employment relations on the economy, society and politics. You will study how work is organised, the way employees are managed, the role of unions, how cooperation and negotiation can be developed, and how conflict can emerge and be managed. The nature of employment relations in both Australia and other countries is examined using institutional and sociological perspectives.</uni.:hasDescription>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how to formulate appropriate responses to relevant policy and managerial issues</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use effective communication skills, both written and oral</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate and understand key concepts, theories and practices in employment relations as well as have an understanding of perspectives on the transformation of work and society drawn from relevant social (sociology, labour studies) and legal studies (employment law) disciplines</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work and manage teams.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand principles of ethical behaviour and social responsibility in contemporary organisations and society</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the interests of workers, unions, managers, employers and the State within the workplace and the broader social context of work</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply relevant theories to practical contexts and issues</uni.:hasOutcome>
</owl:NamedIndividual>

