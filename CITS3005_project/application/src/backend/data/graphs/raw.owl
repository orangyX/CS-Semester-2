<owl:NamedIndividual rdf:about="#GENG2009">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1011"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1012"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1011"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1012"/>
  <uni.:hasPrerequisite rdf:resource="#PHYX1001"/>
  <uni.:hasPrerequisite rdf:resource="#PHYS1001"/>
  <uni.:requiresDegree rdf:resource="#62570"/>
  <uni.:hasContact rdf:resource="#GENG2009_contact_Labs"/>
  <uni.:hasContact rdf:resource="#GENG2009_contact_Lectures"/>
  <uni.:hasContact rdf:resource="#GENG2009_contact_Tutorial"/>
  <uni.:hasContact rdf:resource="#GENG2009_contact_Practice_sessions"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG2009</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Principles of Geomechanics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit presents an introduction to soil mechanics for civil engineering foundation designs and mining engineering. The topics range from the basic soil classifications for engineering purpose, to concepts of effective stress; soil compression and consolidation; seepage; and the strength of soils. The underlying framework is that of critical state soil mechanics which links the strength and stiffness of soil to the density and effective stress level. In-class practice sessions are an essential component of the teaching of the unit to ensure students gain supervised experience in the application of effective stress and critical state principles. Students gain hands-on experience in laboratory experiments and report on soil engineering properties based on the laboratory experiments. The laboratory experiments are designed to supplement understanding gained at lectures on the soil classification and strength of soils.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of ( ( MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus and MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods and PHYS1001 Physics for Scientists and Engineers or PHYX1001 Physics for Scientists and Engineers ) ) or Enrolment in 62570 Master of Offshore and Coastal Engineering</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the role of geotechnical engineering in the civil and mining engineering design process</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply geotechnical design principles in civil and mining engineering design</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">write concise technical reports</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perform soil laboratory tests on soil properties for foundation design</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify soil properties, compressibility and strength for soil foundation design</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the pros and cons of soil laboratory testing</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work effectively and cooperatively in teams.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">module tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory participation and quiz</uni.:hasAssessment>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolled students can access unit materials via the LMS (Learning Management System).</uni.:hasNote>
</owl:NamedIndividual>

