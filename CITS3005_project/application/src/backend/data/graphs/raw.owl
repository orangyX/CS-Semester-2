<owl:NamedIndividual rdf:about="#CHPR2018">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHPR1005"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECHEM"/>
  <uni.:hasAdvisedUnit rdf:resource="#CHEM1001"/>
  <uni.:hasAdvisedUnit rdf:resource="#MATH1011"/>
  <uni.:hasAdvisedUnit rdf:resource="#MATH1012"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR2018</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process Synthesis and Design 1</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit serves as an introduction to chemical engineering. The unit covers basic engineering economics, optimisation and scale up principles and lifecycle cost analysis. Process design, safety, process flow diagrams (PFD), piping and instrumentation diagrams (PID), equipment sketches, basic design calculations and plant isometrics are discussed through the lens of different common chemical engineering processes such as polymerisation, distillation, minerals processing, oil refining, waste treatment etc. The unit also covers further development of process simulation covering implementation of reactions and recycle in HYSYS. Pump systems, valves and process measurement are also introduced in this unit.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR1005 Mass and Energy Balances</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain different approaches available for chemical process synthesis and design, and their safety and economic constraints</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conduct preliminary cost estimations and flow-sheeting of a chemical process</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">write concise technical reports</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conduct high level safety audits of chemical processes.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret Process Flow Diagrams and other chemical engineering design documents</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop strategies for dealing with open-ended chemical engineering problems</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">presentation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

