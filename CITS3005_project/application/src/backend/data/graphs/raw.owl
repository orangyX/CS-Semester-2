<owl:NamedIndividual rdf:about="#MJD-FNART">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Design_School"/>
  <uni.:hasUnit rdf:resource="#HART2223"/>
  <uni.:hasUnit rdf:resource="#ARTF2041"/>
  <uni.:hasUnit rdf:resource="#ARTF3040"/>
  <uni.:hasUnit rdf:resource="#ARTF1052"/>
