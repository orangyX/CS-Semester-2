<owl:NamedIndividual rdf:about="#MUSC2345">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSMT"/>
  <uni.:hasContact rdf:resource="#MUSC2345_contact_seminar_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2345</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre: Exploring Characterisation</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Great characters are central to the success of a musical theatre production. Therefore, the choices that composers, librettists, and directors make to shape their character and bring them to life are central to the creative process. In this unit, students will begin by analysing a selection of book musicals and jukebox musicals from a dramaturgical, musical, and choreographic perspective separately to understand how each aspect functions in these works. Students will then combine these analytical methodologies with in-class case studies and an independent research project. These studies will allow students to develop a deeper understand of musical theatre functions from a variety of perspectives. This unit is open to all students who have an interest in music.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of level 1 24 points</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate critical reading, thinking, and communication skills in relation to musical theatre</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse dramaturgical and choreographic aspects of musical theatre</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate knowledge of key musical theatre developments to relevant cultural and historical contexts.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss developments in book and jukebox musicals and identify stylistic characteristics of these works</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse compositional aspects of musical theatre</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research portfolio</uni.:hasAssessment>
