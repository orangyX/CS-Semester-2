<owl:NamedIndividual rdf:about="#SCIE3314">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Agriculture_and_Environment"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#AGRI1001"/>
  <uni.:listedInMajor rdf:resource="#MJD-AGSCI"/>
  <uni.:listedInMajor rdf:resource="#MJD-AGTDM"/>
  <uni.:listedInMajor rdf:resource="#MJD-AGTEC"/>
  <uni.:hasAdvisedUnit rdf:resource="#AGRI2201"/>
  <uni.:hasContact rdf:resource="#SCIE3314_contact_lectures_computer_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCIE3314</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crops and Cropping Systems</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on how agricultural systems in Western Australia are rapidly changing in response to the need for more environmentally responsible production methods and a changing climate. The unit introduces the main temperate crop species and then uses a systems approach to provide an understanding of the relationships between crops, pastures, livestock, weeds, plant diseases and the environment. There is in-depth consideration of crop agronomy, conservation cropping, no-tillage and weed and disease control. Modelling as a tool to improve our understanding of complex agricultural systems is discussed and models evaluated.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) AGRI1001 Feeding the World</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply principles of conservation agriculture, soil fertility management, cereal phenology, and break-crop agronomy to develop management recommendations appropriate to the conditions and constraints of WA broadacre farming systems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesise agronomic, environmental, financial, and crop protection knowledge to construct a professional agronomic management package for a major WA grain crop, including a gross margin analysis and a quantitative nitrogen management strategy..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse how Mediterranean-type climate patterns, soil constraints, and seasonal water balance dynamics in WA interact to determine crop management timing, variety selection, and production risk.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the biological and economic impact of weeds, fungal diseases, insect pests, and soil-borne pathogens on grain production in WA, and formulate integrated management strategies that account for resistance mechanisms, economic thresholds, and environmental conditions.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competence in using a process-based crop simulation model to predict crop growth, water use, and nitrogen response under varying management and climate scenarios, and critically evaluate model outputs to inform agronomic decision-making.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the role of Australian and Western Australian grain production within global food supply systems, and identify the environmental, economic, and social factors that shape the structure and management of broadacre cropping enterprises.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glasshouse trial - Cereal Derby</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">computer practicals and online learning</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agronomy report - Farm Interview and Agronomic Package report</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agricultural Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agricultural Science and Technology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agricultural Technology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agribusiness and Agricultural Science</uni.:hasMajorTitle>
</owl:NamedIndividual>

