<owl:NamedIndividual rdf:about="#PHYL3003">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Human_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#PHYL1001"/>
  <uni.:hasContact rdf:resource="#PHYL3003_contact_labs"/>
  <uni.:hasContact rdf:resource="#PHYL3003_contact_tutorials"/>
  <uni.:hasContact rdf:resource="#PHYL3003_contact_lectures"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYL3003</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nutritional and Metabolic Physiology</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This Level 3 unit comprises a series of lecture, laboratory, and tutorial sessions. Each session helps a student to understand the importance of qualitative and quantitative aspects of nutrition for basic sustenance as well as growth and activity. Normal function is supplemented with activities that investigate scenarios when various pathologies lead to metabolic dysfunction. The unit covers the function and regulation of the gastrointestinal system by examining the digestion an absorption of macro- and micronutrients. Energy balance in the body and disorders that result in impaired metabolic function are evaluated. The unit builds on the material covered in Level 1 PHYL1001 Physiology – how your body works. The unit further develops student's laboratory techniques for physiological measurement, focusing on data recording, statistical analysis, and the graphical presentation of data. The unit has a major focus on written scientific communication. The results from two of the laboratories are used to complete two scientific papers. The unit also reinforces aspects of teamwork and interpersonal skills in both experimental work and communication.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of PHYL1001 Physiology - How your body works and 96 points or Successful completion of 48 points and Enrolment in MJD-IMSCP Integrated Medical Sciences and Clinical Practice</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate familiarity with experimental techniques that are relevant to human metabolism including data collection for the nutritional assessment of individuals.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically evaluate the scientific literature relating to nutrition and metabolism, using self-directed learning.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise the importance of qualitative and quantitative aspects of nutrition for sustaining life, for growth and activity, and in metabolic dysfunction.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise the function and regulation of the gastrointestinal system in relation to the digestion and absorption of macro- and micronutrients.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse data</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate effective participation in group work</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply this knowledge of metabolism and nutrition in understanding of the importance of energy balance in the body, and of disorders of impaired metabolic function.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competence in scientific communication skills using written group reports..</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group reports</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
</owl:NamedIndividual>

