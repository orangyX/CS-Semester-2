<owl:NamedIndividual rdf:about="#MICR3310">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Biomedical_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
