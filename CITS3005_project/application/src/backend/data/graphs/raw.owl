<owl:NamedIndividual rdf:about="#MGMT2311">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MGMX1136"/>
  <uni.:hasPrerequisite rdf:resource="#MGMT1136"/>
  <uni.:hasPrerequisite rdf:resource="#MGMX1135"/>
  <uni.:hasPrerequisite rdf:resource="#MGMT1135"/>
  <uni.:hasContact rdf:resource="#MGMT2311_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT2311</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organisational Learning and Innovation</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the concepts and issues which influence approaches to organisational structure and design. Topics include contemporary organisational forms; organisation-environment relationships; organisational structures for effective learning and innovation; the role of organisational culture; managing dynamic processes in the workplace; and the impact of knowledge workers on organisational structure and processes. Topics are reinforced through analysis of a range of case studies designed to strengthen students' analytical and problem-solving skills.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT1135 Organisational Behaviour or MGMX1135 Organisational Behaviour or MGMT1136 Management and Organisations or MGMX1136 Management and Organisations</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the unit's content through its application to solving problems in real-life case studies.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss the role of leadership, organisational structure and processes in facilitating organisational learning and innovation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and identify the potential issues and problems that managers and leaders encounter in the effective management of organisational learning and innovation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and discuss key processes and mechanisms that organisations need to develop in order to build learning and innovation capabilities to achieve long-term competitive advantage</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and discuss theories, concepts and models of organisational learning and innovation pertaining to firms in knowledge-intensive industries</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">case studies</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enterprise and Innovatio</uni.:hasMajorTitle>
</owl:NamedIndividual>

