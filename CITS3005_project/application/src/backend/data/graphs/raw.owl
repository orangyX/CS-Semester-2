<owl:NamedIndividual rdf:about="#ANHB2214">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Human_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB1101"/>
  <uni.:hasPrerequisite rdf:resource="#IMED1001"/>
  <uni.:hasPrerequisite rdf:resource="#SCIX1106"/>
  <uni.:hasPrerequisite rdf:resource="#ANHX1101"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB1102"/>
  <uni.:hasPrerequisite rdf:resource="#BIOL1130"/>
  <uni.:hasPrerequisite rdf:resource="#ANHX1102"/>
  <uni.:hasPrerequisite rdf:resource="#SCIE1106"/>
  <uni.:listedInMajor rdf:resource="#MJD-ANHBY"/>
  <uni.:hasAdvisedUnit rdf:resource="#ANHB1101"/>
  <uni.:hasAdvisedUnit rdf:resource="#ANHB1102"/>
  <uni.:hasContact rdf:resource="#ANHB2214_contact_week_Self_directed_completion_of_online_course_content_and_continuous_assessment_1_5_hours_week_In_person_laboratory_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB2214</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Organs and Systems</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores various systems of the human body, including cardiovascular, respiratory, endocrine, urinary, skeletal, digestive and reproductive. Students will become familiar with histological sections from different body systems – each week 1.5 hours will be spent examining the microscopic structure of organs using microscopes. Students will become proficient in basic light microscopy. Elements taught in ANHB2214 Human Organs and Systems will assist in transitioning to ANHB3323 Cells, Tissue, and Development.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any two Unit(s) ANHB1101 Human Biology I: Becoming Human or ANHX1101 Human Biology 1 (Becoming Human) or ANHB1102 Human Biology II: Being Human or ANHX1102 Human Biology 2 (Being Human) or BIOL1130 Frontiers in Biology or SCIE1106 Molecular Biology of the Cell or SCIX1106 Molecular Biology of the Cell or IMED1001 Form and Function</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply learning to differentiate human organs at the level of cells, tissues and organs by identifying, contrasting and describing key structural and functional features.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and describe the histological organisation and structure of human organs and</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">online quizzes and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final on campus examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomy and Human Biology</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ANHB2214_contact_week_Self_directed_completion_of_online_course_content_and_continuous_assessment_1_5_hours_week_In_person_laboratory_classes">
