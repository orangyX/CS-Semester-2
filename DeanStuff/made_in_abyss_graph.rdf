    <rdf:type rdf:resource="http://example.com/made-in-abyss/Artifact"/>
    <rdfs:label>Fog Weave</rdfs:label>
    <mia:hasDescription>A very thin and lightweight piece of cloth that floats over the ground.</mia:hasDescription>
    <mia:hasEffect>Lightweight fabric</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Nanachi"/>
