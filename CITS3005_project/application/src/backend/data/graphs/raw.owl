<owl:NamedIndividual rdf:about="#MATH2501">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1011"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1011"/>
  <uni.:hasContact rdf:resource="#MATH2501_contact_lectures"/>
  <uni.:hasContact rdf:resource="#MATH2501_contact_practical_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH2501</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Mathematical Methods</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from MATH1011 Multivariable Calculus and MATH1012 Mathematical Theory and Methods. It provides a foundation in some of the more advanced concepts and techniques of mathematics which are required in a number of disciplines, especially Physics.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be familiar with basic ordinary differential equations and their solution methods</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be familiar with a number of partial differential equations and their solution methods</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand and use the methods of complex analysis</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use the method of separation of variables to solve partial differential equations.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand Fourier series and Fourier transforms, and their applications</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand and employ the fundamental theorems of multivariable calculus</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examinationi</uni.:hasAssessment>
</owl:NamedIndividual>

