<owl:NamedIndividual rdf:about="#ENVT3362">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Agriculture_and_Environment"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ENVT2250"/>
  <uni.:hasPrerequisite rdf:resource="#SCIE2204"/>
  <uni.:hasPrerequisite rdf:resource="#ENVT2220"/>
  <uni.:hasPrerequisite rdf:resource="#SCIE2267"/>
  <uni.:hasPrerequisite rdf:resource="#ENVT2251"/>
  <uni.:hasPrerequisite rdf:resource="#EART2204"/>
  <uni.:listedInMajor rdf:resource="#MJD-ENVSC"/>
  <uni.:listedInMajor rdf:resource="#MJD-ENVMT"/>
  <uni.:listedInMajor rdf:resource="#MJD-MARCP"/>
  <uni.:hasContact rdf:resource="#ENVT3362_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ENVT3362_contact_labs_and_computer_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT3362</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Dynamics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decision making for managing environmental systems is increasingly guided by modelling studies in which risks to environmental condition are quantified and future scenarios are assessed. Students are introduced step-by-step to model building of environmental systems drawn from examples such as climate change and land-use change impacts on biodiversity, water and contaminant movement in natural and disturbed landscapes, rivers and also coastal systems. The unit covers issues including the use of models in decision support frameworks, uncertainty and model assessment methods.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) ENVT2250 Ecology or Unit(s) ENVT2220 The Climate System or Unit(s) ENVT2251 Hydrology and Water Resource Management or Unit(s) SCIE2204 Marine Systems or Unit(s) EART2204 Coastal Processes or Unit(s) SCIE2267 Quantitative Methods in Environmental Management</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a good knowledge of systems analysis, its terminology, core concepts and its use in environmental science</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop conceptual models describing interactions and processes relevant to environmental systems, ranging from catchment to coast and considering both physical and ecological dimensions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess how models can be used as decision support tools for environmental management, and understand the basic principles of model sensitivity and uncertainty assessment.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">translate conceptual models into simple quantitative compartment models and demonstrate use of more advanced modelling packages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an overview of model approaches and the utility of different types of models for understanding environmental systems</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">online theory quiz</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modelling workbook</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written report</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geographical and Spatial Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Science and Management</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Science and Ecology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine and Coastal Processes</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Management</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrated Earth and Marine Sciences</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ENVT2220">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Agriculture_and_Environment"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-ENVSC"/>
  <uni.:listedInMajor rdf:resource="#MJD-GGRPY"/>
  <uni.:listedInMajor rdf:resource="#MJD-MARCP"/>
  <uni.:hasContact rdf:resource="#ENVT2220_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ENVT2220_contact_practicals_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT2220</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Climate System</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit investigates the physical basis of the climate system and mechanisms of anthropogenic climate change and variability. Importance is placed on the role of the land surface in the climate system including the carbon cycle, land use change and urbanisation. Processes such as the greenhouse effect, aerosols, the El Nino-Southern Oscillation, climate feedbacks and rapid climate change are examined. Paleo, historical and climate model data are presented and assessed. Likely future climate changes are addressed and option for adaptation and mitigation for human society.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesise the physical understanding of the climate system and feedbacks witihin.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the changes in climate over the past, present and future</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">know the physical basis of the climate system and mechanisms of anthropogenic climate change and variability</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate climate change and appreciate skepticism</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret land surface data from measurement of key Australian ecosystems</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a research report based on interpreting land surface data from a key Australian ecosystem</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">practical exercise or practical report for each of 5 practical's total to take place approximately one every two weeks, with one in the first two weeks</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geographical Sciences</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geographical and Spatial Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Science and Management</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine and Coastal Processes</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Science and Ecology</uni.:hasMajorTitle>
</owl:NamedIndividual>

