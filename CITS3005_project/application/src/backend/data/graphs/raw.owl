  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lectures/tutorials</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:contactHours>
