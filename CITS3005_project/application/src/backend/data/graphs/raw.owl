<owl:NamedIndividual rdf:about="#MKTG3303">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MKTG1342"/>
  <uni.:hasContact rdf:resource="#MKTG3303_contact_lectures_tutorials_seminars_workshops_online"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG3303</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">New Product Development</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on new product development (NPD) approaches and frameworks practiced within established small and large firms. The first part of this unit concentrates on product development (idea generation, crowdsourcing, business analytics, screening, and concept testing). This is followed by intellectual property protection and market development (beta testing, product launch, NPD branding strategies, portfolio management, and market entry). This unit combines the elements of strategic management, strategic marketing, business analytics, and marketing research, but has a specific focus on NPD.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any two level 2 Unit(s) (Marketing) or MKTG1342 Introduction to Enterprise and Innovation</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate a new product development strategy for a potential innovation.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the path to market for product innovation, including resistance that may need to be overcome in order to succeed</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the process of innovation management in both small and large firms</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically review the new product development process and the role that customers play in product definition</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the various forms of intellectual property</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class participation and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enterprise and Innovatio</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MKTG3303_contact_lectures_tutorials_seminars_workshops_online">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lectures/tutorials/seminars/workshops/online</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:contactHours>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MKTG3304">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MKTG1203"/>
  <uni.:listedInMajor rdf:resource="#MJD-MRKTG"/>
  <uni.:hasContact rdf:resource="#MKTG3304_contact_lectures_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG3304</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brand Management</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brands are intangible, but extremely valuable. Many organisations maintain competitive advantage based on the value of their brand; their brand equity. How, though, do we build and manage brands? This unit will answer this question, exposing you to real-world branding situations and decisions. You will learn about the concept of brand equity, and which strategic and tactical brand management decisions are necessary to build and maintain it.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MKTG1203 Introduction to Marketing Successful completion of any level 2 Unit(s) MJD-MRKTG Marketing</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">give oral presentations in a clear and coherent manner</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce clear and concise written communication.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competencies to work effectively in diverse teams</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate the effectiveness of the various components of a brand and how they interact</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recommend creative strategies and tactics to build, measure and manage brand equity</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically reflect on the brand and the various functions of brand management</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preparation and participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">simulation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marketing</uni.:hasMajorTitle>
</owl:NamedIndividual>

