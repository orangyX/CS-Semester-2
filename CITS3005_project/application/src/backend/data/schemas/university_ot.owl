<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://uwa/uni.ot"
         xmlns="http://uwa/uni.ot#">

<owl:Ontology rdf:about="http://uwa/uni.ot"/>

<owl:ObjectProperty rdf:about="#belongsTo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Enrollable"/>
  <rdfs:range rdf:resource="#School"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#locatedIn">
  <rdfs:domain rdf:resource="#Enrollable"/>
  <rdfs:range rdf:resource="#Location"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasStudyType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="#StudyType"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMajor">
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="#Major"/>
  <owl:inverseOf rdf:resource="#majorOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#includesDegree">
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="#Degree"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnit">
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Unit"/>
  <owl:inverseOf rdf:resource="#unitOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requiresBridging">
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPrerequisite">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Unit"/>
  <owl:inverseOf rdf:resource="#prerequisiteOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#majorOf">
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Degree"/>
  <owl:inverseOf rdf:resource="#hasMajor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#unitOf">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Major"/>
  <owl:inverseOf rdf:resource="#hasUnit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prerequisiteOf">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Unit"/>
  <owl:inverseOf rdf:resource="#hasPrerequisite"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasCode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Enrollable"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasTitle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Enrollable"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDescription">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Enrollable"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasOutcome">
  <rdfs:domain rdf:resource="#Enrollable"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasTotalPoints">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDuration">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLevel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCredit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isAvailable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#offeredIn">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMode">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAssessment">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPrerequisiteText">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Enrollable">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Degree">
  <rdfs:subClassOf rdf:resource="#Enrollable"/>
</owl:Class>

<owl:Class rdf:about="#Major">
  <rdfs:subClassOf rdf:resource="#Enrollable"/>
</owl:Class>

<owl:Class rdf:about="#Unit">
  <rdfs:subClassOf rdf:resource="#Enrollable"/>
</owl:Class>

<owl:Class rdf:about="#FloatingUnit">
  <rdfs:subClassOf rdf:resource="#Unit"/>
</owl:Class>

<owl:Class rdf:about="#School">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Location">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#StudyType">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Bachelor">
  <rdfs:subClassOf rdf:resource="#StudyType"/>
</owl:Class>

<owl:Class rdf:about="#Honours">
  <rdfs:subClassOf rdf:resource="#StudyType"/>
</owl:Class>

<owl:Class rdf:about="#Combined">
  <rdfs:subClassOf rdf:resource="#StudyType"/>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Degree"/>
    <rdf:Description rdf:about="#Major"/>
    <rdf:Description rdf:about="#Unit"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
