<owl:NamedIndividual rdf:about="#MICR3330">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Biomedical_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MICR2209"/>
  <uni.:hasPrerequisite rdf:resource="#MICR2208"/>
  <uni.:hasPrerequisite rdf:resource="#IMED2001"/>
  <uni.:listedInMajor rdf:resource="#MJD-MCBIM"/>
  <uni.:hasContact rdf:resource="#MICR3330_contact_lectures"/>
  <uni.:hasContact rdf:resource="#MICR3330_contact_labs_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MICR3330</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bacteria and Bacterial Disease</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the structure, physiology and genetics of bacteria as they relate to the pathogenesis of infectious disease. The unit offers a strong theoretical background in the biology of bacteria, the virulence mechanisms and strategies employed by bacterial pathogens, and the design of novel prevention and treatment strategies based on our understanding of bacterial pathogenesis. Lectures are complemented with laboratory classes that develop technical, analytical and reporting skills. The unit has the following themes: (1) bacterial cell structure and physiology; (2) molecular genetics and evolution of bacteria; and (3) mechanisms of bacterial pathogenesis.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MICR2208 Introductory Microbiology and MICR2209 Introduction to Infectious Diseases and Immunology or MICR2208 Introductory Microbiology and IMED2001 Body Defences</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe mechanisms by which bacteria interact with their hosts to cause disease</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe bacterial cell structure, physiology and genetics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the characteristics, epidemiology, pathogenesis and control of major bacterial pathogens.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obtain practical skills in the culture and manipulation of bacteria in the laboratory</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain processes of gene regulation in bacteria</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests and open book quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final exam</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microbiology and Immunology</uni.:hasMajorTitle>
</owl:NamedIndividual>

