<owl:NamedIndividual rdf:about="#KORE1402">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#KORE1401"/>
  <uni.:listedInMajor rdf:resource="#MJD-KOREI"/>
  <uni.:hasContact rdf:resource="#KORE1402_contact_lectures"/>
  <uni.:hasContact rdf:resource="#KORE1402_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KORE1402</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean 2</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a continuing upper-beginner level unit following on from KORE1401 Korean 1 (or equivalent). It aims at further development of listening, speaking, reading and writing skills with increased vocabulary, language functions and a good basic grammar in everyday communicative situations. The unit develops intercultural communication skills as well as confidence in listening, speaking, reading and writing Korean. It provides a good basis for an intercultural understanding of Korean culture and society through situating the use of Korean language in relevant social and cultural contexts. The unit is useful for broadening students' international outlook, and for developing independent learning skills.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of KORE1401 Korean 1 or equivalent</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have broader understanding of the Korean culture and society and how they inform everyday sociolinguistic conventions in contemporary Korean language</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">achieve increased understanding of language and language use, in both Korean and English</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply appropriate upper beginner-level Korean language to selected cultural social situations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply basic methods of linguistic and cultural analysis, particularly in relation to contrastive modes in language learning.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply a variety of learning strategies relevant to the areas of syntax, semantics and phonetics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate at upper beginner level in written and oral Korean on everyday topics</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final Exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class assessment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral assessment</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

