<owl:NamedIndividual rdf:about="#GENG5501">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GENG2003"/>
  <uni.:hasPrerequisite rdf:resource="#GENG2010"/>
  <uni.:requiresDegree rdf:resource="#62570"/>
  <uni.:requiresDegree rdf:resource="#62550"/>
  <uni.:hasAdvisedUnit rdf:resource="#GENG2003"/>
  <uni.:hasAdvisedUnit rdf:resource="#ENSC3010"/>
  <uni.:hasAdvisedUnit rdf:resource="#ENSC3003"/>
  <uni.:hasAdvisedUnit rdf:resource="#GENG2010"/>
  <uni.:hasContact rdf:resource="#GENG5501_contact_Lectures"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG5501</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coastal and Offshore Engineering</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The objective of this unit is to develop students' ability to apply fundamental knowledge in hydraulics, soil mechanics and structural mechanics to solve a wide range of coastal and offshore engineering problems. Students are expected to develop a good understanding of how fundamental knowledge is applied to solve practical engineering problems, the ability to apply basic engineering mechanics principles to analyse coastal and offshore engineering problems, and self-learning skills. The topics covered in the unit include wave mechanics, wave forecasts, wave forces on offshore and coastal structures, structural responses to wave loading, near shore hydrodynamic processes, sediment transport, and the design of coastal and offshore structures such as artificial reefs, breakwaters and subsea infrastructure.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Civil Engineering specialisation or Environmental Engineering specialisation or Mechanical Engineering specialisation) or Enrolment in 62570 Master of Offshore and Coastal Engineering or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and Successful completion of ( 120 points and ( GENG2003 Fluid Mechanics or GENG2010 Principles of Hydraulics ) )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe marine sediment transport processes and evaluate their impacts on the safety of marine facilities and coasts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate effectively in written reports and technical presentations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participate effectively in teams</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predict wave loading on marine structures</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">choose and apply appropriate wave theories</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate critical thinking and problem-solving skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design and manage coastal and offshore facilities.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
</owl:NamedIndividual>

