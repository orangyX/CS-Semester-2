<owl:NamedIndividual rdf:about="#GEND2902">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GEND3901"/>
  <uni.:hasPrerequisite rdf:resource="#GEND1901"/>
  <uni.:hasPrerequisite rdf:resource="#GEND3904"/>
  <uni.:hasPrerequisite rdf:resource="#GEND2903"/>
  <uni.:hasPrerequisite rdf:resource="#ENGL1902"/>
  <uni.:listedInMajor rdf:resource="#MJD-GNWST"/>
  <uni.:hasContact rdf:resource="#GEND2902_contact_per_week_for_11_weeks"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GEND2902</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Masculinity, Nostalgia and Change</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores contemporary masculinities against the backdrop of the historical impact of feminism, nostalgic narratives of masculinity in 'crisis', the emergence of alternative masculinities, men's rights activism, concerns about men's health, and calls for male 'champions' or 'allies' of feminism. Students draw from feminist theory, queer theory, critical race theory, sociology and cultural studies – the main fields that comprise 'masculinity studies' – to explore the politics of spotlighting masculinity; changing cultural approaches to masculinity; and the intersectional power relations that structure a range of masculinities such as hegemonic or subordinated masculinities. Methodologically, the unit is an extended exploration of how to balance compassion and accountability in the task of supporting and advancing healthy gender relations that enable all human beings to thrive.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of GEND1901 Beyond 'Gender Wars' or ENGL1902 Reading Bodies or GEND2903 Sex, Gender, Technology and Science or GEND3901 Feminist Thought or GEND3904 Queer Theory or Successful completion of 36 points</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use communication strategies that model and facilitate respect for others, social inclusion, and constructive dialogue.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically evaluate and use key theoretical approaches to the study of men and masculinities</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an interdisciplinary understanding of the ways masculinity is implicated in the production of knowledge</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse the social construction of masculinity in diverse texts and contexts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of key concepts relevant to the theorisation of masculinity in a coherent, accessible fashion</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation and engagement</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reflective summary assessment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conversation fieldwork assessment</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gender Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LAWS3212">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Law_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#LAWS2223"/>
  <uni.:listedInMajor rdf:resource="#MJD-CRIMN"/>
  <uni.:hasContact rdf:resource="#LAWS3212_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS3212</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Working with People in the Justice System 2</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unit will provide an overview of how the effectiveness of treatment interventions can be measured through research and evaluation. It will explore how effective treatment options can be applied in case management. It will discuss how to address barriers to effective interventions in the criminal justice system. It will also explore the need for self-awareness and reflection when working with justice-involved populations.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LAWS2223 Criminal Justice Systems</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe methodologies to measure the effectiveness of therapeutic interventions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess strategies to address barriers to effective interventions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply this critical thinking to case management scenarios.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise and critically analyse problems arising in the use of these methodologies</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">case management report</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group project and presentation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reflective essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Criminology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Criminology and Criminal Justice</uni.:hasMajorTitle>
</owl:NamedIndividual>

