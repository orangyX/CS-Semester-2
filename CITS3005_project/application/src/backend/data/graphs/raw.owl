  <uni.:hasPrerequisite rdf:resource="#LAWS1104"/>
  <uni.:hasPrerequisite rdf:resource="#LAWS2301"/>
  <uni.:hasPrerequisite rdf:resource="#LAWS2201"/>
  <uni.:listedInMajor rdf:resource="#MJD-BSLAW"/>
  <uni.:hasContact rdf:resource="#LAWS3222_contact_Online_Learning_Modules"/>
  <uni.:hasContact rdf:resource="#LAWS3222_contact_Face_Workshops"/>
  <uni.:hasContact rdf:resource="#LAWS3222_contact_Tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS3222</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taxation Law</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit gives students a basic understanding of how the Australian taxation laws apply to a wide variety of business and financial transactions.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LAWS1104 Introduction to Law or LAWX1104 Introduction to Law and LAWS2301 Company Law or LAWS2201 Legal Framework of Business</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the taxation implications of a range of business transactions.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solve problems involving the computation of the taxable income of an individual</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how the taxation laws apply to companies, partnerships and trusts at a basic level</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the operation of the goods and services tax</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of the key concepts of Australian taxation law</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically review how the tax system is administered</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the tax agent's professional and ethical responsibilities</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Business Law</uni.:hasMajorTitle>
</owl:NamedIndividual>

