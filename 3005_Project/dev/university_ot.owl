<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://uwa/uni.ot"
         xmlns="http://uwa/uni.ot#">

<owl:Ontology rdf:about="http://uwa/uni.ot"/>

<owl:ObjectProperty rdf:about="#hasPrerequisite">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Unit"/>
  <owl:inverseOf rdf:resource="#isPrerequisiteOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isPrerequisiteOf">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Unit"/>
  <owl:inverseOf rdf:resource="#hasPrerequisite"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inMajor">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Major"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inDegree">
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Degree"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#locatedIn">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Location"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOutCome">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#OutCome"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasCreditPrerequisite">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#creditsAcquirable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#unitLevel">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Degree">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Major">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Unit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Location">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#OutCome">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>


</rdf:RDF>
