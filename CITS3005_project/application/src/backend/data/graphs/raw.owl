<owl:NamedIndividual rdf:about="#INDG3400">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Indigenous_Studies"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#LAWS2225"/>
  <uni.:hasPrerequisite rdf:resource="#INDG2300"/>
  <uni.:hasPrerequisite rdf:resource="#INDG2500"/>
  <uni.:hasPrerequisite rdf:resource="#INDG2700"/>
  <uni.:hasPrerequisite rdf:resource="#INDG2600"/>
  <uni.:hasPrerequisite rdf:resource="#INDG2400"/>
  <uni.:listedInMajor rdf:resource="#MJD-INKHH"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG3400</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous People and Global Issues</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit positions Australia's Indigenous people in a global context, highlighting areas of shared world views, knowledge, practices and experience with particular reference to the first nations of America. Students are introduced to the legal and social structures that have been set up to protect and share Indigenous cultural material both tangible and intangible.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG2300 Indigenous Knowledge: Mind, Body and Spirit or INDG2400 Looking South: Noongar Voices or INDG2500 Looking North: The Wild West or INDG2600 Indigenous Representation or INDG2700 Knowing Country: The Dreaming and Darwin or LAWS2225 Indigenous Peoples and the Law</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the differences and similarities between Indigenous people in America and Australia</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of relevant United Nations instruments that relate to Indigenous people</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research a substantial issue on Indigenous people and the global world and produce this research in writing.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the position Indigenous people occupy in a global world and the current pressures and issues they face</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial presentation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Rights</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Media and Communication</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Knowledge, History and Heritage</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#INDG3800">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Indigenous_Studies"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-INKHH"/>
  <uni.:hasContact rdf:resource="#INDG3800_contact_lecture_seminars_and"/>
  <uni.:hasContact rdf:resource="#INDG3800_contact_of_workshops_tutorials_up_to_9_weeks_May_also_be_intensively_taught_over_a_3_4_week_study_tour_or_in_house_study_program"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG3800</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Ways of Knowing 3 (Advanced)</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides Level 3 students with the opportunity to study, experience and relate to a range of complex &amp; advanced Indigenous knowledge topics that become available through the School of Indigenous Studies global Indigenous engagement programs. Studying in different locations alongside different host communities will provide first-hand opportunities to experience and investigate complex issues of local, national and global Indigenous rights, sustainable community development, environmental custodianship and cultural well being primarily from an Indigenous perspective.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">96 points of prior study and approval by the School of Indigenous Studies.</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">actively demonstrate advanced ethical ways of engaging ‘in-country' with different Indigenous peoples and their knowledges, values and belief systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate high quality advanced communication, citizenship and life-learning skills in both academic and community-based settings</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify further advanced initiatives for Indigenous study in their respective university learning programs, community service activities, or future professional practices..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop advanced skills to critically analyse representations of cultural heritage, making links to the knowledge of historical and contemporary contexts in a set of creative multi-media exercises and assessment items</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an advanced level of understanding and experience by way of appropriately immersing themselves in the day-to-day learning and cultural lifestyles of host Indigenous communities and their settings</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation and engagement assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">major report</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workshop presentation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Knowledge, History and Heritage</uni.:hasMajorTitle>
</owl:NamedIndividual>

