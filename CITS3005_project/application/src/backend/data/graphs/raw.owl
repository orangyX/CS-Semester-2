<owl:NamedIndividual rdf:about="#SSEH3552">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Human_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#SSEH2240"/>
  <uni.:listedInMajor rdf:resource="#MJD-SPTSC"/>
  <uni.:requiresDegree rdf:resource="#CM018"/>
  <uni.:requiresDegree rdf:resource="#CM017"/>
  <uni.:requiresDegree rdf:resource="#CM019"/>
  <uni.:hasContact rdf:resource="#SSEH3552_contact_week_labs_1hour_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SSEH3552</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coaching and Athlete Development</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on coaching, training programming, and athlete development, offering students a comprehensive understanding of the coach's role in maximising athlete potential. Through an integrated approach of sports science disciplines, students gain an understanding of coaching strategies of relevance for high performance settings. By analysing a variety of sports and scenarios, students will explore all aspects of coaching including key psychological aspects of athlete development, creating tailored training plans, and implementing skill acquisition strategies. Through an interdisciplinary approach, this unit equips students with the knowledge and skills needed to excel as coaches in competitive sports and other high-performance environments.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of SSEH2240 Motor Learning and Control or Enrolment in CM017 Bachelor of Sport and Exercise Sciences and Master of Public Health or CM018 Bachelor of Sport and Exercise Sciences and Master of Clinical Exercise Physiology or CM019 Bachelor of Sport and Exercise Sciences and Master of Applied Human Performance Science</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and distinguish aspects of personality and personal characteristics relevant to sport performance in elite environments</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss reactions to arousal, stress, and anxiety, and recommend strategies to optimise individual performance success</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate self-reflective and communication skills relevant to enhancing sport performance</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop the requisite knowledge and practical skills in applied skill acquisition and performance analysis techniques.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use knowledge of skilled performance and practice conditions to support performance outcomes</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of performance choking, resilience, mental toughness, and coaching approaches to promote adaptive psychological skills</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coaching report</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reflective essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sport Science, Exercise and Health</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sport Science</uni.:hasMajorTitle>
</owl:NamedIndividual>

