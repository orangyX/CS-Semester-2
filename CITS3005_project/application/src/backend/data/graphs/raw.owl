  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">labs per week</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:contactHours>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SSEH3366">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Human_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasContact rdf:resource="#SSEH3366_contact_lectures"/>
  <uni.:hasContact rdf:resource="#SSEH3366_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SSEH3366</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bioenergetics in Exercise, Nutrition and Energy Balance</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit aims to help students understand why more than one type of fuel is needed to support energy demands during exercise; how different energy systems are used during different types of exercise (e.g. marathon, sprint, resistance exercise); how muscles control the rate at which they burn their fuels during exercise; how at the cellular level, strength training increases muscle size, and how to optimise muscle growth; how the skeletal muscles and body adapt to endurance training; why some dietary regimes are better than others for optimal exercise performance; how muscles replenish their fuel stores after exercise even without food intake; how starvation and aging cause muscle atrophy and a fall in exercise performance; how fat stores communicate with the brain to control appetite and energy balance, and how imbalanced diets and low physical activity levels interfere with this communication to cause obesity; and why losing fat is so difficult to achieve for most overweight/obese people. Finally, this unit helps develop a critical attitude toward not only popular beliefs in general, but also the scientific literature.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of 48 points</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain at the cellular level how strength training increases muscle size and how to optimise muscle growth</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how fat stores communicate with the brain to control appetite and energy balance and how imbalanced diets and low physical activity level interfere with this communication to cause obesity</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how starvation and aging cause muscle atrophy and a fall in exercise performance</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how different energy stores are used during different types of physical activity</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">learn at the molecular level why losing fat is so difficult to achieve for most people</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop a critical attitude toward not only popular beliefs in general but also the scientific literature.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how skeletal muscles match their fuel use to their energy demands</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain why humans and other animal species rely on more than one type of fuel to support their energy demands during exercise</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe how skeletal muscles replenish their fuel stores after exercise even without food intake</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how skeletal muscles and body adapt to endurance training</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain why some dietary regimes are better than other for optimal exercise performance</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">end-of-semester examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mid-semester examination</uni.:hasAssessment>
</owl:NamedIndividual>

