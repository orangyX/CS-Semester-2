<owl:NamedIndividual rdf:about="#MJD-ITLNB">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:hasUnit rdf:resource="#ITAL3406"/>
  <uni.:hasUnit rdf:resource="#ITAL3816"/>
  <uni.:hasUnit rdf:resource="#ITAL1401"/>
