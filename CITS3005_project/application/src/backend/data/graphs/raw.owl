<owl:NamedIndividual rdf:about="#CHIN3408">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHIN3407"/>
  <uni.:hasPrerequisite rdf:resource="#CHIN3307"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHNSP"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHNSI"/>
  <uni.:hasContact rdf:resource="#CHIN3408_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN3408</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chinese 8</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit emphasises the application of students' language training to the study of Chinese sources reflecting contemporary Chinese culture and society. It deals with authentic materials regarding various current issues in China. Emphasis is also placed on building vocabulary used in the media (print, television and internet) and widening the understanding of research skills. Successful completion of this unit brings students to the ISLPR Level 4 (International Second Language Proficiency Ratings) or New HSK Level 5 (New Chinese Proficiency Test) or CEFR C1 (Common European Framework of Reference for Languages).</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN3407 Chinese 7 or CHIN3307 Chinese Specialist I</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire and refine generic skills such as communication skills—both written and oral</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of social and cultural issues of particular relevance to China</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">further develop linguistic and cultural competency, including the ability to read general news articles from print and electronic media</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse a social, cultural or political issue using authentic Chinese source materials</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enhance their effective communication skills, including the ability to read critically and to translate general academic and media language from Chinese to English</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHNSI Chinese Studies</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHNSP Chinese Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

