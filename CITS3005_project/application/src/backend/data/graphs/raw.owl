<owl:NamedIndividual rdf:about="#CLAN1201">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-CLANH"/>
  <uni.:hasContact rdf:resource="#CLAN1201_contact_per_week_over_12_weeks"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLAN1201</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Greek 1: An Introduction to Ancient Greek</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is an introduction to Ancient Greek for students who have never before studied this language or who have had minimal instruction in it, so there are no prerequisites. It introduces students to the changing forms of Greek words (their 'inflected morphology') and in so doing provides a grounding in basic grammar which is of fundamental benefit to English expression (as well as being of great utility for the acquisition of other modern European languages). Students will be taught via a combination of translation and grammar exercises. This unit is an ideal introduction to one of the most important ancient written languages, and is the gateway unit for the study of Greek literature, as well as for those students interested in Greek and Roman History, or historical linguistics.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">translate from Greek, without the aid of dictionaries, simple passages composed of a set vocabulary</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of elementary Greek sentence structure</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use correct grammatical terminology in the analysis of Greek words and sentences.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compose simple Greek sentences from a set vocabulary</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise and describe the forms and functions of a basic variety of Greek nouns, adjectives, pronouns and verbs</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial performance</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class test</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classics and Ancient History</uni.:hasMajorTitle>
</owl:NamedIndividual>

