    <rdf:type rdf:resource="http://example.com/made-in-abyss/Beast"/>
    <rdfs:label>Demonfish</rdfs:label>
    <mia:hasSpecies>Fish</mia:hasSpecies>
    <mia:livesIn rdf:resource="http://example.com/made-in-abyss/Layer_1"/>
    <mia:livesIn rdf:resource="http://example.com/made-in-abyss/Layer_2"/>
    <mia:livesIn rdf:resource="http://example.com/made-in-abyss/Layer_3"/>
    <mia:livesIn rdf:resource="http://example.com/made-in-abyss/Layer_4"/>
    <mia:hasDangerLevel rdf:resource="http://example.com/made-in-abyss/Unknown_Danger"/>
    <mia:hasDescription>Demonfish (ガンキマス, Gankimasu) are fish that can be found in abundance in the 1st through 4th layers of The Abyss.</mia:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/BlueWhistle">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/WhistleRank"/>
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Item"/>
    <rdfs:label>Blue Whistle</rdfs:label>
  </rdf:Description>
