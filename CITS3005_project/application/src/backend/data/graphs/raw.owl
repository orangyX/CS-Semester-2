  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Japanese 3A</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit functions as a bridging unit for students in the post-WACE Stage 2 major of Japanese (MJD-JPNSP), providing the foundation for further developing their linguistic and cultural competency. The unit emphasises the four language skills (listening, speaking, reading and writing) equally and increases learners' effective communication skills to meet routine practical and social demands that are relevant to students at tertiary level. It introduces compound sentence structure and the colloquial register; and covers practical functions such as requesting someone not to do something, offering advice, and describing comparisons. Successful completion of this unit brings students to a point between the International Second Language Proficiency Ratings (ISLPR) Levels 1 and 1+.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ATAR Japanese Year 11 or equivalent with approval of the unit coordinator</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be able to use 150 kanji appropriately</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">comprehend straightforward Japanese texts with the appropriate use of a dictionary and other resources</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">increase knowledge of Japanese cultural practices that are important for effective communication</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">engage in meaningful interactions with effective use of expressions in everyday social situations such as shopping, sightseeing, visiting a doctor, part-time jobs</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire information literacy and management skills through a variety of media and search techniques, including the use of a dictionary. Additionally, they will refine generic skills such as understanding self and others, understanding of language in general, and critical analysis through learning to express their ideas and performing assigned tasks in Japanese.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">write short compositions in Japanese on familiar topics</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JPNSP Japanese Studies</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is for post-secondary WACE 2 stream students.</uni.:hasNote>
</owl:NamedIndividual>

