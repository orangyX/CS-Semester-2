<owl:NamedIndividual rdf:about="#CLAN2001">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-CLANH"/>
  <uni.:hasContact rdf:resource="#CLAN2001_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLAN2001</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Golden Age of Athens</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the history and culture of Athens in the fifth century BCE. Students are introduced to the major cultural achievements of this period, ranging across literature (both prose and drama), architecture, scientific enquiry and philosophy, and are encouraged to understand these achievements within the broader political context of Athens—a context forged by the twin imperatives of radical democracy and empire. The unit focuses on the ancient sources, both material (for example, the archaeological remains) and literary (principally Thucydides, but also playwrights such as Aristophanes).</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any Level 1 CLAN unit</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate arguments about the key cultural and political achievements of fifth-century Athens, and present these arguments in written form and in discussion with their peers</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate acquaintance with a body of modern scholarship concerning fifth-century Athens.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate their understanding of the use of historical sources</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classics and Ancient History</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CLAN2001_contact_tutorials">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorials</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:contactHours>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CLAN2002">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-CLANH"/>
  <uni.:hasContact rdf:resource="#CLAN2002_contact_lectures"/>
  <uni.:hasContact rdf:resource="#CLAN2002_contact_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLAN2002</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power and Politics in the Roman Empire: 44 BC-AD 68</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Why do republics die? What factors lead to the creation of autocracies? How do autocrats maintain power? These questions are at the heart of CLAN2002. 44 BC to AD 68 was a period of dramatic change in the Mediterranean world. It was a period which saw dramatic constitutional changes in Rome, as it transitioned from an imperial Republic to a 'Republican Monarchy'. It was also a time of artistic and poetic development, as artists sought a new language by which to talk about contemporary culture. The unit offers a carefully structured program of lectures and tutorials that identify and trace the development of the major political, social and cultural aspects of the Triumviral, Augustan, and (to a lesser extent) Julio-Claudian periods. The unit emphasises the collection, analysis and criticism of the ancient source material (literary as well as material) through written in-class tests and tutorial discussion. The unit aims to encourage students to develop critical abilities in the process of exploring and evaluating particular events and personalities throughout this period.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any level 1 6 points Unit(s) MJD-CLANH Classics and Ancient History</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse the iconography of material remains from the Roman World</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse the main ancient writers of the period</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify, describe and analyse the major political, social and cultural developments of the period</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skilfully research using print and electronic resource.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
