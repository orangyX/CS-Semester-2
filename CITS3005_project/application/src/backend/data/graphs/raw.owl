<owl:NamedIndividual rdf:about="#MUSC2277">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2274"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2273"/>
  <uni.:listedInMajor rdf:resource="#MJD-MEMSD"/>
  <uni.:hasContact rdf:resource="#MUSC2277_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2277</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Music: Interactive Systems</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces concepts and techniques of live and interactive technologies for live electronic music, sound installation and game audio. Topics include interactivity, inter-device and network communication protocols, instrument building, sensors and micro-controllers, and game audio design. Applications of interactivity are explored through creative work, problem solving tasks and programming exercises. The unit concludes with a final project-the design and programming of one or more interactive musical devices or systems.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MUSC2273 Electronic Music: Generative Processes or MUSC2274 Electronic Music: Sampling and Synthesis</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design custom software for complex interactivity with midi controllers and other external devices</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transform data from complex midi controllers</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop skills with programming environments for game audio design</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program custom software for complex interactivity with midi controllers and other external devices</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coherently and logically communicate creative/technical ideas and goals regarding musical interactivity in both written and verbal formats.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">combine sound synthesis, sampling and programming to create effective interactive music systems</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project 1</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project 2</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">presentation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music: Electronic Music and Sound Design</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</uni.:hasMajorTitle>
</owl:NamedIndividual>

