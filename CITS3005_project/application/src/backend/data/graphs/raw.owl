<owl:NamedIndividual rdf:about="#AUTO4507">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CITX1401"/>
  <uni.:hasPrerequisite rdf:resource="#CITX1001"/>
  <uni.:hasPrerequisite rdf:resource="#CITS1401"/>
  <uni.:hasPrerequisite rdf:resource="#CITS2401"/>
  <uni.:hasPrerequisite rdf:resource="#CITS1001"/>
  <uni.:hasAdvisedUnit rdf:resource="#ELEC3020"/>
  <uni.:hasContact rdf:resource="#AUTO4507_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AUTO4507</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Robot Manipulators and Automation</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with specialist knowledge and skills for the design and planning of industrial production, automation processes and the use of robot manipulators. Different techniques and methods are covered, including industrial communication protocols, reliability and safety modelling, sensor and actuator selection and control, and redundancy measures. Control and programming of common robot manipulators is a central part of this unit. Students will learn the theory of manipulators and automation systems and gain practical industrial robot skills from simulation and real robot and automation equipment. The unit further covers industrial application areas, pick-and-place, serial and parallel manipulator types, forward and inverse kinematics, motion equations, homogeneous coordinates and manipulator / automation programming</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and Successful completion of 96 points and ( CITS1001 Software Engineering with Java or CITX1001 Software Engineering with Java or CITS1401 Computational Thinking with Python or CITX1401 Computational Thinking with Python or CITS2401 Computer Analysis and Visualisation )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design an automation system with robot manipulators to satisfy given operating requirements</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the theory, applications and limitations of industry-standard automation and robot manipulator techniques and methods</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deploy, test, debug and optimize a robot manipulator solution on a real robot.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop efficient code and algorithms for robot manipulation and automation systems</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratories</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mid-semester examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project</uni.:hasAssessment>
</owl:NamedIndividual>

