<owl:NamedIndividual rdf:about="#ECON3371">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ECON2271"/>
  <uni.:hasContact rdf:resource="#ECON3371_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON3371</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Econometric Methods and Data Analysis</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is about the application of econometric methods across a range of economics fields using a practical, hands-on approach. Students learn how to analyse data across different economic fields such as finance, public economics, health, and economic growth. Additionally, it offers the opportunity to develop programming skills.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON2271 Introductory Econometrics</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop computational skills to analyse economic data</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of a range of statistical tools required to undertake applied economic research</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically evaluate empirical economic research.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exams/tests</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial Economics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Economics</uni.:hasMajorTitle>
</owl:NamedIndividual>

