  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1341 Principal Studies 1 or MUSC1741 Practical Studies A or MUSC1345 Keyboard and Performance Technologies 1</uni.:hasPrerequisiteText>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
