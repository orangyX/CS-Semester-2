<owl:NamedIndividual rdf:about="#GENG2003">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1011"/>
  <uni.:hasPrerequisite rdf:resource="#PHYS1001"/>
  <uni.:hasPrerequisite rdf:resource="#PHYX1001"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1011"/>
  <uni.:requiresDegree rdf:resource="#62560"/>
  <uni.:requiresDegree rdf:resource="#62570"/>
  <uni.:hasContact rdf:resource="#GENG2003_contact_practical_classes"/>
  <uni.:hasContact rdf:resource="#GENG2003_contact_labs"/>
  <uni.:hasContact rdf:resource="#GENG2003_contact_lectures_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG2003</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluid Mechanics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the principles of conservation and momentum transfer in the flow of fluids. Topics discussed include the fundamental properties of fluids, hydrostatics, the general equations of fluid motion, dimensional analysis, fluid friction, pumps, pipe systems, flow in porous media and compressible flow.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62560 Master of Renewable and Future Energy or Enrolment in 62570 Master of Offshore and Coastal Engineering or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of ( ( MATH1011 Multivariable Calculus and PHYS1001 Physics for Scientists and Engineers or MATX1011 Multivariable Calculus and PHYX1001 Physics for Scientists and Engineers ) )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understanding and applying the macroscale mass, momentum and energy balances for incompressible and compressible fluid flows</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understanding the fundamental properties of fluids and their variations with changing state</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analysis and basic design of pump and pipework systems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understanding the characteristics and analysis of laminar and turbulent flows</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deriving and applying the Navier-Stokes equations to develop and solve differential equations describing simple laminar flows and pressure fields in static fluids.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">developing and applying dimensional analyses to characterise complex flow phenomena</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports and in-class quizzes</uni.:hasAssessment>
</owl:NamedIndividual>

