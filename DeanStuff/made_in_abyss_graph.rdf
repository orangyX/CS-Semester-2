    <rdfs:label>Burial Tower</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Layer_1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Remayo">
