<owl:NamedIndividual rdf:about="#AUTO4508">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CITX1401"/>
  <uni.:hasPrerequisite rdf:resource="#CITX1001"/>
  <uni.:hasPrerequisite rdf:resource="#CITS1401"/>
  <uni.:hasPrerequisite rdf:resource="#CITS2401"/>
  <uni.:hasPrerequisite rdf:resource="#CITS1001"/>
  <uni.:requiresDegree rdf:resource="#62510"/>
  <uni.:requiresDegree rdf:resource="#62550"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AUTO4508</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mobile Robots</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit gives an overview of mobile robot systems, technologies and algorithms. It covers various types of mobile robots, including driving robots, walking and balancing robots, unmanned aerial vehicles, autonomous underwater vehicles and autonomous boats. The units builds a theoretical background on robot kinematics, localisation, mapping and navigation and transforms this into working robot algorithms during practical labs. The unit concludes with the topics robot vision, artificial intelligence and driverless vehicles.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering or Enrolment in 62510 Master of Information Technology and Successful completion of CITS1401 Computational Thinking with Python or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of ( 96 points and ( CITS1001 Software Engineering with Java or CITX1001 Software Engineering with Java or CITS1401 Computational Thinking with Python or CITX1401 Computational Thinking with Python or CITS2401 Computer Analysis and Visualisation ) )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate research capabilities through applying foundation knowledge to practical robotics applications</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use a robot simulation system and a physical robot safely, effectively and efficiently.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply specific AI methods when appropriate</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss the history and evolution of applications of robotics systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop code for robot-specific algorithms</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate procedural programming skills</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mid semester test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratories</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project</uni.:hasAssessment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ELEC5506">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GENG3402"/>
  <uni.:requiresDegree rdf:resource="#62550"/>
  <uni.:hasAdvisedUnit rdf:resource="#GENG3402"/>
  <uni.:hasAdvisedUnit rdf:resource="#GENG4402"/>
  <uni.:hasAdvisedUnit rdf:resource="#ENSC2003"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELEC5506</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process Instrumentation and Control</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The topics covered in this unit include measurement principles of various sensors (e.g. flow, temperature, pressure, level and optical sensors), signal conditioning circuits, ISA standards, applications of programmable logic controllers (PLCs), PLC programming, actuators, valves, final control elements and industrial control systems and loop tuning procedures. The academic objectives of the unit are to (1) understand the measurement principles of various sensors used in an industrial setting; (2) familiarise with ISA standards and to prepare technical drawings; (3) design electronic circuitry for measurement systems; (4) design process systems under economic and safety constraints(5) program PLCs and (6) design loop tuning procedures in industrial control systems</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Electrical &amp; Electronic specialisation) or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and Successful completion of ( 120 points and GENG3402 Control Engineering )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate professional engineering skills and abilities when working in teams</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design industrial control systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate awareness of hazards and analyse risk in relation to economic and safety considerations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate the importance of following international technical standards in relation to accurate technical communication and safety</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">write ladder logic programs for PLCs.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse various measurement principles</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design signal conditioning circuits for process instrumentation and control</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GENG4402">
  <rdf:type rdf:resource="http://uwa/uni.ot#FloatingUnit"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG4402</uni.:hasCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GENG4411">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GENG3000"/>
  <uni.:listedInMajor rdf:resource="#MJD-EBMEG"/>
  <uni.:listedInMajor rdf:resource="#MJD-EELEC"/>
  <uni.:listedInMajor rdf:resource="#MJD-ESOFT"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECIVL"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECHEM"/>
  <uni.:listedInMajor rdf:resource="#MJD-EENVE"/>
  <uni.:listedInMajor rdf:resource="#MJD-EMINE"/>
  <uni.:listedInMajor rdf:resource="#MJD-EAUTO"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG4411</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering Research Project Part 1</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is part of a 12-pt research project. Parts 1 and 2 must be taken over two successive semesters and both parts must be completed to fulfil the requirements of the project. Students can commence the project in either semester 1 or semester 2. The academic objectives of the project are to improve students' understanding of the research process and to develop their capability to conduct independent research. Students learn about recent advances and gain in-depth technical competence in at least one specialist area of their discipline, apply the basic elements of research design to investigate a theory or hypothesis, and appreciate how research skills support lifelong learning. Students are required to communicate their findings to technical audiences using a range of media. They are also exposed to the University's research culture and opportunities to pursue further study. Students may choose a project from a list of advertised topics, negotiate a topic with an academic supervisor, or apply for an industry Co-operative Education for Enterprise Development (CEED) project.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and Successful completion of 144 points including 24 points of Level 3 units and GENG3000 Engineering Practice 3</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate a framework to answer a research question or meet project aims</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate clearly, effectively and appropriately in written, oral and visual formats</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">manage a project in a professional manner to meet outcomes and deadlines</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate initiative.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an engineering research question or project aim</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate relevant literature and other sources of information</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">follow appropriate methodology to test a research hypothesis or theory or solve an engineering problem</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate results to draw meaningful conclusions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply appropriate technical tools</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written progress reports</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral presentation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written project proposal</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written final report</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Automation and Robotics Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mining Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Civil Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Software Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electrical and Electronic Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

