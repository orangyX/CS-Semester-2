    <mia:hasStatus>Deceased</mia:hasStatus>
    <mia:hasOccupation>Companion</mia:hasOccupation>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Sun_Sphere">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Artifact"/>
    <rdfs:label>Sun Sphere</rdfs:label>
    <mia:hasDescription>An egg-shaped Artifact with a round structure in its centre and encasements covering its glass-like exterior.</mia:hasDescription>
    <mia:hasEffect>Light emission</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Ozen"/>
    <mia:hasGrade rdf:resource="http://example.com/made-in-abyss/Fourth_Grade"/>
    <mia:sourcedFrom rdf:resource="http://example.com/made-in-abyss/Layer_2"/>
    <mia:sourcedFrom rdf:resource="http://example.com/made-in-abyss/Layer_3"/>
    <mia:sourcedFrom rdf:resource="http://example.com/made-in-abyss/Layer_4"/>
    <mia:sourcedFrom rdf:resource="http://example.com/made-in-abyss/Layer_5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Riko">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Human"/>
    <rdfs:label>Riko</rdfs:label>
    <mia:lastKnownLocation rdf:resource="http://example.com/made-in-abyss/Layer_7"/>
    <mia:hasGender>Female</mia:hasGender>
    <mia:hasSpecies>Human</mia:hasSpecies>
