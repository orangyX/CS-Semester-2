<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://uwa/uni.rules"
         xmlns="http://uwa/uni.rules#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://uwa/uni.rules">
  <owl:imports rdf:resource="http://uwa/uni.ot"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#offersUnit">
  <rdfs:domain rdf:resource="http://uwa/uni.ot#Degree"/>
  <rdfs:range rdf:resource="http://uwa/uni.ot#Unit"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://uwa/uni.ot#hasMajor"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://uwa/uni.ot#hasUnit"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dependsOnUnit">
  <rdfs:domain rdf:resource="http://uwa/uni.ot#Major"/>
  <rdfs:range rdf:resource="http://uwa/uni.ot#Unit"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://uwa/uni.ot#hasUnit"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://uwa/uni.ot#hasPrerequisite"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:Class rdf:about="#BachelorOfPhilosophy">
  <rdfs:subClassOf rdf:resource="http://uwa/uni.ot#Degree"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://uwa/uni.ot#Degree"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://uwa/uni.ot#hasTitle"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bachelor of Philosophy (Honours)</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FirstYearUnit">
  <rdfs:subClassOf rdf:resource="http://uwa/uni.ot#Unit"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://uwa/uni.ot#Unit"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://uwa/uni.ot#hasLevel"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#SecondYearUnit">
  <rdfs:subClassOf rdf:resource="http://uwa/uni.ot#Unit"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://uwa/uni.ot#Unit"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://uwa/uni.ot#hasLevel"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ThirdYearUnit">
  <rdfs:subClassOf rdf:resource="http://uwa/uni.ot#Unit"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://uwa/uni.ot#Unit"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://uwa/uni.ot#hasLevel"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#PostgradUnit">
  <rdfs:subClassOf rdf:resource="http://uwa/uni.ot#Unit"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://uwa/uni.ot#Unit"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://uwa/uni.ot#hasLevel"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<rdf:Description rdf:about="http://uwa/uni.ot#Degree">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://uwa/uni.ot#hasMajor"/>
      <owl:someValuesFrom rdf:resource="http://uwa/uni.ot#Major"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</rdf:Description>

<rdf:Description rdf:about="http://uwa/uni.ot#hasMajor">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://uwa/uni.ot#includesDegree"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://uwa/uni.ot#hasMajor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</rdf:Description>

<swrl:Variable rdf:about="urn:swrl#d"/>

<swrl:Variable rdf:about="urn:swrl#m"/>

<swrl:Variable rdf:about="urn:swrl#t"/>

<swrl:Variable rdf:about="urn:swrl#p"/>

<swrl:Variable rdf:about="urn:swrl#u"/>

<swrl:Variable rdf:about="urn:swrl#o"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="http://uwa/uni.ot#hasUnit"/>
          <swrl:argument1 rdf:resource="urn:swrl#m"/>
          <swrl:argument2 rdf:resource="urn:swrl#u"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://uwa/uni.ot#hasOutcome"/>
              <swrl:argument1 rdf:resource="urn:swrl#u"/>
              <swrl:argument2 rdf:resource="urn:swrl#o"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:DatavaluedPropertyAtom>
          <swrl:propertyPredicate rdf:resource="http://uwa/uni.ot#hasOutcome"/>
          <swrl:argument1 rdf:resource="urn:swrl#m"/>
          <swrl:argument2 rdf:resource="urn:swrl#o"/>
        </swrl:DatavaluedPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="http://uwa/uni.ot#hasMajor"/>
          <swrl:argument1 rdf:resource="urn:swrl#d"/>
          <swrl:argument2 rdf:resource="urn:swrl#m"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="http://uwa/uni.ot#hasStudyType"/>
              <swrl:argument1 rdf:resource="urn:swrl#d"/>
              <swrl:argument2 rdf:resource="urn:swrl#t"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:ClassAtom>
                  <swrl:classPredicate rdf:resource="http://uwa/uni.ot#Bachelor"/>
                  <swrl:argument1 rdf:resource="urn:swrl#t"/>
                </swrl:ClassAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://uwa/uni.ot#hasTitle"/>
                      <swrl:argument1 rdf:resource="urn:swrl#p"/>
                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bachelor of Philosophy (Honours)</swrl:argument2>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="http://uwa/uni.ot#hasMajor"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
          <swrl:argument2 rdf:resource="urn:swrl#m"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>


</rdf:RDF>
