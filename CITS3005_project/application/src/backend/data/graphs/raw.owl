<owl:NamedIndividual rdf:about="#GENG2012">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CITS2401"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1012"/>
  <uni.:hasPrerequisite rdf:resource="#CITS1401"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1012"/>
  <uni.:requiresDegree rdf:resource="#62570"/>
  <uni.:hasContact rdf:resource="#GENG2012_contact_lectures"/>
  <uni.:hasContact rdf:resource="#GENG2012_contact_practical_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG2012</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Collection and Analysis</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit helps students develop an understanding of how to collect and analyse data to characterise natural systems. Students are introduced to each step of the investigative process, starting from asking a scientific and sound question, developing a sampling strategy, collecting the data, analysing the data, testing the hypothesis and eventually drawing one or more conclusions.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of ( ( MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods and CITS1401 Computational Thinking with Python or CITS2401 Computer Analysis and Visualisation ) or Enrolment in 62570 Master of Offshore and Coastal Engineering</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantitatively describe the strength of a relationship between two variables measured in the field</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appreciate why statistical analysis is crucial in the study of natural systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work closely with a team of peers to arrive at a superior engineering solution</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clearly and concisely communicate the results of a project in oral and written forms.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret temporal signals in data to aid understanding of forcing processes</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use statistics to determine if signals observed in the field are significant</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mid-semester test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group projects</uni.:hasAssessment>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolled students can access unit material via the LMS (Learning Management System).</uni.:hasNote>
</owl:NamedIndividual>

