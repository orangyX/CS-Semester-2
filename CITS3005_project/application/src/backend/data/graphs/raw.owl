<owl:NamedIndividual rdf:about="#MATH3034">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MATH2030"/>
  <uni.:hasPrerequisite rdf:resource="#MATH2501"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1013"/>
  <uni.:hasPrerequisite rdf:resource="#MATH2031"/>
  <uni.:listedInMajor rdf:resource="#MJD-MATHS"/>
  <uni.:hasAdvisedUnit rdf:resource="#MATH2030"/>
  <uni.:hasContact rdf:resource="#MATH3034_contact_lectures"/>
  <uni.:hasContact rdf:resource="#MATH3034_contact_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH3034</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional Analysis</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unit provides students with a foundation in functional analysis, with emphasis on the Hahn-Banach theorem, the uniform boundedness principle, the closed graph theorem, weak topologies, functional spaces, compactness in functional spaces and linear operators.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1013 Mathematical Analysis or MATH2031 Introduction to Pure Mathematics or MATH2030 Metric Spaces &amp; Measure Theory or MATH2501 Advanced Mathematical Methods</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">define and utilise functional spaces and exploit the notion of compactness.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the difference between weak and strong topologies</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and exploit the notions of extension of linear functionals and separation of convex sets</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exam</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics</uni.:hasMajorTitle>
</owl:NamedIndividual>

