<owl:NamedIndividual rdf:about="#MJD-ZOOLY">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_Biological_Sciences"/>
  <uni.:hasUnit rdf:resource="#ANIM3363"/>
  <uni.:hasUnit rdf:resource="#ENVT2250"/>
  <uni.:hasUnit rdf:resource="#ANIM2220"/>
