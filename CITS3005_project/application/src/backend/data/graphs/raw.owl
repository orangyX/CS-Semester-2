<owl:NamedIndividual rdf:about="#CHPR2006">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1011"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1011"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM1001"/>
  <uni.:hasPrerequisite rdf:resource="#CHPR1005"/>
  <uni.:hasPrerequisite rdf:resource="#CHEX1001"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECHEM"/>
  <uni.:hasAdvisedUnit rdf:resource="#CHEM1002"/>
  <uni.:hasContact rdf:resource="#CHPR2006_contact_workshop_lecture_classes"/>
  <uni.:hasContact rdf:resource="#CHPR2006_contact_tutorial_and_lab_experiences"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR2006</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering Thermodynamics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides the foundational thermodynamic knowledge needed for advanced units in the Chemical Engineering major. It covers the following key content—first and second laws of thermodynamics, thermodynamic cycles, ideal gasses, equations of state of real gases; fundamental thermodynamic relations; determination of change in thermodynamic properties, criteria for phase and chemical equilibria; partial molar quantities, fugacity, phase equilibria and phase diagrams in multi-component systems; and chemical reaction equilibria.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of ( ( CHEM1001 Chemistry—Properties and Energetics or CHEX1001 Chemistry—Properties and Energetics and CHPR1005 Mass and Energy Balances and MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus ) )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify how thermodynamic cycles can be used for production of work from energy and their use as a basis for refrigeration systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use equations of state for real gases to obtain relevant thermodynamic state properties</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">determine rates and extents of chemical reactions based on thermodynamic properties.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply phase equilibrium analyses to calculate how species distribute among phases that are coexisting</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate measured, fundamental and derived thermodynamic properties to construct hypothetical paths to calculate the change in a desired thermodynamic property between two states</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">determine the thermodynamic properties of species in mixtures and the criteria that govern the phase equilibrium and chemical reaction equilibrium</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">test</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

