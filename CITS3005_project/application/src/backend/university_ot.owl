</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BP002">
  <rdf:type rdf:resource="#Degree"/>
  <degreeSchool rdf:resource="#Office of the Deputy Vice-Chancellor Education"/>
  <degreeLocation rdf:resource="#location3"/>
  <degreeStudyType rdf:resource="#Bachelor's course"/>
