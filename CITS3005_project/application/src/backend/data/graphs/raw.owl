<owl:NamedIndividual rdf:about="#GRMN1404">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GRMN1403"/>
  <uni.:listedInMajor rdf:resource="#MJD-GRMNI"/>
  <uni.:hasContact rdf:resource="#GRMN1404_contact_seminar"/>
  <uni.:hasContact rdf:resource="#GRMN1404_contact_language_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN1404</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">German Studies 4</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is intended for students who have completed GRMN1403 German Studies 3. The unit consolidates and improves the language ability of learners of German at an intermediate level and further develops cultural and linguistic awareness. In addition, students develop a better understanding of how languages work in general (both in the target language and in English). The seminar uses the discussion and analysis of German cultural productions such as film, literature and music as the basis for language acquisition, focusing on a range of sociopolitical themes and their connections to wider cultural phenomena. This is where students have the opportunity to develop their listening comprehension, reading and communication skills. The language class reinforces and deepens the knowledge of contemporary German language usage and grammatical structures. Students gain an increased level of competency in all four macro skills—listening to, speaking, reading and writing German—corresponding to Levels A2/B1 of the Common European Framework of Reference for Languages (Gemeinsamer Europaischer Referenzrahmen). Students also develop an increased awareness of intercultural understanding and language learning, as well as research skills and communication strategies.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN1403 German Studies 3 or equivalent , with the consent of the convener</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to Levels A2/B1 of the Common European Framework of Reference for Languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased awareness of intercultural understanding and language learning, as well as research skills and communication strategies.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral tasks</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests and quizzes</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMNI German Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GRMN1402">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GRMN1401"/>
  <uni.:listedInMajor rdf:resource="#MJD-GRMNB"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN1402</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">German Beginners 2</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from GRMN1401 German Beginners 1. It builds on the introduction to German grammar and vocabulary, further developing students' ability to communicate orally and in writing in everyday situations. It focuses on contemporary spoken and written language used in German-speaking countries and uses authentic texts and audiovisual materials to deepen students' understanding of German culture and society. Students achieve language proficiency equivalent to Level A1/A2 of the Common European Framework of Reference for Languages (Gemeinsamer Europaischer Referenzrahmen). The unit leads to GRMN2403 German Studies 3. In Level 2 and 3 German units, you will have the opportunity to not only increase language competency but to further engage with German history and culture (including literature, film, music and science) and to take advantage of a range of exchange possibilities, including our short-term Stuttgart Winter University program.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN1401 German Beginners 1 or equivalent , with the consent of the convener</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">further develop independent learning skills and interpersonal skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be familiar with a broader range of sociolinguistic conventions in German</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">further develop elementary skills in reading, writing, listening and speaking in the German language</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have an increased knowledge of culture and society in German-speaking countries</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have a deeper awareness of language and language use in both German and in English.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Summer teaching period</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral tasks</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">short tests</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMNB German Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

