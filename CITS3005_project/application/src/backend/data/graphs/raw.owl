<owl:NamedIndividual rdf:about="#FINA3333">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#FINA3324"/>
  <uni.:hasPrerequisite rdf:resource="#FINA2207"/>
  <uni.:listedInMajor rdf:resource="#MJD-FINCE"/>
  <uni.:hasContact rdf:resource="#FINA3333_contact_combination_of_lectures_and_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA3333</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Student Managed Enterprise Investment Fund</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an applied unit that challenges high performing students. It enables students to apply academic knowledge and acquire practical skills in the context of evaluating investments, monitoring risk, and making investment decisions. Student teams will provide investment recommendations that will be scrutinised by industry practitioners, and the fund will invest in the most compelling cases. The unit is designed to equip students with the necessary competencies (including investment analysis, risk management, report writing, and presentation skills) to be work-ready for the financial services sector. There is an emphasis on team-based, experiential learning and interaction with industry professionals.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of Unit(s) FINA3324 Investment Analysis and Unit(s) FINA2207 Business Analysis and Valuation and current WAM of 70 or higher and approval by Unit Coordinator</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examine performance and risk exposure of investments</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse economic and financial data in order to establish an investment strategy</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss and peer-evaluate investment recommendations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use relevant financial market databases and IT tools.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group assignment</uni.:hasAssessment>
