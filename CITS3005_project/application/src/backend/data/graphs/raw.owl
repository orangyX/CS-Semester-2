  <rdf:type rdf:resource="http://uwa/uni.ot#Degree"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GENG2004_contact_practical_classes">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">practical classes</uni.:contactType>
