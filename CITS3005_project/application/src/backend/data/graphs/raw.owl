<owl:NamedIndividual rdf:about="#IREL1001">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-POLSC"/>
  <uni.:hasContact rdf:resource="#IREL1001_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IREL1001</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The International Politics of Climate Change</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the international politics of climate change. The unit first looks briefly at theories of environmental politics, using concepts from international relations and environmental politics, to introduce students to debates on how we should think about the planet and its politics. It then looks at key actors that participate in climate politics, including states, intergovernmental organisations, transnational corporations and social movements, and how these actors clash to produce political and environmental outcomes. Its case studies include the United Nations process for dealing with climate change, and key environmental regions such as the Himalayan watershed, the Arctic and Antarctic, and the Amazon rainforest. The unit also takes students through key contemporary issues such as borders and frontiers in the contemporary world, and the positive and negative impact of technology on the climate. Students are introduced to the politics of climate change, why it is so hard to deal with, and begin to think through what political solutions to environmental problems might look like.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a basic understanding of the concepts, theoretical frameworks and approaches required to understand international politics as it relates to climate change</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the types of actors that participate in international climate politics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conduct research and analyse evidence from a range of relevant sources, to construct a logical and persuasive argument</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand, explain and engage with the key international political issues that relate to climate change</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop skills to undertake group projects and tasks, to work collaboratively to examine environmental issues..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a basic understanding of how the interaction between these actors produces environmental outcomes.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tutorial activities</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Political Science and International Relations</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social and Environmental Sustainability</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Relations</uni.:hasMajorTitle>
</owl:NamedIndividual>

