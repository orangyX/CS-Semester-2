<owl:NamedIndividual rdf:about="#PHYS4022">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#PHYS4021"/>
  <uni.:hasPrerequisite rdf:resource="#PHYS3005"/>
  <uni.:requiresDegree rdf:resource="#CM015"/>
  <uni.:requiresDegree rdf:resource="#53560"/>
  <uni.:requiresDegree rdf:resource="#65550"/>
  <uni.:requiresDegree rdf:resource="#BH008"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS4022</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Quantum Computing</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers advanced topics in quantum information, computation and communication, such as quantum algorithm design and analysis, efficient quantum computation principles, quantum universality, computability and complexity, quantum simulation, quantum optimisation, quantum machine learning, quantum walks, as well as quantum communication protocols. It aims to provide students with the essential knowledge and skill set to work in the fast-evolving field of quantum computing.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 53560 Master of Physics or 65550 Master of Quantum Technology and Computing or CM015 Bachelor of Science Frontier Physics and Master of Physics or HON-PHYSC Physics or BH008 Bachelor of Advanced Computer Science [Honours] or HON-MATHS Mathematics or HON-MATHH Mathematics or HON-STATS Statistics or HON-STATH Statistics and PHYS3005 Quantum Computation or PHYS4021 Frontiers in Quantum Computation</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the design principles of efficient quantum algorithms</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perform general quantum algorithm analysis</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate effectively through scientific writing and group discussions.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">investigate environmental effects on the quantum computing process</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate quantum algorithm efficiency and complexity</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project</uni.:hasAssessment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ELEC1303">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-ESOFT"/>
  <uni.:listedInMajor rdf:resource="#MJD-EAUTO"/>
  <uni.:listedInMajor rdf:resource="#MJD-EELEC"/>
  <uni.:hasContact rdf:resource="#ELEC1303_contact_Lectures"/>
  <uni.:hasContact rdf:resource="#ELEC1303_contact_Practical_Classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELEC1303</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Digital Systems</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the fundamental concepts underpinning the design and analysis of modern digital systems. Topics covered include: design process abstractions and realisation technologies; Boolean Algebra, combinational logic, minimisation, NAND/NOR implementations, multi-level gate networks, standard combinational components and programmable logic devices; sequential logic, latches, flip-flops, registers, counters, finite-state machines; analysis, synthesis and optimization of clocked sequential circuits; timing diagrams, hazards, maximum frequency of operation, metastability; microprocessor based systems, instruction sets, and assembly programming.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse, optimize, and construct combinational and sequential logic circuits</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work effectively as part of a team and communicate results in a concise technical report.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain digital encoding and processing of information and discuss the associated benefits and limitations of digital design process abstractions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">select the appropriate modern realization technologies and synthesis techniques for the implementation of a given digital system</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse, explain and write small assembly programs</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the architecture and operation of a microprocessor based system</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">class tests/quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">labs</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electrical and Electronic Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Automation and Robotics Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Software Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

