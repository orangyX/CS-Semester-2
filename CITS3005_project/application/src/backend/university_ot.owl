  <degreeHasMajor rdf:resource="#MJD-BSLAW"/>
  <degreeHasMajor rdf:resource="#MJD-ECNSM"/>
  <degreeHasMajor rdf:resource="#MJD-FINCE"/>
  <degreeHasMajor rdf:resource="#MJD-HRSMT"/>
  <degreeHasMajor rdf:resource="#MJD-MGMNT"/>
  <degreeHasMajor rdf:resource="#MJD-MRKTG"/>
  <degreeHasMajor rdf:resource="#MJD-BUSAN"/>
  <degreeCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BP002</degreeCode>
  <degreeTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bachelor of Commerce</degreeTitle>
  <degreeCreditsToComplete rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">144</degreeCreditsToComplete>
  <degreeFullTimeDuration rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</degreeFullTimeDuration>
