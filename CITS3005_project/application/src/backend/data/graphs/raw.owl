<owl:NamedIndividual rdf:about="#MJD-DATSC">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:hasUnit rdf:resource="#PHIL1001"/>
