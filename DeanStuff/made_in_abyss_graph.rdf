    <mia:hasDescription>A large grey bell discovered in an inaccessible location in the 4th Layer.</mia:hasDescription>
    <mia:hasEffect>Time stop</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Orth"/>
    <mia:hasGrade rdf:resource="http://example.com/made-in-abyss/Special_Grade"/>
    <mia:sourcedFrom rdf:resource="http://example.com/made-in-abyss/Layer_4"/>
  </rdf:Description>
