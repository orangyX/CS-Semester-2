  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2751</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre Performance Skills 3</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit builds on MUSC1752 Music Theatre Performance Skills 2 and extends musicianship, technical skills, and repertoire in music theatre performance. The emphasis is upon further development and improvement of singing technique and performance skills (in singing, dancing, and acting) and performing more diverse repertoire. This unit prepares students for the next unit in the sequence, MUSC3752 Music Theatre Performance Skills 4.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in MJD-MUSMT Music Theatre and MUSC2751 Music Theatre Performance Skills 2 and any three level 1 6 points Discipline(s)</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply developing skills in singing, acting, and dancing to music theatre performance</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate proficiency in singing technique in a music theatre style</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate active and continuous reflection of skills development in singing, acting and dancing..</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
