<owl:NamedIndividual rdf:about="#CHPR3406">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:requiresDegree rdf:resource="#62520"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR3406</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reaction Engineering</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to basic chemical reaction theory. The unit covers reaction kinetics, mechanisms and rate equations. Fundamentals of ideal reactor behaviour; designs of batch, mixed and plug flow reactors, multiple and recycle reactors and non-isothermal reactor design for reversible and irreversible first order reactions. The concept of residence time distribution (RTD) is introduced with RTD modelling of non-ideal reactor behaviour. General reactor safety is discussed with a focus on runaway reactions.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of CHPR2006 Chemical Engineering Thermodynamics or Enrolment in 62520 Master of Low Emission Energy Technologies</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the implications and mitigate runaway reactions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of conversion and non-ideal behaviour of flow reactors to interpret results of laboratory experiments</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse non-ideal flow reactors</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply an understanding of selection, design and size optimisation methods to single or multiple flow reactors for a range of reaction kinetics under isothermal and non-isothermal conditions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate critical thinking and information literacy through clearly and concise technical reports.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solve problems involving heterogeneous diffusion-control reactions</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments and laboratories</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests</uni.:hasAssessment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CHPR3407">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GENG2003"/>
  <uni.:hasPrerequisite rdf:resource="#MECH3024"/>
  <uni.:hasPrerequisite rdf:resource="#CHPR2007"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECHEM"/>
  <uni.:hasContact rdf:resource="#CHPR3407_contact_Workshop"/>
  <uni.:hasContact rdf:resource="#CHPR3407_contact_Lectures"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR3407</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transport Phenomena</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Students completing this unit demonstrate competence in computational fluid dynamics (CFD) analysis, the ability to understand practical issues of multiphase fluid transport, the ability to estimate the dispersion of species in gas and liquids, and knowledge of emulsion and suspension viscosities. This experience provides students with experience for working in the oil, gas and renewable energy sectors. Topics covered include turbulent flow and its analysis; introduction to CFD; non-Newtonian flow and fluids; suspensions and emulsions; multiphase flow in pipes; mixing and dispersion; and contaminant transport in turbulent flows.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of GENG2003 Fluid Mechanics and ( CHPR2007 Heat and Mass Transfer or MECH3024 Engineering Thermodynamics )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the general transport equations to diffusive transport, advective transport, and combined diffusive and advective transport</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">select and validate appropriate turbulence models and boundary conditions for a finite volume CFD Model</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use Reynolds Average Navier Stokes Equations and Turbulence Closure Models</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perform fundamental calculations for Multiphase flows.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesh, execute and interpret CFD Models using a commercial CFD package</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CFD Practical Exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weekly Fluent exercise</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MECH3024">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CITS2401"/>
  <uni.:hasPrerequisite rdf:resource="#CITS1401"/>
  <uni.:hasPrerequisite rdf:resource="#ENSC2004"/>
  <uni.:hasAdvisedUnit rdf:resource="#PHYS1001"/>
  <uni.:hasContact rdf:resource="#MECH3024_contact_lectures"/>
  <uni.:hasContact rdf:resource="#MECH3024_contact_practical_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MECH3024</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering Thermodynamics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit presents a macroscopic treatment of thermodynamics from an engineering perspective, beginning with definitions of properties, forms of energy and systems. The behaviour of ideal gases is discussed, along with the use of the compressibility factor. The 1st law of thermodynamics is applied to both open and closed systems, leading to the steady flow energy equation and the definition of enthalpy. The behaviour of liquid-vapour systems and use of property tables and charts are discussed. The 2nd law of thermodynamics, the property entropy, and the Carnot cycle are introduced. The 1st and 2nd laws of thermodynamics are then applied to typical thermodynamic systems, for example internal combustion engines, using models such as the Otto cycle, Diesel cycle, and Brayton cycle. Issues surrounding the use of such thermodynamic systems, for example fuel sources, thermal efficiency, pollution and emissions form part of this system analysis.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of CITS1401 Computational Thinking with Python or CITS2401 Computer Analysis and Visualisation and ENSC2004 Engineering Mechanics</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">retrieve appropriate data from thermodynamic property tables and charts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret questions, problems and instructions written in the terminology of engineering thermodynamics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse simple systems, steady-state processes and cycles using the 1st and 2nd Laws of thermodynamics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">define systems, types of energy, states of substances and properties</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the ideal gas equations, recognising their limitations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the social and environmental impact of typical thermodynamic systems.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
</owl:NamedIndividual>

