  <rdf:Description rdf:about="http://example.com/made-in-abyss/Neritantan">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Beast"/>
    <rdfs:label>Neritantan</rdfs:label>
    <mia:hasSpecies>Mammal</mia:hasSpecies>
    <mia:livesIn rdf:resource="http://example.com/made-in-abyss/Layer_3"/>
    <mia:hasDangerLevel rdf:resource="http://example.com/made-in-abyss/Harmless_Danger"/>
    <mia:hasDescription>The Neritantan (ネリタンタン) is a species that inhabits the vast cave system within the walls of the 3rd Layer of The Abyss and live in the roots of the plants that grow haphazardly within it.</mia:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/World">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Entity"/>
