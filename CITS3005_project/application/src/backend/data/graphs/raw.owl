<owl:NamedIndividual rdf:about="#MUSC2441">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC1442"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSCO"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2441</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 3</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit consolidates and builds upon essential skills and concepts learnt in Contemporary Popular Music Principal Studies 2. Students further develop their own unique Contemporary Popular music practice, including performance, songwriting, live sound, and event promotion. Students will work collaboratively to produce their own portfolio in either performance and/or songwriting, while also learning techniques in production, and booking and promotion of live performances. This unit prepares students in technical and performance skills required for the next unit in the Principal Studies sequence.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1442 Contemporary Popular Music Principal Studies 2</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate proficiency with the fundamental techniques of live music production</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply theoretical knowledge of and practical proficiency in the fundamentals of booking and promoting live performance</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply effective strategies for self-directed collaborative music making appropriate to this level of tertiary study</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the processes involved in creative development.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collaborative music project</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portfolio</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MUSC2442">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2441"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSCO"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2442</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 4</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit consolidates and builds upon essential skills and concepts learnt in Contemporary Popular Music Principal Studies 3. Students will develop skills and learn fundamental concepts to support their own unique Contemporary Popular music practice, including performance, songwriting, and acoustic recording techniques. Students will work collaboratively to produce their own portfolio in either an original or recontextualised performance or recording. Applying their own creative focus, they will also learn the foundational approaches in microphone and recording techniques to record acoustic instruments and voice. As part of developing a portfolio, students will prepare a project plan incorporating sketches and demos, and these will form the basis of their final project in the following semester's capstone unit in the Principal Studies sequence.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2441 Contemporary Popular Music Principal Studies 3</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate proficiency in performing, composing, and/or recording contemporary popular music</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply effective strategies for self-directed collaborative and practice music making skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the processes involved in creative development.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply theoretical knowledge of and practical proficiency in creative project planning</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portfolio and exegesis</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collaborative music project</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MUSC3441">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2442"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSCO"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3441</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 5</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit facilitates students developing and presenting a professional performance or recorded work (EP) with an accompanying written exegesis that explores a specific creative thesis. Students will realise their major project, as planned in the previous Principal Studies unit, and will learn professional skills and concepts to support their own unique Contemporary Popular music practice. Students will work collaboratively to produce their own professional EP or live performance, and will learn the techniques required for song production and mixing. The final music project is expected to be suitable for, and shared publicly via, live performance or online presentation.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2442 Contemporary Popular Music Principal Studies 4</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">create and apply effective strategies and practices to achieve creative goals</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an advanced level of practical skill in performing, composing, and/or recording contemporary popular music</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design a large scale creative project from concept through to presentation, working both independently and collaboratively</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the processes involved in creative development.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portfolio and exegesis</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collaborative music project</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MUSC3538">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSCO"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSMT"/>
  <uni.:requiresDegree rdf:resource="#BP008"/>
  <uni.:hasContact rdf:resource="#MUSC3538_contact_Seminars"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3538</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Professional Skills: Music Industry and Artist</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit helps students develop skills in building a career as a musician or in a music-related field. Students will explore a variety of strands to a professional musical career, which may include aspects such as applying for grants, preparing a pitch to a festival director, understanding musicians health and wellbeing, negotiating artistic residencies, cultivating an audience, studio and classroom teaching, arts administration, dealing with copyright and royalties or marketing and promotion, and managing a portfolio career. The unit also guides students in exploring what type of artist they would like to be, and what they value as artists, culminating in the development of a their own personal set of artistic and career development goals.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one level 2 6 points Unit(s) BP008 Bachelor of Music or one level 2 6 points Unit(s) MJD-MUSCO Contemporary Popular Music</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of the institutional, educational, promotional, economic and professional aspects of the music industry and the collection of careers it encompasses</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply music industry knowledge to create a meaningful and feasible plan for the next phase of their musical careers.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate a professional skill set, goals, and values as a musician</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reflective journal and participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final portfolio</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">initial portfolio</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre</uni.:hasMajorTitle>
</owl:NamedIndividual>

