<owl:NamedIndividual rdf:about="#HRMT2237">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MGMT1136"/>
  <uni.:hasPrerequisite rdf:resource="#EMPL1101"/>
  <uni.:hasPrerequisite rdf:resource="#MGMX1136"/>
  <uni.:hasPrerequisite rdf:resource="#EMPL2202"/>
  <uni.:hasPrerequisite rdf:resource="#MGMX1135"/>
  <uni.:hasPrerequisite rdf:resource="#MGMT1135"/>
  <uni.:listedInMajor rdf:resource="#MJD-HRSMT"/>
  <uni.:hasContact rdf:resource="#HRMT2237_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HRMT2237</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Resource Management</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit presents an overview of theories, problems and issues in human resource management in organisations. Topics include human resource strategy and planning; job analysis and evaluation; recruitment and selection; compensation; performance appraisal; occupational health and safety; equal opportunity; and international human resource management.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT1135 Organisational Behaviour or MGMX1135 Organisational Behaviour or MGMT1136 Management and Organisations or MGMX1136 Management and Organisations or EMPL1101 Employment Relations, Work and Society or EMPL2202 Australian Employment Relations</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate awareness of the internal and external factors that influence the conduct of HRM in organisations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the importance, purpose and objectives of HRM</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and analyse current issues and trends in HRM</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse concepts and techniques in Human Resource Management</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply their learning about HRM concepts to practical contexts and issues</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse information about HRM from the library, the web and other sources of information.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-standard teaching period</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examinations</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workshop participation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Business Management</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Resource Management</uni.:hasMajorTitle>
</owl:NamedIndividual>

