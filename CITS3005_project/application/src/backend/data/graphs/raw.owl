<owl:NamedIndividual rdf:about="#ANHB3330">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Human_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB1101"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB2212"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB1102"/>
  <uni.:hasPrerequisite rdf:resource="#ANHX1101"/>
  <uni.:hasPrerequisite rdf:resource="#SSEH1101"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB2217"/>
  <uni.:hasPrerequisite rdf:resource="#ANHX1102"/>
  <uni.:listedInMajor rdf:resource="#MJD-ANHBY"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB3330</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Structure and Function - Head and Neck</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on head and neck and teaches the relevant embryology, gross anatomy, functional application and imaging to ensure a holistic understanding of human anatomy.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of 54 points and Successful completion of ( ANHB2212 Human Structure and Development or ANHB2217 Human Neurobiology or Successful completion of SSEH1101 The Musculoskeletal System and Movement and any one Unit(s) ANHB1101 Human Biology I: Becoming Human or ANHB1102 Human Biology II: Being Human or ANHX1101 Human Biology 1 (Becoming Human) or ANHX1102 Human Biology 2 (Being Human) )</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the topographical anatomy and head and neck</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the functional anatomy of the head and neck</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of anatomical, developmental and evolutionary principles illustrated by the regional anatomy of the head and neck.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in semester practical assessment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weekly laboratory preparation and participation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomy and Human Biology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Sciences (Anatomy and Physiology)</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recommended text books will be published in the unit outline</uni.:hasNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ANHB2217">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Human_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB1101"/>
  <uni.:hasPrerequisite rdf:resource="#IMED1001"/>
  <uni.:hasPrerequisite rdf:resource="#SCIX1106"/>
  <uni.:hasPrerequisite rdf:resource="#ANHX1101"/>
  <uni.:hasPrerequisite rdf:resource="#ANHB1102"/>
  <uni.:hasPrerequisite rdf:resource="#BIOL1130"/>
  <uni.:hasPrerequisite rdf:resource="#ANHX1102"/>
  <uni.:hasPrerequisite rdf:resource="#SCIE1106"/>
  <uni.:requiresDegree rdf:resource="#71520"/>
  <uni.:hasAdvisedUnit rdf:resource="#IMED1001"/>
  <uni.:hasAdvisedUnit rdf:resource="#ANHB1102"/>
  <uni.:hasContact rdf:resource="#ANHB2217_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ANHB2217_contact_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB2217</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Neurobiology</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the central, peripheral and visceral nervous systems of humans. Higher cortical function, motor control, memory, emotion, motivation and homeostasis are explored. ANHB2217 aims to give students a thorough understanding of neuroanatomy and neurophysiology which form the foundations of neuroscience. Content will be delivered by active learning lectures and exploring cadaveric material and clinical images in the dissection laboratory.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any two Unit(s) ANHB1101 Human Biology I: Becoming Human or ANHX1101 Human Biology 1 (Becoming Human) or ANHB1102 Human Biology II: Being Human or ANHX1102 Human Biology 2 (Being Human) or BIOL1130 Frontiers in Biology or SCIE1106 Molecular Biology of the Cell or SCIX1106 Molecular Biology of the Cell or IMED1001 Form and Function or Enrolment in 71520 Master of Biomedical Science</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify, describe and distinguish structures in the central, peripheral and visceral nervous systems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply their knowledge to understand the anatomical basis of common neuropathologies..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incorporate neuroanatomy and basic physiology concepts to understand higher cortical function, motor control and homeostasis.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class test</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lab preparation &amp; assessment</uni.:hasAssessment>
</owl:NamedIndividual>

