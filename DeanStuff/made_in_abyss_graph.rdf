  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Hamashirama">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Beast"/>
    <rdfs:label>Hamashirama</rdfs:label>
    <mia:hasSpecies>Fish</mia:hasSpecies>
    <mia:livesIn rdf:resource="http://example.com/made-in-abyss/Layer_5"/>
    <mia:hasDangerLevel rdf:resource="http://example.com/made-in-abyss/Insignificant_Danger"/>
    <mia:hasDescription>The Hamashirama (ハマシラマ) is a strange fish that lives in large numbers in the 5th Layer of The Abyss, the Sea of Corpses. It's one of the creatures documented in Lyza's Notes.</mia:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Prushka">
