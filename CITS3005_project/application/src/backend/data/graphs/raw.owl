<owl:NamedIndividual rdf:about="#HRMT3345">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#HRMT2237"/>
  <uni.:listedInMajor rdf:resource="#MJD-HRSMT"/>
  <uni.:hasContact rdf:resource="#HRMT3345_contact_lectures_tutorials_seminars_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HRMT3345</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Managing Jobs, Performance and Wellbeing</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines human performance at work and implications for the management of human resources. Topics include: individual work performance in the modern work context; well-being in the workplace; advanced topics in work design; performance assessment and management; and the training of knowledge and skills. The unit emphasises the contribution of human resources management to developing a high performance work system that meets both individual and organisational needs.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HRMT2237 Human Resource Management</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate the ability to write a project proposal or report.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding and knowledge regarding a range of individual difference factors that are relevant to the design and evaluation of HRM interventions</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding and knowledge regarding a range of human resource management</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate the ability to conduct and write a literature review regarding a specific HRM issue that draws on theoretical and empirical research</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tutorial participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strategic HRM case analysis</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Resource Management</uni.:hasMajorTitle>
</owl:NamedIndividual>

