  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit consolidates and integrates learning from the Business Management major. Students will work collaboratively in teams to analyse and evaluate real-world business problems, using the critical and problem-solving skills developed in the major to bear on this problem.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in BP009 Bachelor of Business or Enrolment in MJD-BUSAN Business Analytics or MJS-BMGMT, MJS-GLBUS or MJS-ENTIN and Successful completion of 96 points</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate teamwork and problem-solving skills in real world scenarios</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">attendance and engagement in the workshops, their contribution to the group project in teams [assessed by: marked on attendance and engagement through individual participation.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate effective oral and written communication skills</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply technical expertise by integrating business problems that are layered with real-life issues</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
