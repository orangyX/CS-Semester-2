  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Madokajack">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Beast"/>
    <rdfs:label>Madokajack</rdfs:label>
    <mia:hasSpecies>Reptile</mia:hasSpecies>
    <mia:livesIn rdf:resource="http://example.com/made-in-abyss/Layer_3"/>
    <mia:hasDangerLevel rdf:resource="http://example.com/made-in-abyss/Deadly_Danger"/>
    <mia:hasDescription>Madokajacks (マドカジャク, Madokajaku) are large reptilian creatures that live in the 3rd Layer.</mia:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Crystallized_Water_Supports">
