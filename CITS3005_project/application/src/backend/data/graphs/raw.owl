<owl:NamedIndividual rdf:about="#PHYS1002">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#PHYS1001"/>
  <uni.:hasPrerequisite rdf:resource="#PHYX1001"/>
  <uni.:listedInMajor rdf:resource="#MJD-PHYSC"/>
  <uni.:hasContact rdf:resource="#PHYS1002_contact_Laboratories"/>
  <uni.:hasContact rdf:resource="#PHYS1002_contact_online_recorded_lectures"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS1002</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modern Physics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the physical principles underlying selected topics in modern physics, including: special relativity, magnetism, electrical circuits and the physics of particles. The content is explored with reference to a range of applications and physical contexts, and developed and applied through a series of laboratory tasks. Skills in problem identification and mathematical solution are fostered through assignment sheets and practical class activities.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS1001 Physics for Scientists and Engineers or PHYX1001 Physics for Scientists and Engineers</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solve problems in a range of realistic situations relating to the foundations of special relativity, magnetism, electrical circuits and the physics of particles</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate ideas, both orally and in writing, relating to the foundations of special relativity, magnetism, electrical circuits and the physics of particles</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate the results of an experiment relevant to physics.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">execute a series of experiments relevant to physics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the concepts and physical principles involved in the foundations of special relativity, magnetism, electrical circuits and the physics of particles</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests and problem solving</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics</uni.:hasMajorTitle>
</owl:NamedIndividual>

