<owl:NamedIndividual rdf:about="#CHEM3101">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Molecular_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM2101"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHEMY"/>
  <uni.:hasContact rdf:resource="#CHEM3101_contact_lectures"/>
  <uni.:hasContact rdf:resource="#CHEM3101_contact_workshops"/>
  <uni.:hasContact rdf:resource="#CHEM3101_contact_laboratories"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEM3101</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Workplace Safety and Advanced Analytical Methods</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds upon CHEM2101-Analytical Methods and introduces students to topics relevant to the chemical industry, including advanced analytical methods and characterisation techniques. In addition, students are introduced to important aspects of occupational health and safety that are relevant to industry and the chemical laboratory, including legislation. This unit also further develops key scientific writing techniques with an emphasis on safety. This unit will be offered from Semester 1 2025</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEM2101 Analytical Methods</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain principles and concepts related to safe work in research and industry laboratories</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply skills in scientific writing, chemical literacy, problem solving, critical analysis and teamwork to chemistry real world problems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate advanced practical skills in the operation of relevant instrumentation and data analysis</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scientific presentations</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports and worksheets</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geochemistry</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemistry</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will be offered from Semester 1 2025</uni.:hasNote>
</owl:NamedIndividual>

