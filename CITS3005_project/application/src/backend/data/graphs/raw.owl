<owl:NamedIndividual rdf:about="#ENVT3363">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Biological_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#ENVT2250"/>
  <uni.:hasPrerequisite rdf:resource="#ENVT2221"/>
  <uni.:hasPrerequisite rdf:resource="#SCIE2204"/>
  <uni.:hasContact rdf:resource="#ENVT3363_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ENVT3363_contact_labs_discussion_groups"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT3363</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ecological Processes</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on knowledge of ecological processes acquired at Level 2. The main academic objectives of this unit are to (1) develop a deeper understanding of ecological processes, both biotic and abiotic, across marine, freshwater and terrestrial ecosystems; (2) develop a deeper understanding of the interconnected and synergistic nature of ecological processes; (3) be able to apply this deeper understanding when evaluating and interpreting contemporary environmental change; and (4) be able to design appropriate scientific research programs to address contemporary environmental problems.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) ENVT2250 Ecology (ID 1228) or Unit(s) ENVT2221 Global Climate Change and Biodiversity (ID 1293) or Unit(s) SCIE2204 Marine Systems (ID 1524)</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have the capacity for analytical thinking and for the development of logical arguments to design scientific research to evaluate the interacting causes of environmental change.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have the ability to think at different levels of integration, from population, community, landscape, stable isotope ecology and ecosystem ecology</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be aware of the interacting effects of environmental change on ecological processes</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have an advanced understanding of ecological processes across terrestrial, aquatic and marine ecosystems</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a two-hour written examination and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an assignment on laboratories, research project and discussion groups</uni.:hasAssessment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ENVT2221">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Biological_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#BIOL1130"/>
  <uni.:hasPrerequisite rdf:resource="#EART1105"/>
  <uni.:hasPrerequisite rdf:resource="#BIOL1131"/>
  <uni.:hasPrerequisite rdf:resource="#ENVT1104"/>
  <uni.:listedInMajor rdf:resource="#MJD-MBIOL"/>
  <uni.:listedInMajor rdf:resource="#MJD-ENVMT"/>
  <uni.:listedInMajor rdf:resource="#MJD-CONBI"/>
  <uni.:hasContact rdf:resource="#ENVT2221_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ENVT2221_contact_labs_field_trips"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT2221</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Global Climate Change and Biodiversity</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on the concept that climate change can drive the evolution of biological diversity. It aims to explain the atmospheric processes that regulate the Earth's climate; the role of climate change in the evolution of the world's ecosystems; the human-induced changes that are occurring in the atmosphere; how these changes affect the global climate which in turn affects biodiversity; and the challenges of biodiversity conservation under climate change. Emphasis is placed on understanding the links between the atmosphere, climate and the world's ecosystems; how changes in climate can force species losses, migration and adaptation; what can be learned from vegetation response to past climate changes; the predicted impacts to biological diversity under projected greenhouse climates; and the conservation efforts that are required to mitigate these impacts.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one BIOL1130 Frontiers in Biology (ID 1254) or BIOL1131 Plant and Animal Biology (ID 1244) or EART1105 Dynamic Planet (ID 1247) or ENVT1104 Environmental Science and Technology (ID 5950)</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differentiate between climate change over geological time scales</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recall examples of speciation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesise information from a variety of sources and present it in both written and verbal formats.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate the evidence for human-induced climate change associated with increased emission of carbon dioxide and other greenhouse gases into the atmosphere</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">list some of the predicted impacts of projected climate change on biodiversity</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the relative effects of past and projected climate change on pathogens, plants and animals</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outline strategies that could be used to manage the impacts of climate change so as to conserve biodiversity</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the global-scale processes that regulate climate</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">student engagement</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Essay on a climate change related topic</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conservation Biology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Biology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Management</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wildlife Conservation</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Life Sciences</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SCIE2204">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Biological_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#EART1105"/>
  <uni.:hasPrerequisite rdf:resource="#BIOL1131"/>
  <uni.:listedInMajor rdf:resource="#MJD-MBIOL"/>
  <uni.:listedInMajor rdf:resource="#MJD-MARCP"/>
  <uni.:hasContact rdf:resource="#SCIE2204_contact_lectures_tutorials"/>
  <uni.:hasContact rdf:resource="#SCIE2204_contact_labs_field_trips"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCIE2204</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Systems</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an introduction to the multidisciplinary aspects of marine science. Using the framework of the local Western Australia (WA) marine environment, it outlines how the multidisciplinary aspects of marine science are essential in understanding and managing such an ecosystem. Aspects covered include oceanography, geology and geomorphology and marine biology. Students obtain an introduction to the multidisciplinary aspects of marine science; and develop an understanding of the principles of oceanography, geology and geomorphology and how marine organisms interact with the environment.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of EART1105 Dynamic Planet or BIOL1131 Plant and Animal Biology</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate scientific interpretations of marine field observations and data in structured written formats..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify major marine taxa and evaluate their ecological roles within marine ecosystems.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the multidisciplinary components of marine systems, integrating concepts from marine biology, oceanography, geology, and geomorphology.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret physical and biological marine processes, including tides, waves, currents, and ecological interactions.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply quantitative and data handling skills to organise, visualise, and interpret marine scientific data.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes and lab exercises</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">field trip report</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Biology</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrated Earth and Marine Sciences</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine and Coastal Processes</uni.:hasMajorTitle>
</owl:NamedIndividual>

