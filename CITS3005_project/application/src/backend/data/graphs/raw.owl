<owl:NamedIndividual rdf:about="#GENG1014">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-EMINE"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECIVL"/>
  <uni.:listedInMajor rdf:resource="#MJD-EENVE"/>
  <uni.:hasContact rdf:resource="#GENG1014_contact_lectures"/>
  <uni.:hasContact rdf:resource="#GENG1014_contact_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG1014</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Earth Systems Engineering</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Through this unit, student engineers will be able to recognise and explain the interconnectedness between the natural and built environments and society, as a foundation to design sustainable engineering solutions and to be responsible stewards of the Earth. This unit provides an introduction to the physical, geological, hydrological and ecological processes for earth systems engineering, and a holistic systems approach to how these processes respond and interact with each other. The unit covers theories and quantitative techniques to understand interactions between water, air and soil, and the ecosystem response to these interactions.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the processes governing rock and soil formation, and the influence of the atmosphere and hydrosphere on these processes</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">illustrate the connectivity of the earth system cycles through a case study.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate the cycle of resource exploration and extraction and how it interacts with the earth system and society</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate the relationship between the major earth system cycles and their role in providing services to society</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the key components of the earth systems, including the geosphere, hydrosphere, biosphere, and atmosphere, and how they relate to engineering practice</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation and collaborative learning</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Civil Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mining Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

