<owl:NamedIndividual rdf:about="#MKTG3305">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Business_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MKTG1203"/>
  <uni.:listedInMajor rdf:resource="#MJD-MRKTG"/>
  <uni.:hasContact rdf:resource="#MKTG3305_contact_per_week_in_class"/>
  <uni.:hasContact rdf:resource="#MKTG3305_contact_per_week_online"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG3305</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marketing for Social Purpose</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social marketing applies marketing principles to influence behaviours that benefit individuals and society, addressing critical issues such as public health, environmental sustainability, and social justice. But how do we craft campaigns that effectively inspire positive behaviour change? This unit will answer that question, immersing students in real-world social marketing challenges and strategies. Students will explore how to identify target behaviours, segment audiences, and develop compelling value propositions that resonate with diverse groups. Additionally, students will learn how to design, implement, and evaluate social marketing campaigns, equipping you with the strategic and creative tools necessary to tackle societal issues and drive meaningful change</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MKTG1203 Introduction to Marketing</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deliver effective oral presentations in a marketing context</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically reflect on the principles of social marketing and the various functions of behaviour change campaigns</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce clear and concise written communication tailored to different audiences and purposes</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate the effectiveness of the various components of a social marketing campaign and how they interact</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recommend creative strategies and tactics to design, implement, and evaluate social marketing initiatives</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competencies to work effectively in diverse teams to address societal challenges</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of ethical decision making and sustainability issues.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation and reflection</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marketing</uni.:hasMajorTitle>
</owl:NamedIndividual>

