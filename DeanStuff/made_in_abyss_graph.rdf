  <rdf:Description rdf:about="http://example.com/made-in-abyss/Sereny">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Place"/>
    <mia:hasDescription>Sereny (セレニの地ち, Sereni no Chi) is a country outside of Orth. It is the most powerful nation of the world's northern territories and has a cold, snowy climate.</mia:hasDescription>
    <rdfs:label>Sereny</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/World"/>
  </rdf:Description>
