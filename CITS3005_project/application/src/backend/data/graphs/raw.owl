<owl:NamedIndividual rdf:about="#COMM3003">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#COMM2001"/>
  <uni.:hasPrerequisite rdf:resource="#COMM1001"/>
  <uni.:hasPrerequisite rdf:resource="#COMM2002"/>
  <uni.:hasPrerequisite rdf:resource="#COMM1002"/>
  <uni.:hasContact rdf:resource="#COMM3003_contact_per_teaching_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMM3003</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Designing Interactive Media</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interactive media has become increasingly pervasive across political, economic, social and cultural processes, facilitating the interplay of storytelling through interactive and transmedia technologies commonly utilised to extend communicative experiences. Focusing on non-linear narratives, this unit introduces students to the main elements and principles of their creation and application. The unit engages students with both theoretical and practical aspects of interactivity through a hands-on approach to the design of transmedia narratives, aiming to facilitate students' creative and critical engagement with the production and consumption of interactive media experiences.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMM1001 Power, Participation and Meaning (ID 813) or COMM1002 Cultures, New Media and Communications (ID 814) and COMM2001 Media Influence or COMM2002 Digital Media</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foster collaborative and professional interactive- and trans-media skills by engaging in team projects that simulate real-world scenarios</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise, analyse, and utilise key interactive- and trans-media elements</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply research, communication and design skills applicable across the creative and media industries..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a critical understanding of the key issues underpinning the production and consumption of interactive- and trans-media experiences</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">major project</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written work</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Media and Communicatio</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#COMM3003_contact_per_teaching_week">
