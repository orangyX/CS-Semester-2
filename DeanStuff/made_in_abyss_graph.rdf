  <rdf:Description rdf:about="http://example.com/made-in-abyss/Star_Compass">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Artifact"/>
    <rdfs:label>Star Compass</rdfs:label>
    <mia:hasDescription>An Artifact found in the 1st Layer by Riko, who named it.</mia:hasDescription>
    <mia:hasEffect>Navigation</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Riko"/>
    <mia:hasGrade rdf:resource="http://example.com/made-in-abyss/Fourth_Grade"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Heavens_Waterfall">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <mia:hasDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2600</mia:hasDepth>
