<owl:NamedIndividual rdf:about="#INDG2700">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Indigenous_Studies"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-INKHH"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG2700</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Knowing Country: The Dreaming and Darwin</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This multidisciplinary unit takes students on a journey across space and time to examine the relationship between human beings and the environment. How do we 'see' and 'know' nature? How do we describe and experience it? Two lenses are used to examine these questions. The first is Indigenous perspectives starting from creation in the Dreaming to understandings of the environment. The second lens is the science of natural history. The unit explores the discipline's philosophy, techniques and scientific rationale. It features a short lecture series followed by interactive field work in the Albany region during the semester break.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any Level 1 unit or equivalent</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">find ways of forming a relationship with the environment through language, description and visual imagery and be able to explain this relationship in writing</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be aware of Indigenous protocols to do with the environment</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a critical understanding of Indigenous and Western views on nature</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the philosophy and techniques of natural history</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically explore in writing the areas of tension and convergence between Indigenous and Western approaches to the environment.</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">final report</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation and engagement assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workshop presentation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Knowledge, History and Heritage</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Students are advised that this unit may have an incidental fee of up to $60 per day for local fieldtrips (details to be confirmed by Unit Coordinator)</uni.:hasNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#INDG2800">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Indigenous_Studies"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-INKHH"/>
  <uni.:hasContact rdf:resource="#INDG2800_contact_lecture_seminars_and"/>
  <uni.:hasContact rdf:resource="#INDG2800_contact_of_workshops_tutorials_up_to_9_weeks_May_also_be_intensively_taught_over_a_3_4_week_study_tour_or_in_house_study_program"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG2800</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Ways of Knowing 2 (Intermediate)</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides Level 2 students with the opportunity to study, experience and relate to a range of intermediate Indigenous knowledge topics that become available through the School of Indigenous Studies' global Indigenous engagement programs. Studying in different locations alongside different host communities will provide first-hand opportunities to experience and investigate issues of local, national and global Indigenous rights, sustainable community development, environmental custodianship and cultural wellbeing primarily from an Indigenous perspective.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">48 Points of successful prior study and approval by the School of Indigenous Studies.</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate quality intermediate communication, citizenship and life-learning skills in both academic and community-based settings</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">actively demonstrate ethical ways of engaging ‘in-country' with different Indigenous peoples and their knowledges, values and belief systems</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop intermediate skills to critically analyse representations of cultural heritage, making links to the knowledge of historical and contemporary contexts in a set of creative multimedia exercises and assessment items</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify further initiatives for Indigenous study in their respective university learning programs, community service activities, or future professional practices.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an intermediate level of understanding and experience by way of appropriately immersing themselves in the day-to-day learning experiences and cultural lifestyles of host Indigenous communities and their settings</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation and engagement assessments</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">major report</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workshop presentation</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Knowledge, History and Heritage</uni.:hasMajorTitle>
</owl:NamedIndividual>

