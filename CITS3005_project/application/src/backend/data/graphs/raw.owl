<owl:NamedIndividual rdf:about="#ENVT3307">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Earth_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_Albany"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#SCIE2204"/>
  <uni.:hasContact rdf:resource="#ENVT3307_contact_lectures"/>
  <uni.:hasContact rdf:resource="#ENVT3307_contact_laboratories"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT3307</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oceanography</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers an introduction to the physics of the ocean; physical properties of sea water; global distribution of temperature and salinity; dynamics governing motion in the ocean; barotropic and baroclinic ocean circulation; heat and salt budgets; water mass formation; major ocean biogeochemical cycles; the dynamics of coastal primary to secondary biological production; and the interaction of ocean processes with benthic biological communities.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) SCIE2204 Marine Systems</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse and interpret physical and biological oceanographic datasets in real world applications.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how the ocean's physical processes influence its biological characteristics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an appreciation for the basic laws of physics that describe fluid motion in the ocean</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the major driving forces of ocean circulation</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examinations</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
</owl:NamedIndividual>

