<owl:NamedIndividual rdf:about="#MINE3401">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MINE2001"/>
  <uni.:listedInMajor rdf:resource="#MJD-EMINE"/>
  <uni.:hasContact rdf:resource="#MINE3401_contact_Lectures"/>
  <uni.:hasContact rdf:resource="#MINE3401_contact_Practicals"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINE3401</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Underground Mining</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The aim in this unit is to provide students with the capability to select and evaluate the appropriate underground mining method, together with its associated equipment, services and infrastructure, for a given deposit. To achieve this, a systems-approach is implemented to the principles, design and application of the major underground mining methods, such as sublevel stoping, cut-and-fill mining, narrow vein mining, and caving methods. During the semester, there may be a field trip to some underground mines if the conditions allow it.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of MINE2001 Fundamentals of Mining Engineering</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe major underground mining methods and their related equipment, supporting infrastructure, performance drivers, and constraints</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appraise underground mining methods with respect to productivity, safety, efficiency, risks and sustainability</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design deposit access and extraction layouts with respect to different underground mining methods</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce high quality engineering communications related to underground mining operations.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify major problems associated with underground mining methods and use systematic methods to resolve them</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">select underground mining methods appropriate to specific types of deposits</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate awareness of the major technological trends in underground mining methods and equipment</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">individual portfolio</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group mini project</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mining Engineering</uni.:hasMajorTitle>
</owl:NamedIndividual>

