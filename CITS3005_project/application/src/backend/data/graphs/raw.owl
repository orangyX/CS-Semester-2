<owl:NamedIndividual rdf:about="#PSYC2213">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Psychological_Science"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#PSYC1102"/>
  <uni.:hasPrerequisite rdf:resource="#PSYC1101"/>
  <uni.:listedInMajor rdf:resource="#MJD-PSYCH"/>
  <uni.:hasContact rdf:resource="#PSYC2213_contact_lectures"/>
  <uni.:hasContact rdf:resource="#PSYC2213_contact_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSYC2213</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychology: Lifespan Development</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the scientific study of lifespan development, with emphasis on major theories, key research findings, and core methods used in developmental psychology. The areas of development covered include cognition, language, literacy, numeracy, social and emotional functioning, and self-identity. Students will also examine how biological, cognitive, social, cultural, and contextual influences shape development across the lifespan, with a focus on critical evaluation of developmental theory and evidence.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) PSYC1101 Psychology: Mind and Brain or Unit(s) PSYC1102 Psychology: Behaviour in Context</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of the research methods used in developmental psychology.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate developmental psychology concepts and research findings clearly and effectively in written form..</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply critical thinking to developmental issues and research evidence.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate self-directed pursuit of scholarly inquiry in developmental psychology.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a thorough understanding of the key principles and concepts in developmental psychology, and describe key aspects of biological, cognitive, social, and emotional development across the lifespan.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and evaluate current theories and research on biological, cognitive, social, cultural, and contextual influences on development across the lifespan.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment 1</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment 2</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychological and Behavioural Sciences</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychology</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolled students can access unit material via the LMS (Learning Management System).Students are exposed to topics in psychology units that may cause some discomfort or distress in certain individuals (e.g. depression, suicide, trauma, eating disorders). They are also required to demonstrate skills across a variety of different formats and contexts (e.g. written assessments, participation in practical work, contribution to group discussions, oral presentations, examinations), and so it is important to carefully consider whether they are able to cope with the demands of studying psychology and whether there is anything that would impact upon their ability to complete the requirements of the unit. Refer to individual unit outlines for more detailed unit information.</uni.:hasNote>
</owl:NamedIndividual>

