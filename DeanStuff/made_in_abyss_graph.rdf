  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Layer_3">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Place"/>
    <mia:hasDepth>2,600 - 7,000 meters.</mia:hasDepth>
    <mia:minDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2600</mia:minDepth>
    <mia:maxDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7000</mia:maxDepth>
    <mia:hasDescription>The Great Fault (大断層だいだんそう, Dai-dansō) is The Abyss' third layer (深界しんかい三層さんそう, Shinkai San-sō). A narrow, 4-kilometer-deep gorge surrounded by countless interlocking caverns and with creatures, both harmless and deadly, lurking inside.</mia:hasDescription>
    <mia:hasEffect>Strains of Ascent: In addition to aforementioned effects, vertigo combined with visual and auditory hallucinations.</mia:hasEffect>
    <mia:hasWhistleRequirement rdf:resource="http://example.com/made-in-abyss/MoonWhistle"/>
    <rdfs:label>3rd Layer</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/The_Abyss"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Baracocha_Corridors"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Cumulonimbus_Point"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Ghostly_Roots"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Greenery_Layer"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/The_Imprisoned_Pirate_Ship"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Rumbling_Grounds_of_the_Strong"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Tallowstone_Layer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Meinastilim">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Beast"/>
    <rdfs:label>Meinastilim</rdfs:label>
    <mia:hasSpecies>Mammal</mia:hasSpecies>
    <mia:hasDangerLevel rdf:resource="http://example.com/made-in-abyss/Unknown_Danger"/>
    <mia:hasDescription>Meinastilim (メイナストイリム, Meinasutoirimu), also called a 'Child of Change' (変化へんかの子こ, Henka no Ko), are a species found in The Abyss. Not much is known about the species as a whole, due to there being only one known specimen, Meinya.</mia:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/South_Orth">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/District"/>
    <rdfs:label>South District</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Orth"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/The_Wharf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Baracocha_Corridors">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <mia:hasDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3300</mia:hasDepth>
    <rdfs:label>Baracocha Corridors</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Layer_3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/The_Imprisoned_Pirate_Ship">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <mia:hasDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</mia:hasDepth>
    <rdfs:label>The Imprisoned Pirate Ship</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Layer_3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Third_Grade">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/ArtifactGrade"/>
    <rdfs:label>Third Grade</rdfs:label>
    <mia:hasDescription>Third Grade Artifacts are described as being extremely valuable or useful. They can help with cave raiding.</mia:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Canopy_Unto_Dawn">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Artifact"/>
    <rdfs:label>Canopy Unto Dawn</rdfs:label>
    <mia:hasDescription>A custom-made set of armour for the Umbra Hands, made from several Artifacts and bio-fibres.</mia:hasDescription>
    <mia:hasEffect>Armour set</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Bondrewd"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Jisweku">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Place"/>
    <mia:hasDescription>Jisweku (ジスェクー, Jisuekū) is a remote western country outside of Orth</mia:hasDescription>
    <rdfs:label>Jisweku</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/World"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Old_Beasts_Hidden_Hot_Spring">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <mia:hasDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7100</mia:hasDepth>
