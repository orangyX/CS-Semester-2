    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Layer_4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Ghostly_Roots">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <rdfs:label>Ghostly Roots</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Layer_3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Twisting_Crag">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <rdfs:label>Twisting Crag</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Layer_1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Zoaholic">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Artifact"/>
    <rdfs:label>Zoaholic</rdfs:label>
    <mia:hasDescription>An Artifact that transfers the user's mind into other living beings and allows the connected bodies to share thoughts.</mia:hasDescription>
    <mia:hasEffect>Consciousness transference</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Bondrewd"/>
    <mia:hasGrade rdf:resource="http://example.com/made-in-abyss/Special_Grade"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Layer_5">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Place"/>
    <mia:hasDepth>12,000 - 13,000 meters.</mia:hasDepth>
    <mia:minDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12000</mia:minDepth>
    <mia:maxDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13000</mia:maxDepth>
    <mia:hasDescription>The Sea of Corpses (なきがらの海うみ, Nakigara no Umi) is The Abyss' fifth layer (深界しんかい五ご層そう, Shinkai Go-sō). It consists of a vast frozen wasteland encircling a massive sea.[1] It is also the last layer that it is physically possible for Delvers to return to the surface without loss of humanity or dying</mia:hasDescription>
    <mia:hasEffect>Strains of Ascent: Complete sensory deprivation, confusion and self-harming behavior.</mia:hasEffect>
    <mia:hasWhistleRequirement rdf:resource="http://example.com/made-in-abyss/WhiteWhistle"/>
    <rdfs:label>5th Layer</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/The_Abyss"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Crystallized_Water_Supports"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Frost_Dragonbones"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Ido_Front"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Sandstone_Region"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Central_Orth">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/District"/>
    <rdfs:label>Central District</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Orth"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Gate_to_the_Netherworld"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Neyozel">
