<owl:NamedIndividual rdf:about="#CHEM3105">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Molecular_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM2101"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM2104"/>
  <uni.:hasPrerequisite rdf:resource="#CHEM3101"/>
  <uni.:hasContact rdf:resource="#CHEM3105_contact_laboratories"/>
  <uni.:hasContact rdf:resource="#CHEM3105_contact_lectures"/>
  <uni.:hasContact rdf:resource="#CHEM3105_contact_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEM3105</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Materials</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds upon the tools and techniques introduced in CHEM2104-Energy and Materials. Topics include nanotechnology, polymers, drug delivery, nanostructured liquids and solid materials, liquid crystals, surfactants, interfaces and emulsions. Advanced concepts in these topics are also taught using examples from cutting edge chemical research and a range of industries. This unit will be offered from: TBA</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEM2101 Analytical Methods and CHEM2104 Energy and Materials and CHEM3101 Workplace Safety and Advanced Analytical Methods</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the principles and concepts related to topics in advanced materials</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate skills in scientific writing, problem solving, critical analysis and teamwork</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire practical skills in the interpretation of experimental measurements and the evaluation of their reliability and sensitivity.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire practical skills in the operation of relevant instrumentation</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire practical skills in data analysis</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports and worksheets</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quizzes</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geochemistr</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will be offered from: 2025</uni.:hasNote>
