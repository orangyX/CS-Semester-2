  <uni.:listedInDegree rdf:resource="#BP001"/>
  <uni.:listedInDegree rdf:resource="#BH005"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-EGCST</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">English and Literary Studies</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Studying English and Literary Studies enriches students' understanding, enjoyment and practice of major literary, cinematic and theatrical forms. This major includes units that span historical periods and cultures, and involves the study of literary history; creative writing and theatre; popular culture and film; and critical theory. The emphasis is on developing an understanding of how we communicate and of diverse forms of representation across time, place and media.</uni.:hasDescription>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work effectively as a member of a collaborative group.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clearly express ideas, examples and arguments in appropriate written and oral forms</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deploy skills of critical analysis and independent critical reasoning</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret texts produced in varied cultural and historical contexts with sensitivity to the generic dimensions, intertextual significance, and formal qualities of those texts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate and make use of critical scholarship in the discipline of English Literary Studies</uni.:hasOutcome>
</owl:NamedIndividual>

