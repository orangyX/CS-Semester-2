<owl:NamedIndividual rdf:about="#POLS3304">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#IREL2001"/>
  <uni.:listedInMajor rdf:resource="#MJD-ICYDM"/>
  <uni.:listedInMajor rdf:resource="#MJD-POLSC"/>
  <uni.:hasContact rdf:resource="#POLS3304_contact_Workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">POLS3304</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Policy and Diplomacy in Practice</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This Capstone unit for Political Science &amp; International Relations major integrates the main knowledge, skills, issues and methods identified in the study of the various units. It is focused on a learning approach seeking to solve real world problems and prepare students for future careers in a competitive job market. Students will learn to evaluate the complexity in the shaping, connection and negotiation of government policies in domestic and international spheres. For that purpose, the unit will bring in policy practitioners (such as diplomats, politicians, officials, and NGO activists), current and former, as guest lecturers to speak to the class on their career experiences. Students will also engage in simulation exercises, representing different countries to discuss and negotiate major contemporary issues in an international setting such as the United Nations, or representing different Australian government agencies/interest groups to debate other political issues. Further, students will design their own research project built around a real world challenge, writing up a policy position paper to analyse its complexity and suggest a policy for solution.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any one level 1 Political Science (POLS) units and any three level 2 Political Science (POLS) or Political Science, Philosophy, and Economics (PPHE) units or Enrolment in MJD-ICYDM International Cybersecurity and Successful completion of IREL2001 Foundations of Foreign Policy</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate advanced skills in public speech.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the knowledge, skills and methods acquired through the major to critically analyse real-world social and political challenges</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design and complete a research project in a timely fashion</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">display career-relevant skills in political and diplomatic negotiation and team-work</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate and suggest policy responses to these challenges</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analytical assessment and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philosophy, Politics and Economics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Cybersecurity</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Political Science and International Relations</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Relations</uni.:hasMajorTitle>
</owl:NamedIndividual>

