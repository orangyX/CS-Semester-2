    <rdf:type rdf:resource="http://example.com/made-in-abyss/Artifact"/>
    <rdfs:label>Forgetter</rdfs:label>
    <mia:hasDescription>A rigid Second-Grade Artifact. A large number were found at the Joint Delving Site.</mia:hasDescription>
    <mia:hasEffect>Storage unit</mia:hasEffect>
    <mia:ownedBy rdf:resource="http://example.com/made-in-abyss/Orth"/>
