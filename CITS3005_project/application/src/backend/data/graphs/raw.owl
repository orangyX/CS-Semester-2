<owl:NamedIndividual rdf:about="#STAT2401">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-CDSDM"/>
  <uni.:listedInMajor rdf:resource="#MJD-DATSC"/>
  <uni.:listedInMajor rdf:resource="#MJD-STATS"/>
  <uni.:requiresDegree rdf:resource="#62530"/>
  <uni.:hasAdvisedUnit rdf:resource="#STAT1400"/>
  <uni.:hasAdvisedUnit rdf:resource="#STAT1520"/>
  <uni.:hasContact rdf:resource="#STAT2401_contact_lectures"/>
  <uni.:hasContact rdf:resource="#STAT2401_contact_labs"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STAT2401</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of Experiments</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the principles of randomised experiments and practical quantitative tools for analysing the data from such experiments. The emphasis is on choosing and applying appropriate methods, rather than technical details and formal inference. Topics include controlled experiments versus observational studies; different experimental designs—confounding, misinterpretation; biases—blinding and randomisation; and analysis—linear regression, linear models and analysis of variance.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics Applications ATAR or MATH1720 Mathematics Fundamentals or MATX1720 Mathematics Fundamentals or equivalent or Enrolment in 62530 Master of Data Science</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the fundamentals of designing random experiments in different situations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop and apply linear models for data from real-world experiments and studies</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate the use of linear models</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proficiently use a statistical computer package for linear modelling.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate skills in the statistical analysis of data from designed experiments and observational studies</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests or quizzes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computing and Data Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Science</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Sciences and Data Analytics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Statistics</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MJD-STATS">
  <rdf:type rdf:resource="http://uwa/uni.ot#Major"/>
