<owl:NamedIndividual rdf:about="#MATH2032">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1011"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1012"/>
  <uni.:hasPrerequisite rdf:resource="#MATX1011"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1012"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1013"/>
  <uni.:hasPrerequisite rdf:resource="#MATH1014"/>
  <uni.:listedInMajor rdf:resource="#MJD-MATHS"/>
  <uni.:hasAdvisedUnit rdf:resource="#MATH1013"/>
  <uni.:hasContact rdf:resource="#MATH2032_contact_lectures"/>
  <uni.:hasContact rdf:resource="#MATH2032_contact_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH2032</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Complex and Fourier Analysis</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with the foundation of complex and Fourier analysis, with an emphasis on Cauchy-Riemann equations, holomorphic functions, analytic continuation in the complex plane, contour integration, residues, Laurent series, Fourier series and Fourier transform, point-wise and L2 convergence.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus or MATH1013 Mathematical Analysis and MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods or MATH1014 Algebra</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compute contour integrals using methods from complex analysis</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exploit the notion of Fourier transform, find the inverse and use these techniques to solve differential equations.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">show convergence of Fourier series and use them for applications to differential equations</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and exploit the notions of holomorphic functions and analytic continuation in the complex plane.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exam</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frontier Physics</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics</uni.:hasMajorTitle>
</owl:NamedIndividual>

