<owl:NamedIndividual rdf:about="#FREN3407">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Humanities"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#FREN2406"/>
  <uni.:listedInMajor rdf:resource="#MJD-FRNHI"/>
  <uni.:hasContact rdf:resource="#FREN3407_contact_x_12_weeks"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3407</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Studies 7</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on FREN2406. It focuses on speaking, reading and writing, using materials drawn from French and francophone visual and literary culture to deepen student understanding of French and francophone culture, history and society. Students further develop grammar and vocabulary skills and improve their ability to communicate orally and in writing. Students gain an increased level of competency in French corresponding to proficiency levels B2/C1 and upwards of the Common European Framework of Reference for Languages. The unit leads to FREN3408 French Studies 8.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN2406 French Studies 6</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competency in listening, speaking, reading, and writing corresponding to Levels B2/C1 and upwards of the Common European Framework of Reference for Languages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate awareness of intercultural understanding and language learning</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use research skills and communication strategies in both French and English.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oral tasks</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests and quizzes</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FRNHI French Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

