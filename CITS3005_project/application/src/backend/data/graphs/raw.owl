</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GENE2220">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Molecular_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#IMED1002"/>
  <uni.:hasPrerequisite rdf:resource="#IMED1003"/>
  <uni.:hasPrerequisite rdf:resource="#IMED1001"/>
  <uni.:hasPrerequisite rdf:resource="#SCIX1106"/>
  <uni.:hasPrerequisite rdf:resource="#SCIE1106"/>
  <uni.:listedInMajor rdf:resource="#MJD-GENET"/>
  <uni.:hasContact rdf:resource="#GENE2220_contact_recorded_lectures"/>
  <uni.:hasContact rdf:resource="#GENE2220_contact_laboratory_classes"/>
  <uni.:hasContact rdf:resource="#GENE2220_contact_consolidation_workshops"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENE2220</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Genetics</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will equip students with a foundation in modern molecular genetics applicable to a wide range of organisms. Students will gain insight into: chromosome structure; mechanisms of transcription and translation; regulation of gene expression; mechanisms of mutation and DNA repair; genetic variation; cell cycle control; and methods for determining gene function. Emphasis will be placed on emerging applications dependent on molecular genetics, including synthetic biology and RNA-based technologies. The unit will have a flipped format with pre-recorded lectures paired with self-study materials. Knowledge will be consolidated through in-person, active-learning workshops. Practical experience will be gained through laboratory sessions featuring routine methods in molecular genetics.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IMED1001 Form and Function and IMED1002 The Facts of Life or SCIE1106 Molecular Biology of the Cell or SCIX1106 Molecular Biology of the Cell or IMED1003 Cell Survival and Communication</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate how core molecular genetics knowledge can be applied to solve practical problems relating to agriculture, health and the bioeconomy</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret the molecular mechanisms and general principles by which genes are regulated in prokaryotic and eukaryotic organisms</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire and apply technical skills applicable to the molecular life sciences.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how variation in gene content can arise and be measured, and can account for phenotypic change including disease</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">define the structural and molecular characteristics of genes and chromosomes, and how they differ between prokaryotes and eukaryotes</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-semester tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exam</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workshop and practical assessments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genetics</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pierce, B. A. Genetics: a Conceptual Approach, 7th edn, update: W. H. Freeman and Co 2024</uni.:hasNote>
</owl:NamedIndividual>

