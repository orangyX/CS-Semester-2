  <rdf:Description rdf:about="http://example.com/made-in-abyss/Garden_of_the_Flowers_of_Fortitude">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/Location"/>
    <mia:hasDepth rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9000</mia:hasDepth>
