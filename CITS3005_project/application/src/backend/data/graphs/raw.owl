<owl:NamedIndividual rdf:about="#MUSC3571">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2274"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2277"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2273"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC2276"/>
  <uni.:listedInMajor rdf:resource="#MJD-MEMSD"/>
  <uni.:hasContact rdf:resource="#MUSC3571_contact_per_week_seminars_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3571</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sound Art: Advanced Studio</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a conceptual development unit that prepares a student for completion of their sound design studies in the final capstone unit MUSC3572 Sound Art: Major Project. Students research theoretical concepts and explore the practical development of works that conceptually model an advanced creative sound art proposal. In addition to the development of preparatory sound sketches, prototypes and models, all students are expected to participate in peer group discussion seminars and develop a written proposal that effectively communicates their creative goals and technical requirements for a major sound art project in MUSC3572.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any two units selected from: MUSC2273 Electronic Music: Generative Processes. MUSC2274 Electronic Music: Experimental Investigations. MUSC2276 Sound, Image and Space. MUSC2277 Electronic Music: Interactive Systems</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop a high level of practical skills in appropriate sound and, if applicable, image technology</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">selectively use digital media applications to develop and demonstrate sound sketches, prototypes and models</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">summarise and communicate via written and verbal means, inventive conceptual/theoretical frameworks</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">complete and present a cohesive conceptual model for the development of well resolved sound art works.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop effective strategies for self directed research and practice</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portfolio of sound sketches/prototypes</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">seminar participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written proposal</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music: Electronic Music and Sound Design</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</uni.:hasMajorTitle>
</owl:NamedIndividual>

