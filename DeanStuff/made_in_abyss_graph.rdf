  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/West_Orth">
    <rdf:type rdf:resource="http://example.com/made-in-abyss/District"/>
    <rdfs:label>West District</rdfs:label>
    <mia:locatedIn rdf:resource="http://example.com/made-in-abyss/Orth"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/The_Grand_Pier"/>
    <mia:contains rdf:resource="http://example.com/made-in-abyss/Belchero_Orphanage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/made-in-abyss/Rohana_Fountainhead">
