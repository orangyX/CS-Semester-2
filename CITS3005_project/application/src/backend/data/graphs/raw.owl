<owl:NamedIndividual rdf:about="#MUSC2274">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC1442"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC1055"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSCO"/>
  <uni.:listedInMajor rdf:resource="#MJD-MEMSD"/>
  <uni.:hasContact rdf:resource="#MUSC2274_contact_per_semester_combination_of_lectures_labs_and_tutorials"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2274</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Music: Sampling and Synthesis</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds upon MUSC1055 Electronic Music: Methods and Means, applying advanced concepts and techniques of sound design, composition and production toward the formation of new electronic music. Lectures critically and analytically explore contemporary genres of electronic music from around the globe and the compositional approaches and production techniques associated with them. Students experiment directly with these concepts and techniques in computer laboratory sessions to create toward the creation their own original electronic music compositions. Topics covered in the unit include form, temporality, rhythmic process and technique, sound recording, sampling, advanced digital sound synthesis and effects processing.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1055 Electronic Music: Methods and Means or MUSC1442 Contemporary Popular Music Principal Studies 2</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand and identify a variety of rhythmic patterns, processes and techniques</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structure time, and manipulate and develop rhythm to creative/artistic ends</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge and critical awareness of contemporary genres and repertoire of electronic music.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">record, edit and manipulate sound samples to professional quality for use in electronic music and other sound design contexts</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate proficiency with advanced compositional and production techniques of electronic music</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">creative folio piece #1 and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">creative folio piece #2</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music: Electronic Music and Sound Design</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MUSC1442">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Music"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MUSC1441"/>
  <uni.:listedInMajor rdf:resource="#MJD-MUSCO"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1442</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 2</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit consolidates learning from MUSC1441, and builds upon skills and fundamental concepts to support students' own unique Contemporary Popular music practice, including performance, songwriting, production, and music technology. Students will work collaboratively to produce their own portfolio in either performance and/or songwriting, and experiment with contemporary techniques in songwriting, arrangement, and productions skills using a Digital Audio Workstation. Topics include songwriting, sound synthesis, sound editing, effects processing, mixing, and production. This unit prepares students in technical and performance skills required for the next unit in the Contemporary Popular Music Principal sequence.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1441 Contemporary Popular Music Principal Studies 1</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply effective strategies and practices to achieve creative goals</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply self-directed collaborative music making skills appropriate to this foundational level of tertiary study</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate proficiency in performing, composing and/or recording contemporary popular music</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the processes involved in creative development.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collaborative music project</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portfolio</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music</uni.:hasMajorTitle>
</owl:NamedIndividual>

