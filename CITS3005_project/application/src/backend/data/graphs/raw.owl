<owl:NamedIndividual rdf:about="#GENG2000">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Engineering"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#GENG1000"/>
  <uni.:listedInMajor rdf:resource="#MJD-EBMEG"/>
  <uni.:listedInMajor rdf:resource="#MJD-EMECH"/>
  <uni.:listedInMajor rdf:resource="#MJD-EELEC"/>
  <uni.:listedInMajor rdf:resource="#MJD-ESOFT"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECIVL"/>
  <uni.:listedInMajor rdf:resource="#MJD-ECHEM"/>
  <uni.:listedInMajor rdf:resource="#MJD-EENVE"/>
  <uni.:listedInMajor rdf:resource="#MJD-EMINE"/>
  <uni.:listedInMajor rdf:resource="#MJD-EAUTO"/>
  <uni.:hasContact rdf:resource="#GENG2000_contact_workshop_and_safety_documentation_preparation_and_31_5_hours_workshop_based_activities"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG2000</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering Practice 2</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Students will learn practical skills from a variety of application areas in engineering. General and discipline specific safety inductions are also part of this unit. The unit comprises 9 half-day modules. Students must complete any pre-module requirements before attending each session. You will not be permitted to participate in modules if you have not done the preparation work. Assessment is based on completion of preparation tasks and active participation in the modules. Engineering students must successfully complete this unit within their first two years of study. IMPORTANT: If you have a disability or injury that may impact on your ability to operate machinery, use hand tools, or complete other physical hands-on practical activities safely and/or you do not have a laptop to bring to class, then you must notify the unit coordinator at least two (2) weeks before the unit commences so alternative arrangements can be made. If you do not, then you will not be permitted to join the class.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and Successful completion of GENG1000 Engineering Practice 1</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the importance of professionalism when undertaking activities involving risk.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the importance of safety in practical engineering work</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">select appropriate tools for specific engineering tasks</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use a range of hand and powered tools safely</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">employ specific practical skills related to their chosen engineering discipline</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-standard teaching period</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">safety risk assessment</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preparation and participation in individual and group work and</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Automation and Robotics Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mining Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Civil Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanical Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Software Engineering</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electrical and Electronic Engineering</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The dates for GENG2000 are 22 June - 19 July 2026. • LMS online Risk Assessment Quiz (due early in week 27): Full marks have to be reached to complete this.• Week 28: face-to-face activities (full-time, Monday July 6 to Friday July 10, 2026)• Week 29: face-to-face activities (full-time, Monday July 13 to Friday July 17, 2026)You will need to complete the quiz and attend either week 28 or week 29 in person, depending on your enrolment and CAS allocation.</uni.:hasNote>
</owl:NamedIndividual>

