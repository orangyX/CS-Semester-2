<owl:NamedIndividual rdf:about="#HART2043">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_UWA_Design_School"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#VISA1000"/>
  <uni.:hasPrerequisite rdf:resource="#HART1000"/>
  <uni.:hasPrerequisite rdf:resource="#HART1003"/>
  <uni.:listedInMajor rdf:resource="#MJD-HYART"/>
  <uni.:hasContact rdf:resource="#HART2043_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART2043</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zen to Manga: A Survey of Japanese Art</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the art and visual culture of Japan, with an emphasis on the modern period. As an introduction to the artistic practices and aesthetic principles of Japanese culture, this unit offers a broad history of Japan through a close consideration of specific artists and material traditions. From Hokusai's Great Wave, to in the indoor surfing clubs of Tokyo, from Zen tea bowls, to the Manga empire of Takashi Murakami, this unit encourages interactive engagement with Japanese art through objects, images, and experiences. Over the semester, students will examine a wide array of topics, including Buddhist art, the politics of craft, and the complexities of cultural appropriation, ultimately enhancing their interpretive skills through hands-on learning, site-visits, oral presentations, and written work.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART1000 Great Moments in Art (formerly VISA1000) or HART1003 Ways of Seeing: Themes and Theories in Art</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify key aesthetic principles of Japanese art</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of Japanese culture and aesthetic principles to the interpretation of works of art</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">employ effective research skills including the use of primary and secondary materials</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">construct a compelling and well-structured argument in a written paper</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate critical thought and cogent analysis through oral communication.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify relevant Japanese artists and artworks</uni.:hasOutcome>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">short essay</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discursive exercises</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">long essay</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art History and Curatorial Studies</uni.:hasMajorTitle>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">History of Art</uni.:hasMajorTitle>
</owl:NamedIndividual>

