<owl:NamedIndividual rdf:about="#CHIN2801">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_China"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN2801</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">China Field Study</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an in-country unit during Australian summer holidays which enables students to undertake intensive language study at a Chinese university to develop their oral and written skills to a high level. It is offered as an alternative to one Chinese studies unit at UWA.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of at least one Chinese language unit at UWA or equivalent as recognised by the Faculty</uni.:hasPrerequisiteText>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is available over the summer break (late November - late December). Approval by advising Faculty Student Office.</uni.:hasNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Location_China">
  <rdf:type rdf:resource="http://uwa/uni.ot#Location"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CHIN1401">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHNSB"/>
  <uni.:hasContact rdf:resource="#CHIN1401_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN1401</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chinese 1</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is open to students with no previous knowledge of modern standard Chinese ONLY. It provides a basic introduction to contemporary spoken and written Chinese (Mandarin or Putonghua). The primary focus is on giving elementary instruction in the various facets of modern standard Chinese: comprehension and speaking, reading and writing. The first few weeks of the semester concentrates on the learning of the Pinyin system (Romanisation). In addition, there is a series of lectures on the key features of both the spoken language and the Chinese script. Successful completion of this unit brings students to the ISLPR Level 1 (International Second Language Proficiency Ratings) or New HSK Level 1 (New Chinese Proficiency Test) or CEFR A1 (Common European Framework of Reference for Languages).</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise and understand a range of short, simple texts that are often heard and seen</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">speak by imitating sentence patterns learned, and have attained minimum survival proficiency in four basic skills—comprehension, speaking, reading and writing</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand Chinese language in its social and cultural contexts which encourages an understanding of differences as well as the similarities between culture of origin and the culture of the target community.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">master Pinyin</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate mainly with simple phrases and sentences</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workbook and oral presentation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHNSB Chinese Studies</uni.:hasMajorTitle>
  <uni.:hasNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is designed for students who have no previous knowledge or only a slight knowledge of Chinese. Students with some knowledge of the language should consult the unit coordinator for information regarding the appropriate unit for enrolment.If you have an 'invalid / breach' in this unit, please complete the online Chinese Placement test:https://ipoint.uwa.edu.au/app/answers/detail/a_id/3174</uni.:hasNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CHIN1401_contact_per_week">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">per week</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:contactHours>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CHIN1402">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#CHIN1401"/>
  <uni.:hasPrerequisite rdf:resource="#CHIN1101"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHNSB"/>
  <uni.:hasContact rdf:resource="#CHIN1402_contact_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN1402</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chinese 2</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from CHIN1401 Chinese 1. It builds on previous knowledge of the Chinese language and improves aural comprehension and fluency in spoken and written Chinese. The unit covers a range of basic vocabulary and sentence patterns enabling simple effective spoken and written communication in everyday life in China on topics students are familiar with. Successful completion of this unit brings students to the ISLPR Level 1 (International Second Language Proficiency Ratings) or New HSK Level 2 (New Chinese Proficiency Test) or CEFR A2 (Common European Framework of Reference for Languages).</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN1401 Chinese 1 or CHIN1101 Chinese Beginners 1</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop basic skills of speaking and listening, can initiate and sustain simple conversations, understand simple texts and write short series of sentences on very familiar topics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop a 'basic transactional proficiency' in Chinese which means that students have learned about 400 characters, 350 words or short phrases, and 100 sentence patterns</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire a number of generic skills such as knowledge, awareness and understanding of differences as well as the similarities between cultures and societies.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workbook and oral presentation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHNSB Chinese Studies</uni.:hasMajorTitle>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CHIN1101">
  <rdf:type rdf:resource="http://uwa/uni.ot#FloatingUnit"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN1101</uni.:hasCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CHIN1402_contact_per_week">
  <rdf:type rdf:resource="http://uwa/uni.ot#ContactMode"/>
  <uni.:contactType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">per week</uni.:contactType>
  <uni.:contactHours rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</uni.:contactHours>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CHIN2001">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:listedInMajor rdf:resource="#MJD-CHNSB"/>
  <uni.:hasContact rdf:resource="#CHIN2001_contact_of_pre_recorded_lecture"/>
  <uni.:hasContact rdf:resource="#CHIN2001_contact_of_F2F_language_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN2001</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chinese 3A</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from CHIN1402 Chinese 2 and functions as a bridging unit for the beginners' major (MJD-CHNSB), providing the foundation for further developing linguistic and cultural competency. The unit continues to develop the four language skills (listening, speaking, reading and writing) and increases students' effective communication skills to meet routine practical and social demands that are relevant to them at tertiary level. Special emphasis is placed on consolidating and expanding student knowledge and recognition of Chinese characters. The unit also equips students with the ability to use dictionaries and read new materials in the target language.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of WACE Chinese: Second Language CSL 2A/2B or or equivalent proficiency as assessed by the Unit Coordinator or a member of the Chinese Studies team.</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">master the most commonly used Chinese characters and compose informative sentences and passages</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">achieve reasonable understanding of successful second language acquisition and apply research skills which allow independent learning.</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop a sound understanding of the construction of Chinese characters and grammar</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">converse in spoken and written form about everyday topics at lower intermediate level</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tests</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments</uni.:hasAssessment>
