<owl:NamedIndividual rdf:about="#IREL3002">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Social_Sciences"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#POLS1102"/>
  <uni.:hasPrerequisite rdf:resource="#POLS1101"/>
  <uni.:hasContact rdf:resource="#IREL3002_contact_online_lecture_per_week_1_x"/>
  <uni.:hasContact rdf:resource="#IREL3002_contact_tutorial_per_week"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IREL3002</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Politics of Human Rights</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human rights have become a central issue in international politics, observable in the increasing number of political claims for human rights that have been advanced in recent decades. This unit examines the theory and politics of human rights in a global context. It first considers different normative approaches to conceptualising human rights, and their contested philosophical foundations. It then analyses the politics of human rights through a range of empirical cases, which may include refugees, security, citizenship, development justice, and climate change.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of POLS1102 Understanding Global Politics or POLS1101 Understanding Politics and Policy</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the strengths and weaknesses of key normative and philosophical approaches to human rights</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and analyse the development of the human rights discourse and its significance in international politics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate debates regarding human rights in global politics</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate in written and oral assessments using the conventions of the discipline.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 1</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">seminar preparation and participation</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a research essay</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analytical assignments</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Right</uni.:hasMajorTitle>
</owl:NamedIndividual>

