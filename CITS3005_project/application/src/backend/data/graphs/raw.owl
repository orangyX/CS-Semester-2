  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">performance assessments and</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music General Studies</uni.:hasMajorTitle>
