<owl:NamedIndividual rdf:about="#MATH3032">
  <rdf:type rdf:resource="http://uwa/uni.ot#Unit"/>
  <uni.:belongsTo rdf:resource="#School_Physics_Mathematics_and_Computing"/>
  <uni.:locatedIn rdf:resource="#Location_UWA_Perth"/>
  <uni.:hasPrerequisite rdf:resource="#MATH2030"/>
  <uni.:hasPrerequisite rdf:resource="#MATH2031"/>
  <uni.:listedInMajor rdf:resource="#MJD-MATHS"/>
  <uni.:hasContact rdf:resource="#MATH3032_contact_of_lectures"/>
  <uni.:hasContact rdf:resource="#MATH3032_contact_of_practical_classes"/>
  <uni.:hasCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH3032</uni.:hasCode>
  <uni.:hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Topology and Manifolds</uni.:hasTitle>
  <uni.:hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an introduction to abstract methods in a continuous setting. Topics include topology and geometry from a constructive perspective in dimensions two, three and four. Students investigate, via concrete examples, homeomorphisms and diffeomorphisms of manifolds; curvature; vector bundles; and elements of the machinery for describing space-time in physics.</uni.:hasDescription>
  <uni.:hasLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</uni.:hasLevel>
  <uni.:hasCredit rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</uni.:hasCredit>
  <uni.:isAvailable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</uni.:isAvailable>
  <uni.:hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH2031 Introduction to Pure Mathematics or MATH2030 Metric Spaces &amp; Measure Theory</uni.:hasPrerequisiteText>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate intuition and skills in topology and differential geometry and</uni.:hasOutcome>
  <uni.:hasOutcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how these geometry techniques can be applied to mechanics and physics.</uni.:hasOutcome>
  <uni.:offeredIn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semester 2</uni.:offeredIn>
  <uni.:hasMode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">On-campus</uni.:hasMode>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignments and</uni.:hasAssessment>
  <uni.:hasAssessment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a final examination</uni.:hasAssessment>
  <uni.:hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics</uni.:hasMajorTitle>
</owl:NamedIndividual>

